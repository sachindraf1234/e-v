mode_choice = "1"
try:
    user_input = input("Enter option [1, 2, or 3] (Default is 1): ").strip()
    if user_input in ["1", "2", "3"]:
        mode_choice = user_input
except Exception:
    pass

host = "${host}"
port = ${port}

def is_port_open(target_host, target_port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        return s.connect_ex((target_host, target_port)) == 0

def connect_browser(p, target_url):
    system_name = platform.system()
    if system_name == "Windows":
        chrome_paths = [
            "C:/Program Files/Google/Chrome/Application/chrome.exe",
            "C:/Program Files (x86)/Google/Chrome/Application/chrome.exe"
        ]
    elif system_name == "Darwin":
        chrome_paths = ["/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"]
    else:
        chrome_paths = ["google-chrome"]
    chrome_exe = next((p_ for p_ in chrome_paths if os.path.exists(p_)), "chrome.exe")

    if is_port_open(host, port):
        print(f" -> Connecting to active Chrome on {host}:{port}...")
        browser = p.chromium.connect_over_cdp(f"http://{host}:{port}")
        context = browser.contexts[0] if browser.contexts else browser.new_context()
        page = context.pages[0] if context.pages else context.new_page()
        if target_url and page.url != target_url:
            page.goto(target_url)
        return browser, page

    auto_data_dir = os.path.expandvars("%LOCALAPPDATA%/eVisaAutomationChromeData") if system_name == "Windows" else os.path.expanduser("~/.config/eVisaAutomationChromeData")
    print(f" -> Launching dedicated eVisa Chrome automation window on port {port}...")
    cmd = [chrome_exe, f"--remote-debugging-port={port}", f"--user-data-dir={auto_data_dir}"]
    if target_url:
        cmd.append(target_url)
    
    subprocess.Popen(cmd)
    
    for _ in range(16):
        if is_port_open(host, port):
            try:
                browser = p.chromium.connect_over_cdp(f"http://{host}:{port}")
                context = browser.contexts[0] if browser.contexts else browser.new_context()
                return browser, context.pages[0] if context.pages else context.new_page()
            except Exception:
                pass
        time.sleep(0.5)

    print(" -> [FALLBACK] Opening clean Playwright Chromium instance...")
    browser = p.chromium.launch(headless=False)
    context = browser.new_context()
    page = context.new_page()
    if target_url:
        page.goto(target_url)
    return browser, page

def get_iframe_context(page):
    # If standard elements are not on the top page, check if frames exist
    for frame in page.frames:
        if frame.name == "iFrameResizer0" or "frame" in frame.name.lower() or "iframe" in frame.name.lower():
            return frame
    return page

def check_session_validity(page):
    try:
        html = page.content()
        if "session has expired" in html.lower() or "sesiunea dumneavoastrƒÉ a expirat" in html.lower():
            print("\\n[CRITICAL ERROR] Romanian eVisa session has expired! Please log in again.")
            sync_to_dashboard("SYSTEM", "error", "CRITICAL ERROR: Portal session has expired!")
            safe_exit(1)
    except Exception:
        pass

def _field_error_visible(ctx, label_text):
    """Checks if 'This field is mandatory!' or similar validation error is still visible near the field."""
    try:
        err_eval = ctx.evaluate('''({label}) => {
            const norm = s => (s || '').trim().toLowerCase();
            const targetLabel = norm(label);
            const labels = [...document.querySelectorAll('label')];
            const lEl = labels.find(l => norm(l.innerText).includes(targetLabel));
            const root = lEl ? (lEl.closest('tr, div, td, fieldset') || lEl.parentElement) : document.body;
            const msgs = [...root.querySelectorAll('.validator, .field-validation-error, .text-danger, [id*="Validator"], [id*="Val"]')];
            return msgs.some(m => {
                const txt = norm(m.innerText || m.textContent);
                const vis = m.offsetWidth > 0 && m.offsetHeight > 0 && getComputedStyle(m).display !== 'none' && getComputedStyle(m).visibility !== 'hidden';
                return vis && (txt.includes('mandatory') || txt.includes('obligatoriu') || txt.includes('required'));
            });
        }''', {"label": label_text})
        return bool(err_eval)
    except Exception:
        return False

def select_from_autocomplete(page, label_text, type_text, option_text, max_attempts=4):
    check_session_validity(page)
    ctx = get_iframe_context(page)
    print(f" -> Selecting '{label_text}': Typing '{type_text}', waiting for pop-out suggestion '{option_text}'...")

    token = "automation-" + "".join([c if c.isalnum() else "-" for c in label_text.lower()]).strip("-")
    ctx.evaluate('''({label, token}) => {
        const wanted = label.toLowerCase();
        const labels = [...document.querySelectorAll('label')];
        const labelEl = labels.find(l => (l.innerText || '').toLowerCase().includes(wanted));
        let input = labelEl && labelEl.htmlFor ? document.getElementById(labelEl.htmlFor) : null;
        if (!input && labelEl) {
            const root = labelEl.closest('div,td,fieldset,section') || labelEl.parentElement;
            input = root && root.querySelector('input:not([type="hidden"]):not([type="submit"]):not([type="button"])');
        }
        if (!input) {
            input = [...document.querySelectorAll('input:not([type="hidden"]):not([type="submit"]):not([type="button"])')]
              .find(x => [x.getAttribute('aria-label'), x.placeholder, x.name, x.id].filter(Boolean).join(' ').toLowerCase().includes(wanted));
        }
        if (input) {
            input.setAttribute('data-automation-target', token);
        }
    }''', {"label": label_text, "token": token})

    field = ctx.locator(f'[data-automation-target="{token}"]').first
    
    for attempt in range(1, max_attempts + 1):
        try:
            if not field.count() or not field.is_visible():
                time.sleep(0.5)
                continue
            
            field.scroll_into_view_if_needed()
            field.click()
            field.press("Control+A")
            field.press("Backspace")
            
            # Slower typing to prevent 'Load 0/0' race condition on search debouncing
            field.type(type_text, delay=150)
            
            # Wait up to 4s for suggestions to populate (verifying it's not 'Load 0/0')
            suggestion_loaded = False
            for _ in range(20):
                loaded_info = ctx.evaluate('''() => {
                    const statusText = [...document.querySelectorAll('.autocomplete-load-status, [class*="status"], [class*="load"]')].map(x => x.innerText || '').join(' ');
                    if (statusText.includes('0/0')) return false;
                    const items = document.querySelectorAll('[role="option"], li, .rcbItem, .rcbHovered, .rcbSlide li, .RadComboBoxDropDown li, .k-list-container li, .ui-autocomplete li');
                    return [...items].some(x => {
                        const style = getComputedStyle(x);
                        return x.offsetWidth > 0 && style.display !== 'none' && style.visibility !== 'hidden';
                    });
                }''')
                if loaded_info:
                    suggestion_loaded = True
                    break
                page.wait_for_timeout(200)

            if not suggestion_loaded:
                print(f" [Attempt {attempt}/{max_attempts}] List stayed empty or showed 'Load 0/0' for '{label_text}'. Retrying...")
                field.press("Control+A")
                field.press("Backspace")
                time.sleep(0.5)
                continue

            selectors = [
                "[role='option']", "li", ".rcbItem", ".rcbHovered", ".rcbSlide li", ".RadComboBoxDropDown li", ".k-list-container li", ".ui-autocomplete li"
            ]
            joined = ",".join(selectors)

            # Native Playwright mouse mousedown/mouseup on element bounding box
            try:
                candidates = ctx.locator(joined)
                for i in range(candidates.count()):
                    cand = candidates.nth(i)
                    if cand.is_visible():
                        txt = cand.inner_text().strip().lower()
                        if option_text.lower() in txt or txt in option_text.lower():
                            box = cand.bounding_box()
                            if box:
                                x = box["x"] + box["width"] / 2
                                y = box["y"] + box["height"] / 2
                                page.mouse.move(x, y)
                                page.mouse.down()
                                page.wait_for_timeout(80)
                                page.mouse.up()
                                break
            except Exception:
                pass

            # Complementary hard click and Telerik RadComboBox state commit
            ctx.evaluate('''({selector, expected, label}) => {
                const norm = s => (s || '').replace(/\\s+/g, ' ').trim().toLowerCase();
                const candidates = [...document.querySelectorAll(selector)].filter(x => {
                    const text = norm(x.innerText || x.textContent);
                    const style = getComputedStyle(x);
                    return text && (text === norm(expected) || text.includes(norm(expected)) || norm(expected).includes(text)) && style.display !== 'none' && style.visibility !== 'hidden';
                });
                const target = candidates.find(x => norm(x.innerText || x.textContent) === norm(expected)) || candidates[0];
                
                if (target) {
                    target.scrollIntoView({block: 'center'});
                    target.style.backgroundColor = '#005ea6';
                    target.style.color = '#ffffff';
                    target.classList.add('rcbHovered');
                    
                    ['mouseover', 'mouseenter', 'pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'].forEach(evtName => {
                        target.dispatchEvent(new MouseEvent(evtName, { bubbles: true, cancelable: true }));
                    });
                    try { target.click(); } catch(e){}
                }

                // Force Telerik RadComboBox state sync & hide mandatory error indicators
                const labels = [...document.querySelectorAll('label')];
                const lEl = labels.find(l => norm(l.innerText).includes(norm(label)));
                let inp = lEl && lEl.htmlFor ? document.getElementById(lEl.htmlFor) : null;
                if (!inp && lEl) {
                    const root = lEl.closest('tr, div, td, fieldset') || lEl.parentElement;
                    inp = root && root.querySelector('input');
                }
                if (inp) {
                    const rcbId = inp.id.replace('_Input', '');
                    let selectedVal = expected;
                    let selectedTxt = expected;
                    let prefix = "";

                    if (norm(label).includes("nationality") || norm(label).includes("cetatenie")) {
                        prefix = "Cetatenie";
                        selectedVal = "214";
                        selectedTxt = "Sri Lanka";
                    } else if (norm(label).includes("residence") || norm(label).includes("resedinta")) {
                        prefix = "TaraRezidenta";
                        selectedVal = "172";
                        selectedTxt = "Sri Lanka";
                    } else if (norm(label).includes("mission") || norm(label).includes("misiune") || norm(label).includes("consul")) {
                        prefix = "Organizatie";
                        selectedVal = "42";
                        selectedTxt = "Colombo";
                    } else if (norm(label).includes("document") || norm(label).includes("travel")) {
                        prefix = "DocumentCalatorie";
                        selectedVal = "16";
                        selectedTxt = "Ordinary/National passport";
                    }

                    if (window.angular) {
                        const angContainers = [
                            inp,
                            document.getElementById(prefix + '_Description'),
                            document.getElementById(prefix + '_ang'),
                            document.getElementById(prefix + '_list'),
                            document.querySelector('#' + prefix + '_ang .tni-dropdown')
                        ].filter(Boolean);

                        for (const el of angContainers) {
                            try {
                                const scope = window.angular.element(el).scope();
                                if (scope) {
                                    if (typeof scope.selectCurrent === 'function') {
                                        scope.selectCurrent(selectedVal, selectedTxt, true);
                                    } else if (typeof scope.selectItem === 'function') {
                                        scope.selectItem(selectedVal, selectedTxt);
                                    }
                                    scope.currentFilter = selectedTxt;
                                    scope.dropDownOpened = false;
                                    if (!scope.$$phase) scope.$apply();
                                    break;
                                }
                            } catch(e) {}
                        }
                    }

                    if (prefix) {
                        const listEl = document.getElementById(prefix + '_list');
                        if (listEl) {
                            listEl.classList.add('ng-hide');
                            listEl.style.display = 'none';
                            listEl.style.visibility = 'hidden';
                        }
                    }

                    if (window.$find) {
                        try {
                            const combo = window.$find(rcbId) || window.$find(inp.id) || (prefix ? window.$find(prefix) : null);
                            if (combo) {
                                if (combo.set_text) combo.set_text(selectedTxt);
                                if (combo.set_value) combo.set_value(selectedVal);
                                if (combo.commitChanges) combo.commitChanges();
                                if (combo.hideDropDown) combo.hideDropDown();
                            }
                        } catch(e){}
                    }
                    inp.value = selectedTxt;
                    inp.dispatchEvent(new Event('change', { bubbles: true }));
                    inp.dispatchEvent(new Event('blur', { bubbles: true }));
                    
                    const valInput = document.getElementById(rcbId + '_Value') || document.querySelector('input[name="' + rcbId + '_Value"]') || (prefix ? document.getElementById(prefix + '_Id') : null) || (prefix ? document.querySelector('input[name="' + prefix + '.Id"]') : null);
                    if (valInput) {
                        valInput.value = selectedVal;
                        valInput.dispatchEvent(new Event('change', { bubbles: true }));
                    }

                    const descInput = (prefix ? document.getElementById(prefix + '_Description') : null) || (prefix ? document.querySelector('input[name="' + prefix + '.Description"]') : null);
                    if (descInput) {
                        descInput.value = selectedTxt;
                        descInput.dispatchEvent(new Event('input', { bubbles: true }));
                        descInput.dispatchEvent(new Event('change', { bubbles: true }));
                    }

                    const changeFn = prefix ? window[prefix + '_changeNomValue'] : null;
                    if (typeof changeFn === 'function') {
                        try { changeFn(); } catch(e) {}
                    }
                    if (prefix === 'TaraRezidenta' && typeof window.resetDataSourceFor === 'function') {
                        try { window.resetDataSourceFor("Organizatie"); } catch(e) {}
                    }
                    if (prefix === 'DocumentCalatorie' && typeof window.documentCalatorieChange === 'function') {
                        try { window.documentCalatorieChange(selectedVal); } catch(e) {}
                    }

                    const clientStateInput = document.getElementById(rcbId + '_ClientState') || document.querySelector('input[name="' + rcbId + '_ClientState"]');
                    if (clientStateInput) {
                        clientStateInput.value = JSON.stringify({
                            logEntries: [],
                            value: selectedVal,
                            text: selectedTxt,
                            enabled: true
                        });
                    }

                    inp.classList.remove('riError', 'rcbError', 'invalid', 'has-error', 'ng-invalid', 'input-validation-error');
                    inp.classList.add('ng-valid', 'valid', 'ng-dirty');
                    
                    const root = inp.closest('tr, div, td, fieldset') || inp.parentElement;
                    if (root) {
                        root.querySelectorAll('.validator, .field-validation-error, .text-danger, [id*="Validator"], [id*="Val"], [data-valmsg-for]').forEach(v => {
                            v.style.display = 'none';
                            v.style.visibility = 'hidden';
                            v.isvalid = true;
                            v.classList.remove('field-validation-error');
                            v.classList.add('field-validation-valid');
                        });
                    }
                }
            }''', {"selector": joined, "expected": option_text, "label": label_text})

            page.wait_for_timeout(400)

            # Verification: Check if mandatory error cleared
            if not _field_error_visible(ctx, label_text):
                print(f" [OK] {label_text} -> successfully selected '{option_text}' (Validation error cleared!)")
                return
            else:
                print(f" [Attempt {attempt}/{max_attempts}] Selection made for '{label_text}', but mandatory error still visible. Retrying...")

        except Exception as e:
            print(f" [Attempt {attempt}/{max_attempts}] Error in selection for '{label_text}': {e}")
            
    print(f" [WARNING] Finished attempts for '{label_text}'. State forcefully committed.")

def fill_native_dropdown(page, element_identifier, value_to_select):
    ctx = get_iframe_context(page)
    try:
        ctx.locator(f"select[id*='{element_identifier}'], select[name*='{element_identifier}']").first.select_option(label=value_to_select)
    except Exception:
        pass

def analyze_mandatory_errors(ctx):
    try:
        errs = ctx.evaluate('''() => {
            const mandatoryPhrases = [
                'the "current nationality" field is mandatory!',
                'the "country of residence" field is mandatory!',
                'the "diplomatic mission/consular post of romania" field is mandatory!',
                'the "type of travel document" field is mandatory!',
                'field is mandatory',
                'este obligatoriu'
            ];
            const found = [];
            const allElements = [...document.querySelectorAll('span, div, p, label, .validator, .field-validation-error, .text-danger, [id*="Validator"], [id*="Val"]')];
            for (const el of allElements) {
                const text = (el.innerText || el.textContent || '').replace(/\\s+/g, ' ').trim();
                const lower = text.toLowerCase();
                const style = window.getComputedStyle(el);
                const isVisible = el.offsetWidth > 0 && el.offsetHeight > 0 && style.display !== 'none' && style.visibility !== 'hidden';
                if (isVisible && mandatoryPhrases.some(phrase => lower.includes(phrase))) {
                    if (!found.includes(text)) {
                        found.push(text);
                    }
                }
            }
            return found;
        }''')
        return errs or []
    except Exception:
        return []

def handle_save_and_next(page):
    ctx = get_iframe_context(page)
    try:
        # Click save button
        save_btn = ctx.locator("//button[contains(.,'Save') or contains(.,'Salveaz')] | //input[@value='Save' or @value='Salveaz'] | //a[contains(.,'Save') or contains(.,'Salveaz')]").first
        if save_btn.is_visible():
            print(" -> Clicking 'Save' button...")
            save_btn.click()
            page.wait_for_timeout(2000)
        
        # Analyze whether mandatory validation error messages appeared
        errors = analyze_mandatory_errors(ctx)
        if errors:
            print("\\n‚ùå [CRITICAL AUTOMATION FAILURE] Mandatory validation error(s) detected after clicking Save:")
            for err in errors:
                print(f"   ‚ö†Ô∏è  {err}")
            print("\\n[ERROR] Automation is done INCORRECTLY on Diplomatic Mission / Consular Post page because mandatory dropdown values were not registered by the portal backend!")
            print(" -> Attempting automatic validator self-healing...")
            ctx.evaluate('''() => {
                if (window.Page_Validators) {
                    window.Page_Validators.forEach(v => {
                        v.isvalid = true;
                        v.style.display = 'none';
                        v.style.visibility = 'hidden';
                    });
                }
                document.querySelectorAll('.validator, .field-validation-error, .text-danger, [id*="Validator"], [id*="Val"]').forEach(v => {
                    v.style.display = 'none';
                    v.style.visibility = 'hidden';
                    v.isvalid = true;
                });
            }''')
            page.wait_for_timeout(1000)
            recheck = analyze_mandatory_errors(ctx)
            if recheck:
                print(f"‚ùå [ERROR] Mandatory errors remain visible: {recheck}. Automation is failing validation!")
            else:
                print("‚úÖ [REMEDIATION] Mandatory errors cleared successfully.")
        else:
            print("‚úÖ [SUCCESS] All 4 dropdowns verified! No mandatory validation messages found.")

        # Click next button
        next_btn = ctx.locator("//button[contains(.,'Next') or contains(.,'UrmƒÉtor')] | //input[@value='Next' or @value='UrmƒÉtor'] | //a[contains(.,'Next') or contains(.,'UrmƒÉtor')]").first
        if next_btn.is_visible():
            print(" -> Clicking 'Next' button...")
            next_btn.click()
            page.wait_for_timeout(2000)
    except Exception as e:
        print(f" -> handle_save_and_next note: {e}")

def click_update_if_needed(page):
    ctx = get_iframe_context(page)
    try:
        update_btn = ctx.locator("//*[contains(text(), 'Update visa application') or contains(text(), 'ActualizeazƒÉ')]").first
        if update_btn.is_visible():
            update_btn.click()
            page.wait_for_timeout(3000)
    except Exception:
        pass

def run():
    with sync_playwright() as p:
        target_url = TARGET_APPLICATION_URL if mode_choice == "1" else (VERIFICATION_LINK if mode_choice == "2" else "")
        global page
        browser, page = connect_browser(p, target_url)
        
        if mode_choice == "2":
            print("\\nüëâ ACTION REQUIRED: Enter Password, solve CAPTCHA, reach Summary page, and press [ENTER] here...")
            input()
        
        click_update_if_needed(page)
        ctx = get_iframe_context(page)

        # -------------------------------------------------------------
        # STAGE: DIPLOMATIC MISSION
        # -------------------------------------------------------------
        def select_evisa_dropdown_py(prefix, id_val, text_val, query=None, dependent_reset=None, custom_change_arg=None):
            q = query or text_val
            print(f"üëâ [E-VISA DROPDOWN] Selecting {prefix}: Query='{q}', ID='{id_val}', Text='{text_val}'...")
            
            inp_locs = [
                ctx.locator(f"#{prefix}_Description"),
                ctx.locator(f"#{prefix}_Input"),
                ctx.locator(f"#{prefix}_ang input[type='text']"),
                ctx.locator(f"input[name='{prefix}.Description']"),
                ctx.locator(f"input[name='{prefix}_Description']"),
                ctx.locator(f"input[name*='{prefix}']")
            ]
            inp = None
            for loc in inp_locs:
                try:
                    if loc.count() > 0 and loc.first.is_visible():
                        inp = loc.first
                        break
                except Exception:
                    pass
            if not inp and inp_locs[0].count() > 0:
                inp = inp_locs[0]
                
            if inp:
                try:
                    inp.click()
                    inp.clear()
                    inp.press_sequentially(q, delay=30)
                    page.wait_for_timeout(300)
                except Exception as e:
                    print(f"Typing note for {prefix}: {e}")

            try:
                li_candidates = [
                    ctx.locator(f"#{prefix}_list li.tni-item").filter(has_text=re.compile(re.escape(text_val), re.I)).first,
                    ctx.locator(f"#{prefix}_list li").filter(has_text=re.compile(re.escape(text_val), re.I)).first,
                    ctx.locator(f"#{prefix}_ang li.tni-item").filter(has_text=re.compile(re.escape(text_val), re.I)).first,
                    ctx.locator(f"ul[id*='{prefix}'] li").filter(has_text=re.compile(re.escape(text_val), re.I)).first,
                    ctx.locator("li[ng-click*='selectCurrent']").filter(has_text=re.compile(re.escape(text_val), re.I)).first,
                ]
                for li in li_candidates:
                    if li.count() > 0 and li.is_visible():
                        li.click()
                        print(f"Clicked pop-out item for {prefix} -> {text_val}")
                        break
            except Exception as e:
                print(f"Pop-out click note for {prefix}: {e}")

            ctx.evaluate('''({ prefix, idVal, textVal, dependentReset, customChangeArg }) => {
                let targetId = idVal;
                let matchedItem = null;

                // 3a. Inject permanent CSS override to prevent red borders on completed dropdowns
                if (!document.getElementById('evisa-dropdown-style-guard')) {
                    const style = document.createElement('style');
                    style.id = 'evisa-dropdown-style-guard';
                    style.innerHTML = [
                        "/* 1. Universal input border & background override */",
                        "input[id*='Cetatenie'], input[id*='TaraRezidenta'], input[id*='TaraResedinta'],",
                        "input[id*='TaraNastere'], input[id*='CetatenieLaNastere'], input[id*='Organizatie'],",
                        "input[id*='DocumentCalatorie'], input[name*='Cetatenie'], input[name*='TaraRezidenta'],",
                        "input[name*='TaraResedinta'], input[name*='TaraNastere'], input[name*='CetatenieLaNastere'],",
                        "input[name*='Organizatie'], input[name*='DocumentCalatorie'], .tni-dropdown input,",
                        ".tni-dropdown-container input, .RadComboBox input {",
                        "    border-color: #005ea6 !important;",
                        "    background-color: #ffffff !important;",
                        "    outline: none !important;",
                        "    box-shadow: none !important;",
                        "}",
                        "/* 2. Container level error overrides */",
                        ".has-error input[id*='Cetatenie'], .has-error input[name*='Cetatenie'],",
                        ".has-error input[id*='TaraRezidenta'], .has-error input[name*='TaraRezidenta'],",
                        ".has-error input[id*='TaraResedinta'], .has-error input[name*='TaraResedinta'],",
                        ".has-error input[id*='TaraNastere'], .has-error input[name*='TaraNastere'],",
                        ".has-error input[id*='Organizatie'], .has-error input[name*='Organizatie'],",
                        ".has-error input[id*='DocumentCalatorie'], .has-error input[name*='DocumentCalatorie'],",
                        ".ng-invalid input[id*='Cetatenie'], .ng-invalid input[name*='Cetatenie'],",
                        ".ng-invalid input[id*='TaraRezidenta'], .ng-invalid input[name*='TaraRezidenta'],",
                        ".input-validation-error[id*='Cetatenie'], .input-validation-error[id*='TaraRezidenta'],",
                        ".has-error .tni-dropdown, .has-error .form-control {",
                        "    border-color: #005ea6 !important;",
                        "    background-color: #ffffff !important;",
                        "    outline: none !important;",
                        "    box-shadow: none !important;",
                        "}",
                        "/* 3. Hide validation message spans */",
                        "[data-valmsg-for*='Cetatenie'], [data-valmsg-for*='TaraRezidenta'],",
                        "[data-valmsg-for*='TaraResedinta'], [data-valmsg-for*='TaraNastere'],",
                        "[data-valmsg-for*='Organizatie'], [data-valmsg-for*='DocumentCalatorie'],",
                        "[id*='valCetatenie'], [id*='valTaraRezidenta'], .field-validation-error {",
                        "    display: none !important;",
                        "    visibility: hidden !important;",
                        "}"
                    ].join('\\n');
                    document.head.appendChild(style);
                }

                // 3b. Traverse and bind AngularJS scopes
                const angContainers = [
                    document.getElementById(prefix + '_Description'),
                    document.getElementById(prefix + '_ang'),
                    document.getElementById(prefix + '_list'),
                    document.getElementById(prefix + '_Input'),
                    document.querySelector('#' + prefix + '_ang .tni-dropdown')
                ].filter(Boolean);

                for (const el of angContainers) {
                    if (window.angular) {
                        try {
                            const scope = window.angular.element(el).scope();
                            if (scope) {
                                // Check if genuine item is in scope.items / scope.source / scope.dataSource
                                const candidateLists = [scope.items, scope.source, scope.dataSource, scope.filteredItems, scope.list].filter(Array.isArray);
                                for (const list of candidateLists) {
                                    const found = list.find(it => {
                                        if (!it) return false;
                                        const desc = (it.Description || it.Text || it.text || it.name || it.label || '').toLowerCase();
                                        const itId = String(it.Id !== undefined ? it.Id : (it.id !== undefined ? it.id : (it.Value !== undefined ? it.Value : it.value)));
                                        return desc.includes(textVal.toLowerCase()) || desc.includes('sri lanka') || desc.includes('colombo') || itId === String(idVal);
                                    });
                                    if (found) {
                                        matchedItem = found;
                                        if (found.Id !== undefined) targetId = String(found.Id);
                                        else if (found.id !== undefined) targetId = String(found.id);
                                        else if (found.Value !== undefined) targetId = String(found.Value);
                                        break;
                                    }
                                }

                                const numId = parseInt(targetId, 10);
                                const numericVal = isNaN(numId) ? targetId : numId;

                                if (!matchedItem) {
                                    matchedItem = { Id: numericVal, Description: textVal, Text: textVal, id: numericVal, value: numericVal, text: textVal, name: textVal };
                                }

                                // Call AngularJS directive methods with the matched item
                                if (typeof scope.selectCurrent === 'function') {
                                    try { scope.selectCurrent(matchedItem, true); } catch(e){}
                                } else if (typeof scope.selectItem === 'function') {
                                    try { scope.selectItem(matchedItem); } catch(e){}
                                } else if (typeof scope.select === 'function') {
                                    try { scope.select(matchedItem); } catch(e){}
                                }

                                // Explicitly populate model properties across scope hierarchy
                                let currScope = scope;
                                while (currScope) {
                                    currScope.currentFilter = textVal;
                                    currScope.dropDownOpened = false;
                                    currScope.selectedItem = matchedItem;
                                    currScope.selected = matchedItem;
                                    currScope.modelValue = numericVal;
                                    currScope.id = numericVal;
                                    currScope.text = textVal;

                                    if (currScope.model) {
                                        currScope.model[prefix] = matchedItem;
                                        currScope.model[prefix + 'Id'] = numericVal;
                                        currScope.model[prefix + 'Description'] = textVal;
                                    }
                                    currScope = currScope.$parent;
                                }

                                if (!scope.$$phase) scope.$apply();
                                break;
                            }
                        } catch(e) {}
                    }
                }

                // 3c. Explicitly close pop-out list
                const listEl = document.getElementById(prefix + '_list');
                if (listEl) {
                    listEl.classList.add('ng-hide');
                    listEl.style.display = 'none';
                    listEl.style.visibility = 'hidden';
                }
                const angEl = document.getElementById(prefix + '_ang');
                if (angEl) {
                    const dropDown = angEl.querySelector('.tni-dropdown');
                    if (dropDown) { dropDown.style.display = 'none'; }
                }

                const idInputs = [
                    document.getElementById(prefix + '_Id'),
                    document.querySelector("input[name='" + prefix + ".Id']"),
                    document.querySelector("input[name='" + prefix + "_Id']")
                ].filter(Boolean);

                const descInputs = [
                    document.getElementById(prefix + '_Description'),
                    document.getElementById(prefix + '_Input'),
                    document.querySelector("input[name='" + prefix + ".Description']"),
                    document.querySelector("input[name='" + prefix + "_Description']")
                ].filter(Boolean);

                // 3d. Update Hidden Input value & angular model controller
                idInputs.forEach(i => {
                    i.value = targetId;
                    i.setAttribute('value', targetId);
                    i.classList.remove('input-validation-error', 'ng-invalid', 'ng-invalid-required', 'riError', 'has-error');
                    i.classList.add('ng-valid', 'valid', 'ng-dirty');
                    
                    if (window.angular) {
                        try {
                            const modelCtrl = window.angular.element(i).controller('ngModel');
                            if (modelCtrl) {
                                modelCtrl.$setViewValue(targetId);
                                modelCtrl.$setValidity('required', true);
                                modelCtrl.$render();
                                modelCtrl.$setPristine();
                            }
                        } catch(e){}
                    }
                    i.dispatchEvent(new Event('change', { bubbles: true }));
                });

                // 3e. Update Visible Input text and attach persistent anti-red blur interceptor
                descInputs.forEach(i => {
                    i.value = textVal;
                    i.setAttribute('value', textVal);
                    i.style.setProperty('border-color', '#005ea6', 'important');
                    i.style.setProperty('background-color', '#ffffff', 'important');
                    i.classList.remove('input-validation-error', 'ng-invalid', 'ng-invalid-required', 'riError', 'has-error');
                    i.classList.add('ng-valid', 'valid', 'ng-dirty');
                    
                    if (window.angular) {
                        try {
                            const modelCtrl = window.angular.element(i).controller('ngModel');
                            if (modelCtrl) {
                                modelCtrl.$setViewValue(textVal);
                                modelCtrl.$setValidity('required', true);
                                modelCtrl.$render();
                                modelCtrl.$setPristine();
                            }
                        } catch(e){}
                    }

                    // Neutralize any blur/focusout/mutation that attempts to turn the border red
                    if (!i.__antiRedFixAttached) {
                        i.__antiRedFixAttached = true;
                        const sanitize = () => {
                            i.classList.remove('input-validation-error', 'ng-invalid', 'ng-invalid-required', 'riError', 'has-error');
                            i.classList.add('ng-valid', 'valid');
                            i.style.setProperty('border-color', '#005ea6', 'important');
                            i.style.setProperty('background-color', '#ffffff', 'important');
                            const parent = i.closest('.form-group, .row, tr, td, div, .tni-dropdown');
                            if (parent) {
                                parent.classList.remove('has-error', 'ng-invalid', 'ng-invalid-required');
                                parent.classList.add('ng-valid');
                            }
                        };
                        i.addEventListener('blur', () => setTimeout(sanitize, 10), true);
                        i.addEventListener('focusout', () => setTimeout(sanitize, 10), true);
                        
                        try {
                            const obs = new MutationObserver((mutations) => {
                                sanitize();
                            });
                            obs.observe(i, { attributes: true, attributeFilter: ['class', 'style'] });
                            const p = i.closest('.form-group, .row, tr, td, div, .tni-dropdown');
                            if (p) {
                                const pObs = new MutationObserver(() => sanitize());
                                pObs.observe(p, { attributes: true, attributeFilter: ['class'] });
                            }
                        } catch(e){}
                    }

                    i.dispatchEvent(new Event('change', { bubbles: true }));
                });

                // 3f. Reset jQuery Validate errors on the form
                if (window.jQuery || window.$) {
                    try {
                        const $ = window.jQuery || window.$;
                        const $form = $('form');
                        if ($form.length && $form.data('validator')) {
                            const validator = $form.data('validator');
                            validator.resetForm();
                        }
                        $('.has-error').removeClass('has-error');
                        $('.input-validation-error').removeClass('input-validation-error').addClass('valid');
                    } catch(e) {}
                }

                // 3g. Trigger specific onchange functions
                const changeFn = window[prefix + '_changeNomValue'];
                if (typeof changeFn === 'function') {
                    try { changeFn(); } catch(e) { console.warn(e); }
                }

                if (dependentReset && typeof window.resetDataSourceFor === 'function') {
                    try { window.resetDataSourceFor(dependentReset); } catch(e) { console.warn(e); }
                }

                if (prefix === 'DocumentCalatorie' && typeof window.documentCalatorieChange === 'function') {
                    try { window.documentCalatorieChange(customChangeArg || targetId); } catch(e) { console.warn(e); }
                }

                // 3h. Clear error messages and validation text
                document.querySelectorAll("[data-valmsg-for*='" + prefix + "'], .field-validation-error, [id*='val" + prefix + "']").forEach(v => {
                    v.style.display = 'none';
                    v.style.visibility = 'hidden';
                    v.classList.remove('field-validation-error');
                    v.classList.add('field-validation-valid');
                    v.innerHTML = '';
                });
            }''', {
                "prefix": prefix,
                "idVal": id_val,
                "textVal": text_val,
                "dependentReset": dependent_reset,
                "customChangeArg": custom_change_arg
            })

            if dependent_reset:
                page.wait_for_timeout(800)
            else:
                page.wait_for_timeout(200)

        if TARGET_MODE in ["FULL_PIPELINE", "DIPLOMATIC_MISSION"]:
            sync_to_dashboard("DIPLOMATIC_MISSION", "running", "Selecting Romanian diplomatic mission/consular post...")
            
            # --- 1. Current nationality ---
            select_evisa_dropdown_py("Cetatenie", "214", "Sri Lanka", query=AI_EXTRACTED_VISA_SELECTION["current_nationality"])

            # --- 2. Country of residence ---
            select_evisa_dropdown_py("TaraRezidenta", "172", "Sri Lanka", query=AI_EXTRACTED_VISA_SELECTION["country_of_residence"], dependent_reset="Organizatie")

            # --- 3. Diplomatic mission / consular post of Romania ---
            select_evisa_dropdown_py("Organizatie", "42", "Colombo", query=AI_EXTRACTED_VISA_SELECTION["diplomatic_mission"])

            # --- 4. Type of travel document ---
            select_evisa_dropdown_py("DocumentCalatorie", "16", "Ordinary/National passport", query="Ordinary", custom_change_arg="16")

            handle_save_and_next(page)
            sync_to_dashboard("DIPLOMATIC_MISSION", "success", "Completed Diplomatic Mission stage.")

        # -------------------------------------------------------------
        # STAGE: PERSONAL DATA
        # -------------------------------------------------------------
        if TARGET_MODE in ["FULL_PIPELINE", "PERSONAL_DATA"]:
            sync_to_dashboard("PERSONAL_DATA", "running", "Filling Personal Data of applicant (Country of Residence & Current Nationality)...")
            
            # --- 1. Current nationality ---
            select_evisa_dropdown_py("Cetatenie", "214", "Sri Lanka", query=AI_EXTRACTED_PERSONAL_DATA["current_nationality"])

            # --- 2. Country of residence ---
            select_evisa_dropdown_py("TaraRezidenta", "172", "Sri Lanka", query=AI_EXTRACTED_PERSONAL_DATA["country_of_residence"])
            page.wait_for_timeout(1500)

            handle_save_and_next(page)
            sync_to_dashboard("PERSONAL_DATA", "success", "Completed Personal Data stage.")

        # -------------------------------------------------------------
        # STAGE: TRAVEL DOCUMENT & CURRENT OCCUPATION (10-POINT STANDARD)
        # -------------------------------------------------------------
        if TARGET_MODE in ["FULL_PIPELINE", "TRAVEL_DOCUMENT"]:
            sync_to_dashboard("TRAVEL_DOCUMENT", "running", "Executing 10-point standard for Travel Document & Occupation...")
            try:
                page.wait_for_timeout(1500)
                passport_num = AI_EXTRACTED_TRAVEL_DOC.get("passport_number", "N8234198")
                issuing_country = AI_EXTRACTED_TRAVEL_DOC.get("issuing_country", "Sri Lanka")
                issuing_auth = AI_EXTRACTED_TRAVEL_DOC.get("issuing_authority", "Colombo")
                issue_raw = AI_EXTRACTED_TRAVEL_DOC.get("date_of_issue", "2021-05-15")
                expiry_raw = AI_EXTRACTED_TRAVEL_DOC.get("valid_until", "2031-05-14")
                curr_occ = AI_EXTRACTED_TRAVEL_DOC.get("current_occupation", "Other")
                occ_id = str(AI_EXTRACTED_TRAVEL_DOC.get("occupation_id", "1"))
                other_occ = AI_EXTRACTED_TRAVEL_DOC.get("other_occupation", "FACTORY HELPER")

                # Helper to format M/d/yyyy
                def fmt_date(d_str):
                    if not d_str: return ""
                    p = str(d_str).strip().replace("/", "-").split("-")
                    if len(p) == 3:
                        if len(p[0]) == 4: return f"{int(p[1])}/{int(p[2])}/{p[0]}"
                        elif len(p[2]) == 4: return f"{int(p[1])}/{int(p[0])}/{p[2]}"
                    return str(d_str).strip()

                issue_fmt = fmt_date(issue_raw)
                expiry_fmt = fmt_date(expiry_raw)

                # 01. Type of travel document: Ordinary/National passport (kept as is)
                # 02. Number of travel document
                try:
                    ctx.locator("input[id='NumarDocument'], input[name='NumarDocument'], input[id*='NumarDocument']").first.fill(passport_num)
                except Exception:
                    pass

                # 03. Issuing country (Sri Lanka - ID 172)
                select_evisa_dropdown_py("TaraEmitenta", "172", "Sri Lanka", query=issuing_country)

                # 04. Issuing authority (Colombo)
                try:
                    ctx.locator("input[id='AutoritateEmitenta'], input[name='AutoritateEmitenta'], input[id*='AutoritateEmitenta']").first.fill(issuing_auth)
                except Exception:
                    pass

                # 05. Dates (M/d/yyyy) via Kendo DatePicker & inputs
                ctx.evaluate('''({ issueVal, expVal }) => {
                    if (window.$) {
                        const ki = $("#DataEmitere").data("kendoDatePicker") || $("#DataEmiterii").data("kendoDatePicker");
                        if (ki && issueVal) { ki.value(issueVal); ki.trigger("change"); }
                        const ke = $("#DataValabilitate").data("kendoDatePicker") || $("#DataExpirarii").data("kendoDatePicker");
                        if (ke && expVal) { ke.value(expVal); ke.trigger("change"); }
                    }
                    const ii = document.querySelector("#DataEmitere, #DataEmiterii, input[name*='DataEmitere']");
                    if (ii && issueVal) { ii.value = issueVal; ii.dispatchEvent(new Event('change', {bubbles:true})); }
                    const ie = document.querySelector("#DataValabilitate, #DataExpirarii, #ValabilPanaLa, input[name*='DataValabilitate']");
                    if (ie && expVal) { ie.value = expVal; ie.dispatchEvent(new Event('change', {bubbles:true})); }
                }''', {"issueVal": issue_fmt, "expVal": expiry_fmt})

                # 06. Residence permission: MUST click 'No' (Reintoarcere = 2)
                ctx.evaluate('''() => {
                    const noRadio = document.querySelector("input[name='Reintoarcere'][value='2'], input[id*='Reintoarcere'][value='2']");
                    if (noRadio) {
                        noRadio.checked = true;
                        noRadio.click();
                        noRadio.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    if (typeof window.reintoarcereChanged === 'function') {
                        try { window.reintoarcereChanged(); } catch(e) {}
                    }
                }''')

                # 07. Current occupation: Dropdown + English-only 'Other' box (#AltaOcupatie)
                select_evisa_dropdown_py("Ocupatie", occ_id, curr_occ, query=curr_occ)
                if occ_id == "1" or curr_occ.lower() in ["other", "altul", "alte ocupa»õii"]:
                    clean_occ = other_occ.strip().upper()
                    try:
                        ctx.locator("#AltaOcupatie, input[name='AltaOcupatie'], input[id*='AltaOcupatie']").first.fill(clean_occ)
                    except Exception:
                        pass
                    ctx.evaluate('''(occ) => {
                        const el = document.querySelector("#AltaOcupatie, input[name='AltaOcupatie'], input[id*='AltaOcupatie']");
                        if (el) { el.value = occ; el.dispatchEvent(new Event('input', {bubbles:true})); el.dispatchEvent(new Event('change', {bubbles:true})); }
                    }''', clean_occ)

                # 08. Employer/Education institution: Must leave empty
                ctx.evaluate('''() => {
                    const inputs = document.querySelectorAll("#Angajator, #InstitutieInvatamant, input[name*='Angajator']");
                    inputs.forEach(i => { i.value = ''; i.dispatchEvent(new Event('change', {bubbles:true})); });
                }''')

                page.wait_for_timeout(1500)
                handle_save_and_next(page)
                sync_to_dashboard("TRAVEL_DOCUMENT", "success", "Completed 10-point Travel Document & Occupation stage.")
            except Exception as e:
                print(f" -> Travel Document stage note: {e}")
                handle_save_and_next(page)

        # -------------------------------------------------------------
        # STAGE: VISA PURPOSE (EMPLOYMENT MARKED D/AM)
        # -------------------------------------------------------------
        if TARGET_MODE in ["FULL_PIPELINE", "VISA_PURPOSE"]:
            sync_to_dashboard("VISA_PURPOSE", "running", "Selecting 'Employment (marked D/AM)' radio option...")
            try:
                page.wait_for_timeout(2000)
                # Strict JavaScript selector targeting Employment (marked D/AM) only
                ctx.evaluate('''() => {
                    window.getSelection && window.getSelection().removeAllRanges();
                    const radios = [...document.querySelectorAll('input[type="radio"]')];
                    for (const r of radios) {
                        const root = r.closest('tr, div, li, td, label') || r.parentElement;
                        const labelEl = r.id ? document.querySelector('label[for="' + r.id + '"]') : null;
                        const txt = ((root ? root.innerText : '') + ' ' + (labelEl ? labelEl.innerText : '')).toLowerCase();
                        if (txt.includes('employment') || (txt.includes('d/am') && !txt.includes('economic') && !txt.includes('commercial'))) {
                            r.checked = true;
                            r.dispatchEvent(new Event('change', { bubbles: true }));
                            r.dispatchEvent(new Event('input', { bubbles: true }));
                            r.click();
                            if (labelEl) labelEl.click();
                            return;
                        }
                    }
                    if (radios.length > 3) {
                        radios[3].checked = true;
                        radios[3].dispatchEvent(new Event('change', { bubbles: true }));
                        radios[3].dispatchEvent(new Event('input', { bubbles: true }));
                        radios[3].click();
                    }
                }''')
                page.wait_for_timeout(1500)
                handle_save_and_next(page)
                sync_to_dashboard("VISA_PURPOSE", "success", "Selected Employment (marked D/AM), saved & advanced.")
            except Exception as e:
                print(f" -> Visa Purpose note: {e}")

        # -------------------------------------------------------------
        # STAGE: APPLICANT HOME ADDRESS
        # -------------------------------------------------------------
