      logs: cloudAgentLogs
    });
  } catch (err: any) {
    return res.status(500).json({ success: false, error: err.message });
  }
});

// Automation pipeline: Dynamically detects current page stage, recovers sessions, and executes or resumes
// - Checks if session has expired or page is not loaded: restores session using applicant's unique verification link
// - On Summary Page: clicks "Update visa application" (ActualizeazƒÉ cererea), navigating directly to the latest save point
// - Resumes from whatever saved point the portal opens (Select Visa Type, Diplomatic Mission, Visa Purpose, etc.)
// - For every stage with a Save button, clicks Save, settles postback, and clicks Next to advance
app.post("/api/cloud-agent/pipeline", async (req, res) => {
  try {
    if (!cloudPage) {
      return res.status(400).json({ success: false, error: "No active cloud browser session. Please launch the sandbox first." });
    }

    const { applicant, verificationUrl } = req.body || {};
    
    // Resolve and remember unique verification link
    const candidateUrl = (typeof verificationUrl === "string" ? verificationUrl.trim() : "") || 
      (applicant?.id && applicantVerificationMap[applicant.id] ? applicantVerificationMap[applicant.id] : "") || 
      applicant?.verificationLink || 
      globalStoredVerificationUrl;

    if (candidateUrl) {
      globalStoredVerificationUrl = candidateUrl;
      if (applicant?.id) {
        applicantVerificationMap[applicant.id] = candidateUrl;
      }
    }

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "PIPELINE",
      status: "info",
      message: "üöÄ Starting / Resuming E-Visa Automation Pipeline..."
    });

    if (globalStoredVerificationUrl) {
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "PIPELINE",
        status: "info",
        message: `üîë Unique verification link active: ${globalStoredVerificationUrl.slice(0, 45)}...`
      });
    }

    let currentStage = await detectEVisaPageStage(cloudPage);
    let currentUrl = "";
    try { currentUrl = cloudPage.url(); } catch (e) {}

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "PIPELINE",
      status: "info",
      message: `üìç Initial detected stage: ${currentStage}`
    });

    // 0. SESSION RECOVERY CHECK: If session is expired, or if page is disconnected / blank:
    if (
      (currentStage === "SESSION_EXPIRED" || currentStage === "UNKNOWN" || currentUrl === "about:blank" || !currentUrl.includes("evisa")) &&
      globalStoredVerificationUrl
    ) {
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "SESSION_RECOVERY",
        status: "info",
        message: "‚ö†Ô∏è Session expired or reset detected. Restoring applicant session via unique verification link..."
      });

      await safeNavigate(cloudPage, globalStoredVerificationUrl, 45000);
      await waitForPageAjaxAndIdle(cloudPage, 6000, 600);
      currentStage = await detectEVisaPageStage(cloudPage);
      
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "SESSION_RECOVERY",
        status: "success",
        message: `‚úÖ Session restored to stage: ${currentStage}`
      });
    }

    // Stage progression state machine loop
    let loopIterations = 0;
    const maxIterations = 14;
    let personalDataExecuted = false;
    let travelDocExecuted = false;
    let visaDetailsExecutedCount = 0;
    let journeyDetailsExecutedCount = 0;

    while (loopIterations < maxIterations) {
      loopIterations++;
      
      try {
        currentStage = await detectEVisaPageStage(cloudPage);
      } catch (e) {
        console.error("Error detecting stage:", e);
        throw new Error(`Failed to detect stage: ${e instanceof Error ? e.message : String(e)}`);
      }

      // Handle Session Expired inside the loop if encountered mid-process
      if (currentStage === "SESSION_EXPIRED") {
        if (globalStoredVerificationUrl) {
          cloudAgentLogs.push({
            timestamp: new Date().toLocaleTimeString(),
            stage: "SESSION_RECOVERY",
            status: "warning",
            message: "‚ö†Ô∏è Portal session expired mid-process! Auto-reloading unique verification link to resume from last save point..."
          });

          await safeNavigate(cloudPage, globalStoredVerificationUrl, 45000);
          await waitForPageAjaxAndIdle(cloudPage, 6000, 600);
          currentStage = await detectEVisaPageStage(cloudPage);
        } else {
          cloudAgentLogs.push({
            timestamp: new Date().toLocaleTimeString(),
            stage: "SESSION_EXPIRED",
            status: "error",
            message: "‚ö†Ô∏è Portal session has expired. Please paste your unique verification link in the box above to re-authenticate."
          });
          break;
        }
      }

      // 1. SUMMARY PAGE -> Click Update Visa Application (ActualizeazƒÉ cererea)
      // The E-Visa portal backend evaluates the file state and jumps directly to the latest saved point!
      if (currentStage === "SUMMARY_PAGE") {
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "SUMMARY_PAGE",
          status: "info",
          message: "üëâ On Summary page. Clicking 'Update visa application' (ActualizeazƒÉ cererea) to navigate to the latest save point..."
        });

        await clickUpdateVisaApplicationButton(cloudPage);
        await waitForPageAjaxAndIdle(cloudPage, 6000, 600);

        // Wait for portal to transition to the saved point (Select Visa Type, Diplomatic Mission, Visa Purpose, etc.)
        for (let i = 0; i < 7; i++) {
          await new Promise(r => setTimeout(r, 1000));
          const nextSt = await detectEVisaPageStage(cloudPage);
          if (nextSt !== "SUMMARY_PAGE" && nextSt !== "UNKNOWN") {
            currentStage = nextSt;
            break;
          }
        }

        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "SUMMARY_PAGE",
          status: "info",
          message: `üìç Portal navigated from Summary to active save point: ${currentStage}`
        });
        continue;
      }

      // 2. SELECT VISA TYPE -> Select Long-stay visa & click Next
      if (currentStage === "SELECT_VISA_TYPE") {
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "VISA_TYPE",
          status: "info",
          message: "üëâ On 'Select visa type' page. Selecting 'Long-stay visa' and clicking Next..."
        });

        await selectLongStayVisa(cloudPage);
        await new Promise(r => setTimeout(r, 2000));
        await waitForPageAjaxAndIdle(cloudPage, 5000, 500);

        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "VISA_TYPE",
          status: "info",
          message: "Clicking 'Next' (UrmƒÉtor) button..."
        });
        await clickNextButton(cloudPage);
        await waitForPageAjaxAndIdle(cloudPage, 6000, 800);

        // Wait for page transition to DIPLOMATIC_MISSION_PAGE
        for (let i = 0; i < 6; i++) {
          await new Promise(r => setTimeout(r, 1000));
          const nextSt = await detectEVisaPageStage(cloudPage);
          if (nextSt !== "SELECT_VISA_TYPE" && nextSt !== "UNKNOWN") {
            currentStage = nextSt;
            break;
          }
        }
        continue;
      }

      // 3. DIPLOMATIC MISSION PAGE -> Fill fields, double save, click Next
      if (currentStage === "DIPLOMATIC_MISSION_PAGE") {
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "DIPLOMATIC_MISSION_PAGE",
          status: "info",
          message: "üëâ On 'Select diplomatic mission' page. Auto-filling fields, saving, and clicking Next..."
        });

        const visaSel = applicant?.extractedVisaSelection || {};
        await executeDiplomaticMissionFlow(cloudPage, {
          nationality: visaSel.current_nationality || "Sri Lanka",
          residence: visaSel.country_of_residence || "Sri Lanka",
          mission: visaSel.diplomatic_mission || "Colombo",
          docType: visaSel.type_of_travel_document || "Ordinary/National passport"
        });

        await waitForPageAjaxAndIdle(cloudPage, 6000, 800);

        // Wait for page transition to VISA_PURPOSE_PAGE
        for (let i = 0; i < 6; i++) {
          await new Promise(r => setTimeout(r, 1000));
          const nextSt = await detectEVisaPageStage(cloudPage);
          if (nextSt !== "DIPLOMATIC_MISSION_PAGE" && nextSt !== "UNKNOWN") {
            currentStage = nextSt;
            break;
          }
        }
        continue;
      }

      // 4. VISA PURPOSE PAGE -> Select Employment (marked D/AM), click Save, click Next
      if (currentStage === "VISA_PURPOSE_PAGE") {
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "VISA_PURPOSE_PAGE",
          status: "info",
          message: "üëâ On 'Types of visas depending on purpose' page. Selecting 'Employment (marked D/AM)', clicking Save, then clicking Next..."
        });

        await executeVisaPurposeFlow(cloudPage);
        await waitForPageAjaxAndIdle(cloudPage, 6000, 800);

        // Wait for page transition
        for (let i = 0; i < 6; i++) {
          await new Promise(r => setTimeout(r, 1000));
          const nextSt = await detectEVisaPageStage(cloudPage);
          if (nextSt !== "VISA_PURPOSE_PAGE" && nextSt !== "UNKNOWN") {
            currentStage = nextSt;
            break;
          }
        }
        continue;
      }

      // 5. PARTICULAR SITUATIONS PAGE -> Select "I do not find myself in any...", click Next
      if (currentStage === "PARTICULAR_SITUATIONS_PAGE") {
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "PARTICULAR_SITUATIONS_PAGE",
          status: "info",
          message: "üëâ On 'Particular Situations' page. Selecting 'I do not find myself in any of the above-mentioned situations' and clicking Next..."
        });

        await executeParticularSituationsFlow(cloudPage);
        await waitForPageAjaxAndIdle(cloudPage, 6000, 800);

        // Wait for page transition
        for (let i = 0; i < 6; i++) {
          await new Promise(r => setTimeout(r, 1000));
          const nextSt = await detectEVisaPageStage(cloudPage);
          if (nextSt !== "PARTICULAR_SITUATIONS_PAGE" && nextSt !== "UNKNOWN") {
            currentStage = nextSt;
            break;
          }
        }
        continue;
      }

      // 6. TERRITORIAL JURISDICTION PAGE -> Select "National visa (long-stay)", click Save, click Next
      if (currentStage === "TERRITORIAL_JURISDICTION_PAGE") {
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "TERRITORIAL_JURISDICTION_PAGE",
          status: "info",
          message: "üëâ On 'Territorial Jurisdiction' page. Selecting 'National visa (long-stay)', clicking Save, then clicking Next..."
        });

        await executeTerritorialJurisdictionFlow(cloudPage);
        await waitForPageAjaxAndIdle(cloudPage, 6000, 800);

        // Wait for page transition
        for (let i = 0; i < 6; i++) {
          await new Promise(r => setTimeout(r, 1000));
          const nextSt = await detectEVisaPageStage(cloudPage);
          if (nextSt !== "TERRITORIAL_JURISDICTION_PAGE" && nextSt !== "UNKNOWN") {
            currentStage = nextSt;
            break;
          }
        }
        continue;
      }

      // 7. SUPPORTING DOCUMENTS PAGE -> Upload 6 documents, check declaration, Save, Next
      if (currentStage === "SUPPORTING_DOCUMENTS_PAGE") {
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "SUPPORTING_DOCUMENTS_PAGE",
          status: "info",
          message: "üëâ On 'Required Supporting Documents' page. Uploading 6 required documents, checking declaration, saving, and clicking Next..."
        });

        await executeSupportingDocumentsFlow(cloudPage, applicant);
        await waitForPageAjaxAndIdle(cloudPage, 6000, 800);

        // Wait for page transition
        for (let i = 0; i < 6; i++) {
          await new Promise(r => setTimeout(r, 1000));
          const nextSt = await detectEVisaPageStage(cloudPage);
          if (nextSt !== "SUPPORTING_DOCUMENTS_PAGE" && nextSt !== "UNKNOWN") {
            currentStage = nextSt;
            break;
          }
        }
        continue;
      }

      // 8. PERSONAL DATA OF APPLICANT PAGE -> Fill Date of Birth, Sri Lanka Country/Nationality, Sex, Marital status, Family, Save & Next
      if (currentStage === "PERSONAL_DATA_PAGE") {
        if (personalDataExecuted) {
          cloudAgentLogs.push({
            timestamp: new Date().toLocaleTimeString(),
            stage: "PERSONAL_DATA_PAGE",
            status: "warning",
            message: "‚ö†Ô∏è Personal Data page already automated in this run, but did not transition to the next stage. Breaking loop to avoid redundant re-typing."
          });
          break;
        }

        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "PERSONAL_DATA_PAGE",
          status: "info",
          message: "üëâ On 'Personal data of applicant' page. Filling Date of Birth, Sri Lanka Country of Birth, Sri Lanka Nationality at birth, Sex, Marital status, Family details, saving, and clicking Next..."
        });

        personalDataExecuted = true;
        await executePersonalDataFlow(cloudPage, applicant);
        await waitForPageAjaxAndIdle(cloudPage, 6000, 800);

        // Wait for page transition
        for (let i = 0; i < 6; i++) {
          await new Promise(r => setTimeout(r, 1000));
          const nextSt = await detectEVisaPageStage(cloudPage);
          if (nextSt !== "PERSONAL_DATA_PAGE" && nextSt !== "UNKNOWN") {
            currentStage = nextSt;
            break;
          }
        }
        continue;
      }

      // 9. TRAVEL DOCUMENT & CURRENT OCCUPATION PAGE -> 10-point standard execution
      if (currentStage === "TRAVEL_DOCUMENT_PAGE") {
        if (travelDocExecuted) {
          cloudAgentLogs.push({
            timestamp: new Date().toLocaleTimeString(),
            stage: "TRAVEL_DOCUMENT_PAGE",
            status: "warning",
            message: "‚ö†Ô∏è Travel Document page already automated in this run, attempting fallback click on Next button..."
          });
          await clickContinueWithoutPhotoButton(cloudPage);
          await handleContinuePromptsIfAny(cloudPage);
          await waitForPageAjaxAndIdle(cloudPage, 5000, 800);
          const retryStage = await detectEVisaPageStage(cloudPage);
          if (retryStage !== "TRAVEL_DOCUMENT_PAGE" && retryStage !== "UNKNOWN") {
            currentStage = retryStage;
            continue;
          } else {
            cloudAgentLogs.push({
              timestamp: new Date().toLocaleTimeString(),
              stage: "TRAVEL_DOCUMENT_PAGE",
              status: "warning",
              message: "‚ö†Ô∏è Travel Document page did not transition after fallback click. Breaking loop."
            });
            break;
          }
        }

        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "TRAVEL_DOCUMENT_PAGE",
          status: "info",
          message: "üëâ On 'Travel document and current occupation' page. Executing 10-point standard automation (Passport No, Sri Lanka Issuing Country, Colombo Authority, Dates, No Residence Permission, Occupation Dropdown & English Other Occupation, Cleared Employer, Save & Continue)..."
        });

        travelDocExecuted = true;
        await executeTravelDocumentOccupationFlow(cloudPage, applicant);
        await waitForPageAjaxAndIdle(cloudPage, 6000, 800);

        // Wait for page transition
        for (let i = 0; i < 6; i++) {
          await new Promise(r => setTimeout(r, 1000));
          const nextSt = await detectEVisaPageStage(cloudPage);
          if (nextSt !== "TRAVEL_DOCUMENT_PAGE" && nextSt !== "UNKNOWN") {
            currentStage = nextSt;
            break;
          }
        }
        continue;
      }

      // 10. DETAILS ABOUT VISA PAGE -> Main destination ROMANIA, Entries 2, Duration 90, Previous stays NO, Save & Next
      if (currentStage === "DETAILS_ABOUT_VISA") {
        if (visaDetailsExecutedCount >= 3) {
          cloudAgentLogs.push({
            timestamp: new Date().toLocaleTimeString(),
            stage: "DETAILS_ABOUT_VISA",
            status: "warning",
            message: "‚ö†Ô∏è Details About Visa page did not transition after 3 attempts. Attempting emergency force click on Next button..."
          });
          await clickNextButton(cloudPage);
          await handleContinuePromptsIfAny(cloudPage);
          await waitForPageAjaxAndIdle(cloudPage, 5000, 800);
          const finalStage = await detectEVisaPageStage(cloudPage);
          if (finalStage !== "DETAILS_ABOUT_VISA" && finalStage !== "UNKNOWN") {
            currentStage = finalStage;
            continue;
          }
          break;
        }

        visaDetailsExecutedCount++;
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "DETAILS_ABOUT_VISA",
          status: "info",
          message: `üëâ On 'Details about the visa' page (Attempt ${visaDetailsExecutedCount}/3). Filling Main Destination (ROMANIA), Number of entries (2), Duration of stay (90), Previous stays (NO), saving, and clicking Next...`
        });

        await executeVisaDetailsFlow(cloudPage, applicant);
        await waitForPageAjaxAndIdle(cloudPage, 6000, 800);

        // Wait for page transition
        for (let i = 0; i < 6; i++) {
          await new Promise(r => setTimeout(r, 1000));
          const nextSt = await detectEVisaPageStage(cloudPage);
          if (nextSt !== "DETAILS_ABOUT_VISA" && nextSt !== "UNKNOWN") {
            currentStage = nextSt;
            break;
          }
        }
        continue;
      }

      // 11. DETAILS REGARDING THE JOURNEY PAGE -> Dates, First entry Romania (119), Bucuresti border post, Air travel, Company details, Host company cover, Means of support, Save & Next
      if (currentStage === "DETAILS_REGARDING_JOURNEY") {
        if (journeyDetailsExecutedCount >= 3) {
          cloudAgentLogs.push({
            timestamp: new Date().toLocaleTimeString(),
            stage: "DETAILS_REGARDING_JOURNEY",
            status: "warning",
            message: "‚ö†Ô∏è Details Regarding the Journey page did not transition after 3 attempts. Attempting emergency force click on Next button..."
          });
          await clickNextButton(cloudPage);
          await handleContinuePromptsIfAny(cloudPage);
          await waitForPageAjaxAndIdle(cloudPage, 5000, 800);
          const finalStage = await detectEVisaPageStage(cloudPage);
          if (finalStage !== "DETAILS_REGARDING_JOURNEY" && finalStage !== "UNKNOWN") {
            currentStage = finalStage;
            continue;
          }
          break;
        }

        journeyDetailsExecutedCount++;
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "DETAILS_REGARDING_JOURNEY",
          status: "info",
          message: `üëâ On 'Details regarding the journey' page (Attempt ${journeyDetailsExecutedCount}/3). Filling Arrival Date (+1 month), Departure Date (+3 months), First Entry (ROMANIA), Border Post (BUCURESTI), Planned Route (AIR TRAVEL), Company Details, Host Company Cost Cover, Means of Support (Cash, Accom, Insurance), saving, and clicking Next...`
        });

        await executeJourneyDetailsFlow(cloudPage, applicant);
        await waitForPageAjaxAndIdle(cloudPage, 6000, 800);

        // Wait for page transition
        for (let i = 0; i < 6; i++) {
          await new Promise(r => setTimeout(r, 1000));
          const nextSt = await detectEVisaPageStage(cloudPage);
          if (nextSt !== "DETAILS_REGARDING_JOURNEY" && nextSt !== "UNKNOWN") {
            currentStage = nextSt;
            break;
          }
        }
        continue;
      }
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "PIPELINE",
        status: "info",
        message: `‚ÑπÔ∏è Pipeline iteration concluded at stage: ${currentStage}`
      });
      break;
    }

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "PIPELINE",
      status: "success",
      message: "üéâ Automation Pipeline step(s) completed successfully!"
    });

    const screenshotBuffer = await cloudPage.screenshot({ type: "jpeg", quality: 75 });
    const b64 = "data:image/jpeg;base64," + screenshotBuffer.toString("base64");

    return res.json({
      success: true,
      currentStage,
      url: cloudPage.url(),
      screenshot: b64,
      logs: cloudAgentLogs
    });
  } catch (err: any) {
    console.error("Pipeline Execution Error:", err);
    return res.status(500).json({ 
        success: false, 
        error: err.message, 
        stack: err.stack,
        logs: cloudAgentLogs 
    });
  }
});

// Intelligent cloud-autofill using standard DOM mappings and optional Gemini Vision
app.post("/api/cloud-agent/autofill", async (req, res) => {
  try {
    if (!cloudPage) {
      return res.status(400).json({ success: false, error: "No active cloud browser session" });
    }

    const { applicant, section } = req.body;

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "AUTO_FILL",
      status: "info",
      message: `Starting E-Visa AI Auto-Fill stage: ${section || "All Fields"}`
    });

    // Detect if on "Select visa type" page and automate it
    const pageStage = await detectEVisaPageStage(cloudPage);

    if (pageStage === "SELECT_VISA_TYPE") {
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "VISA_TYPE",
        status: "info",
        message: "'Select visa type' page detected! Automating Long-stay visa selection..."
      });

      const selected = await selectLongStayVisa(cloudPage);
      if (selected) {
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "VISA_TYPE",
          status: "success",
          message: "Selected 'Long-stay visa' option. Waiting 3 seconds for postback..."
        });
      }

      await new Promise(resolve => setTimeout(resolve, 3000));

      const clickedNext = await clickNextButton(cloudPage);
      if (clickedNext) {
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "VISA_TYPE",
          status: "success",
          message: "Clicked 'Next' button! Waiting 4.5 seconds for main form fields to load..."
        });
        await new Promise(resolve => setTimeout(resolve, 4500));
      }
    } else if (pageStage === "VISA_PURPOSE_PAGE") {
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "VISA_PURPOSE_PAGE",
        status: "info",
        message: "'Types of visas depending on purpose' page detected! Automating 'Employment (marked D/AM)', Save & Next..."
      });
      await executeVisaPurposeFlow(cloudPage);
    }

    // Prepare dataset to inject
    const addressData = applicant.extractedAddressDetails || {};
    const hostData = applicant.extractedHostDetails || {};
    const familyData = applicant.extractedFamilyDetails || {};
    const passportData = applicant.extractedPassportDetails || {};

    const dataToFill = {
      // Applicant home address fields
      "home_country": addressData.home_country || applicant.home_country || "Sri Lanka",
      "place": addressData.place_of_birth || applicant.place_of_birth || "",
      "address": addressData.address || applicant.address || "",
      
      // Host details fields
      "type_of_host": hostData.type_of_host || applicant.type_of_host || "Hotel",
      "hotel_name": hostData.hotel_name || applicant.hotel_name || "",
      "host_address": hostData.host_address || applicant.host_address || "",

      // Family details
      "spouse_surname": familyData.spouse_surname || applicant.spouse_surname || "",
      "spouse_first_name": familyData.spouse_first_name || applicant.spouse_first_name || "",
      "spouse_birth_surname": familyData.spouse_birth_surname || applicant.spouse_birth_surname || "",
    };

    // Inject the intelligent autofill script into the browser page context
    const filledCount = await cloudPage.evaluate((data: any) => {
      const labels = Array.from(document.querySelectorAll("label"));

      function findAndFillInput(labelTextOrSub: string, val: string) {
        if (!val) return false;
        
        const label = labels.find((l) =>
          l.textContent && l.textContent.toLowerCase().includes(labelTextOrSub.toLowerCase())
        );

        if (label) {
          // Check associated id via 'for'
          const htmlFor = label.getAttribute("for");
          if (htmlFor) {
            const input = document.getElementById(htmlFor) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
            if (input) {
              return fillElement(input, val);
            }
          }
          // Check child element
          const childInput = label.querySelector("input, select, textarea") as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
          if (childInput) {
            return fillElement(childInput, val);
          }
          // Check following sibling
          const siblingInput = label.nextElementSibling;
          if (siblingInput) {
            const input = siblingInput.matches("input, select, textarea")
              ? (siblingInput as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement)
              : (siblingInput.querySelector("input, select, textarea") as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null);
            if (input) {
              return fillElement(input, val);
            }
          }
        }

        // Sibling query fallback
        const divs = Array.from(document.querySelectorAll("div"));
        const matchingContainer = divs.find(d => d.textContent && d.textContent.trim().toLowerCase() === labelTextOrSub.toLowerCase());
        if (matchingContainer) {
          const input = matchingContainer.querySelector("input, select, textarea") || matchingContainer.nextElementSibling?.querySelector("input, select, textarea") || matchingContainer.parentElement?.querySelector("input, select, textarea");
          if (input) {
            return fillElement(input as any, val);
          }
        }

        // Attribute fallback
        const inputs = Array.from(document.querySelectorAll("input, select, textarea")) as (HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement)[];
        const input = inputs.find((i) => {
          const id = i.getAttribute("id") || "";
          const name = i.getAttribute("name") || "";
          const placeholder = i.getAttribute("placeholder") || "";
          const str = (id + " " + name + " " + placeholder).toLowerCase();
          return str.includes(labelTextOrSub.toLowerCase());
        });

        if (input) {
          return fillElement(input, val);
        }
        return false;
      }

      function fillElement(el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, val: string) {
        if (el.tagName.toLowerCase() === "select") {
          const selectEl = el as HTMLSelectElement;
          const options = Array.from(selectEl.options);
          
          // Match by text or value
          const option = options.find(
            (o) =>
              o.text.toLowerCase().includes(val.toLowerCase()) ||
              o.value.toLowerCase().includes(val.toLowerCase())
          );
          if (option) {
            selectEl.value = option.value;
            selectEl.dispatchEvent(new Event("change", { bubbles: true }));
            return true;
          }
        } else {
          el.value = val;
          el.dispatchEvent(new Event("input", { bubbles: true }));
          el.dispatchEvent(new Event("change", { bubbles: true }));
          return true;
        }
        return false;
      }

      // Map keys to potential label texts in English and Romanian
      const mapping: Record<string, string[]> = {
        "home_country": ["Home country", "»öara de origine", "country", "tara"],
        "place": ["Place of birth", "Localitate", "place", "Locul nasterii", "Locul na≈üterii"],
        "address": ["Address", "Adresa", "domiciliu", "Domiciliul"],
        "type_of_host": ["Type of host", "Tipul gazdei", "gazda"],
        "hotel_name": ["Hotel name", "Nume hotel", "hotel", "gazda", "Numele gazdei"],
        "host_address": ["Host address", "Adresa gazda", "host_address", "Adresa gazdei"],
        "spouse_surname": ["Surname of spouse", "Numele de familie al sotului", "spouse_surname", "Numele so≈£ului"],
        "spouse_first_name": ["First name", "Prenume", "spouse_first_name", "Prenumele so≈£ului"],
        "spouse_birth_surname": ["Surname of spouse at birth", "Numele la nastere", "spouse_birth_surname", "Numele la na≈ütere"],
      };

      let filledCount = 0;
      for (const [key, val] of Object.entries(data)) {
        if (!val) continue;
        const labelsToTry = mapping[key] || [key];
        for (const label of labelsToTry) {
          if (findAndFillInput(label, val as string)) {
            filledCount++;
            break;
          }
        }
      }
      return filledCount;
    }, dataToFill);

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "AUTO_FILL",
      status: "success",
      message: `Form scanning finished! Successfully populated ${filledCount} input field(s).`
    });

    // Check if Gemini Vision check can be run
    if (process.env.GEMINI_API_KEY) {
      try {
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "VISION_AI",
          status: "info",
          message: "Invoking Gemini Vision AI server-side to inspect the form for errors..."
        });

        const screenshotBuffer = await cloudPage.screenshot({ type: "png" });
        
        const response = await callGeminiApi({
          contents: [
            {
              inlineData: {
                data: screenshotBuffer.toString("base64"),
                mimeType: "image/png"
              }
            },
            `Inspect this screenshot of the Romanian eVisa portal form. Provide a concise 1-sentence analysis of the page status, errors, incomplete fields, or any CAPTCHAs visible.`
          ]
        });

        const comment = response.text || "Form page visually looks stable and correct.";
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "VISION_AI",
          status: "success",
          message: `Gemini Visual Inspection: "${comment.trim()}"`
        });
      } catch (geminiErr: any) {
        console.error("Gemini Visual Check Error:", geminiErr);
        cloudAgentLogs.push({
          timestamp: new Date().toLocaleTimeString(),
          stage: "VISION_AI",
          status: "warning",
          message: `Visual check bypassed: ${geminiErr.message}`
        });
      }
    }

    const screenshotBuffer = await cloudPage.screenshot({ type: "jpeg", quality: 75 });
    const b64 = "data:image/jpeg;base64," + screenshotBuffer.toString("base64");

    return res.json({
      success: true,
      filledCount,
      url: cloudPage.url(),
      screenshot: b64,
      logs: cloudAgentLogs
    });
  } catch (err: any) {
    console.error("Cloud Autofill Exception:", err);
    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "AUTO_FILL",
      status: "error",
      message: `Auto-fill exception: ${err.message}`
    });
    return res.status(500).json({ success: false, error: err.message });
  }
});

