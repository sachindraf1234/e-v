    ];
    let el = document.querySelector<HTMLInputElement | HTMLTextAreaElement>(routeSelectors.join(', '));
    if (!el) {
      const labels = Array.from(document.querySelectorAll('label, th, td, span, div'));
      for (const l of labels) {
        const txt = (l.textContent || '').toLowerCase();
        if (txt.includes('planned route') || txt.includes('traseul planificat') || txt.includes('itinerariu')) {
          const container = l.closest('tr, .form-group, .row, div, td');
          const inp = container ? container.querySelector<HTMLInputElement | HTMLTextAreaElement>('input[type="text"], textarea, input:not([type])') : null;
          if (inp) {
