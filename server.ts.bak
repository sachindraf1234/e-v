    status: selected ? "success" : "info",
    message: selected 
      ? "‚úÖ Selected 'I do not find myself in any of the above-mentioned situations'! Proceeding to Save..." 
      : "‚ÑπÔ∏è Option clicked, proceeding to Save..."
  });

  await new Promise(r => setTimeout(r, 1000));
  await waitForPageAjaxAndIdle(page, 4000, 300);

  // Click Save button
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PARTICULAR_SITUATIONS_PAGE",
    status: "info",
    message: "üíæ Save Sequence: Clicking 'Save' (Salvare) button to persist Particular Situations..."
  });

  const saveSuccess = await clickSaveButton(page);
  await new Promise(r => setTimeout(r, 600));
  await waitForPageAjaxAndIdle(page, 2000, 200);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PARTICULAR_SITUATIONS_PAGE",
    status: saveSuccess ? "success" : "info",
    message: saveSuccess ? "‚úÖ Clicked 'Save' button successfully! Particular Situations saved." : "‚ÑπÔ∏è Save button clicked."
  });

  // Click Next button IMMEDIATELY without lengthy delays
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PARTICULAR_SITUATIONS_PAGE",
    status: "info",
    message: "üëâ Next Sequence: Clicking 'Next' (UrmƒÉtor) button IMMEDIATELY after Save..."
  });

  // Re-verify radio is still checked before clicking Next
  await page.evaluate(() => {
    try {
      const radios = Array.from(document.querySelectorAll<HTMLInputElement>('input[type="radio"]'));
      for (let i = 0; i < radios.length; i++) {
        const r = radios[i];
        const parent = r.closest('td, tr, div, li');
        const txt = (parent ? parent.textContent || '' : '').toLowerCase();
        if (txt.includes('do not find') || txt.includes('nu mƒÉ aflu') || txt.includes('nu ma aflu') || i === 2) {
          if (!r.checked) {
            r.checked = true;
            r.dispatchEvent(new Event('change', { bubbles: true }));
          }
          break;
        }
      }
    } catch (e) {}
  }).catch(() => {});

  let nextSuccess = false;
  for (let attempt = 1; attempt <= 3; attempt++) {
    nextSuccess = await clickNextButton(page);
    if (nextSuccess) break;
    await new Promise(r => setTimeout(r, 400));
  }

  await new Promise(r => setTimeout(r, 1000));
  await waitForPageAjaxAndIdle(page, 4000, 400);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PARTICULAR_SITUATIONS_PAGE",
    status: nextSuccess ? "success" : "info",
    message: nextSuccess ? "‚úÖ Clicked 'Next' button successfully! Advanced to Territorial Jurisdiction page." : "‚ÑπÔ∏è Next action submitted."
  });

  return { selected, saveSuccess, nextSuccess };
}

// Master flow for "Territorial Jurisdiction" page (Image VISA7.png)
async function executeTerritorialJurisdictionFlow(page: any): Promise<{
  selected: boolean;
  saveSuccess: boolean;
  nextSuccess: boolean;
}> {
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TERRITORIAL_JURISDICTION_PAGE",
    status: "info",
    message: "üëâ [Step 6] Automating 'Territorial Jurisdiction' page (National visa long-stay, Save & Next)..."
  });

  const pollStart = Date.now();
  while (Date.now() - pollStart < 8000) {
    const st = await detectEVisaPageStage(page);
    if (st === "TERRITORIAL_JURISDICTION_PAGE") {
      break;
    } else if (st === "PARTICULAR_SITUATIONS_PAGE") {
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "TERRITORIAL_JURISDICTION_PAGE",
        status: "info",
        message: "Still on Particular Situations page. Re-submitting 'Next' button..."
      });
      await clickNextButton(page);
      await waitForPageAjaxAndIdle(page, 4000, 400);
    }
    await new Promise(r => setTimeout(r, 500));
  }

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TERRITORIAL_JURISDICTION_PAGE",
    status: "info",
    message: "üëâ Selecting 'National visa (long-stay)' radio button..."
  });

  const selected = await selectTerritorialJurisdiction(page);
  
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TERRITORIAL_JURISDICTION_PAGE",
    status: selected ? "success" : "info",
    message: selected 
      ? "‚úÖ Selected 'National visa (long-stay)' option! Proceeding to Save (SAVE POINT)..." 
      : "‚ÑπÔ∏è Option clicked, proceeding to Save..."
  });

  await new Promise(r => setTimeout(r, 1000));
  await waitForPageAjaxAndIdle(page, 4000, 300);

  // Click Save button (SAVE POINT!)
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TERRITORIAL_JURISDICTION_PAGE",
    status: "info",
    message: "üíæ Save Sequence: Clicking 'Save' button (SAVE POINT)..."
  });

  const saveSuccess = await clickSaveButton(page);
  await new Promise(r => setTimeout(r, 2000));
  await waitForPageAjaxAndIdle(page, 6000, 500);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TERRITORIAL_JURISDICTION_PAGE",
    status: saveSuccess ? "success" : "info",
    message: saveSuccess ? "‚úÖ Clicked 'Save' button successfully! Territorial Jurisdiction save point locked." : "‚ÑπÔ∏è Save button clicked."
  });

  // Click Next button
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TERRITORIAL_JURISDICTION_PAGE",
    status: "info",
    message: "üëâ Next Sequence: Clicking 'Next' (UrmƒÉtor) button..."
  });

  const nextSuccess = await clickNextButton(page);
  await new Promise(r => setTimeout(r, 2500));
  await waitForPageAjaxAndIdle(page, 6000, 600);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TERRITORIAL_JURISDICTION_PAGE",
    status: nextSuccess ? "success" : "info",
    message: nextSuccess ? "‚úÖ Clicked 'Next' button successfully! Advanced to next application section." : "‚ÑπÔ∏è Next action submitted."
  });

  return { selected, saveSuccess, nextSuccess };
}

// ==========================================
// Supporting Documents Page Automation Setup
// ==========================================
const SUPPORTING_DOCS_DIR = path.join(os.tmpdir(), "evisa_supporting_docs");

interface SupportingDocDef {
  key: string;
  order: number;
  label: string;
  keywords: string[];
  defaultFileName: string;
  defaultTitle: string;
  suffixCode: string;
}

const SUPPORTING_DOCUMENT_DEFINITIONS: SupportingDocDef[] = [
  {
    key: "WORK_PERMIT",
    order: 1,
    label: "1 WORK PERMIT",
    keywords: ["work permit", "work", "permit", "autorizatie de munca", "autoriza»õie de muncƒÉ", "autorizatie", "munca", "mun_1", "_mun_"],
    defaultFileName: "WORK_PERMIT.pdf",
    defaultTitle: "WORK PERMIT / AUTORIZATIE DE MUNCA",
    suffixCode: "MUN"
  },
  {
    key: "MEANS_OF_SUPPORT",
    order: 2,
    label: "2 MEANS OF SUPPORT",
    keywords: ["means of support", "means", "support", "agreement", "contract", "mijloace de intretinere", "mijloace de √Æntre»õinere", "mijloace", "fin_1", "_fin_"],
    defaultFileName: "AGREEMENT.pdf",
    defaultTitle: "MEANS OF SUPPORT / INDIVIDUAL EMPLOYMENT CONTRACT",
    suffixCode: "FIN"
  },
  {
    key: "CRIMINAL_RECORD",
    order: 3,
    label: "3 CRIMINAL RECORD",
    keywords: ["criminal record", "criminal", "record", "police report", "police clearance", "police", "cazier judiciar", "cazier", "jud_1", "_jud_"],
    defaultFileName: "POLICE_REPORT.pdf",
    defaultTitle: "CRIMINAL RECORD / POLICE CLEARANCE REPORT",
    suffixCode: "JUD"
  },
  {
    key: "TRAVEL_MEDICAL_INSURANCE",
    order: 4,
    label: "4 TRAVEL MEDICAL INSURANCE",
    keywords: ["travel medical insurance", "medical insurance", "insurance", "asigurare medicala", "asigurare medicalƒÉ", "asigurare", "med_1", "_med_"],
    defaultFileName: "INSURANCE.pdf",
    defaultTitle: "TRAVEL MEDICAL INSURANCE POLICY",
    suffixCode: "MED"
  },
  {
    key: "VALID_TRAVEL_DOCUMENT",
    order: 5,
    label: "5 VALID TRAVEL DOCUMENT",
    keywords: ["valid travel document", "travel document", "passport", "pasaport", "pa»ôaport", "document de calatorie", "document de cƒÉlƒÉtorie", "pas_1", "_pas_"],
    defaultFileName: "PASSPORT.pdf",
    defaultTitle: "VALID TRAVEL DOCUMENT / PASSPORT COPY",
    suffixCode: "PAS"
  },
  {
    key: "PHOTOGRAPHS",
    order: 6,
    label: "6 PHOTOGRAPHS",
    keywords: ["photographs", "photograph", "photo", "img", "fotografii", "fotografie", "poza", "fot_1", "_fot_"],
    defaultFileName: "PHOTOGRAPHS.pdf",
    defaultTitle: "APPLICANT PHOTOGRAPHS / BIOMETRIC PHOTO",
    suffixCode: "FOT"
  }
];

function createValidPdfBuffer(title: string, content: string): Buffer {
  const streamContent = `BT /F1 16 Tf 50 700 Td (${title}) Tj /F1 12 Tf 50 660 Td (${content}) Tj ET`;
  const streamLength = Buffer.byteLength(streamContent, 'utf-8');
  
  const pdfData = 
`%PDF-1.4
1 0 obj
<< /Type /Catalog /Pages 2 0 R >>
endobj
2 0 obj
<< /Type /Pages /Kids [3 0 R] /Count 1 >>
endobj
3 0 obj
<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>
endobj
4 0 obj
<< /Length ${streamLength} >>
stream
${streamContent}
endstream
endobj
5 0 obj
<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>
endobj
xref
0 6
0000000000 65535 f 
0000000009 00000 n 
0000000058 00000 n 
0000000115 00000 n 
0000000244 00000 n 
0000000300 00000 n 
trailer
<< /Size 6 /Root 1 0 R >>
startxref
390
%%EOF`;
  return Buffer.from(pdfData, 'utf-8');
}

function ensureSupportingDocumentFiles(applicant?: any): { [key: string]: { path: string; name: string } } {
  if (!fs.existsSync(SUPPORTING_DOCS_DIR)) {
    fs.mkdirSync(SUPPORTING_DOCS_DIR, { recursive: true });
  }

  const result: { [key: string]: { path: string; name: string } } = {};
  const applicantDocs: any[] = applicant?.documents || [];
  const applicantName = `${applicant?.personalData?.first_names || ''} ${applicant?.personalData?.surname || ''}`.trim() || "APPLICANT";

  for (const def of SUPPORTING_DOCUMENT_DEFINITIONS) {
    const match = applicantDocs.find(d => {
      if (d.typeKey && d.typeKey.toUpperCase() === def.key) return true;
      const fn = (d.fileName || d.label || '').toLowerCase();
      return def.keywords.some(kw => fn.includes(kw));
    });

    let targetFileName = def.defaultFileName;
    if (match && match.fileName && match.fileName !== "Not Uploaded") {
      targetFileName = match.fileName.replace(/[^\x00-\x7F]/g, "_");
      if (!targetFileName.toLowerCase().endsWith(".pdf") && !targetFileName.toLowerCase().endsWith(".jpg") && !targetFileName.toLowerCase().endsWith(".png")) {
        targetFileName += ".pdf";
      }
    }

    const targetFilePath = path.join(SUPPORTING_DOCS_DIR, targetFileName);

    if (match && match.fileDataUrl && match.fileDataUrl.length > 20) {
      try {
        const base64Data = match.fileDataUrl.includes(",") ? match.fileDataUrl.split(",")[1] : match.fileDataUrl;
        const buffer = Buffer.from(base64Data, "base64");
        fs.writeFileSync(targetFilePath, buffer);
      } catch (e) {
        console.warn(`Failed to decode Base64 file for ${def.key}, using fallback:`, e);
        const fallbackBuf = createValidPdfBuffer(def.defaultTitle, `Document for ${applicantName} - ${def.label}`);
        fs.writeFileSync(targetFilePath, fallbackBuf);
      }
    } else if (!fs.existsSync(targetFilePath)) {
      const fallbackBuf = createValidPdfBuffer(def.defaultTitle, `Document for ${applicantName} - ${def.label}`);
      fs.writeFileSync(targetFilePath, fallbackBuf);
    }

    result[def.key] = {
      path: targetFilePath,
      name: targetFileName
    };
  }

  return result;
}

// Uploads a single document section on the Supporting Documents page
async function uploadSupportingDocSection(
  page: any,
  def: SupportingDocDef,
  filePath: string
): Promise<{ success: boolean; alreadyUploaded: boolean; fileName: string }> {
  let uploaded = false;

  for (const frame of page.frames()) {
    try {
      if (frame.isDetached()) continue;

      // 1. Check if section already has an uploaded file
      const status = await frame.evaluate((order: number, keywords: string[], suffixCode: string) => {
        const norm = (s: string) => (s || '').toLowerCase();
        const allElements = Array.from(document.querySelectorAll('tr, fieldset, .form-group, .row, div, table, p, h1, h2, h3, h4, h5, h6'));
        
        let sectionEl: HTMLElement | null = null;
        for (const el of allElements) {
          const txt = norm(el.textContent || '');
          const matchOrder = txt.includes(`${order} `) || txt.includes(`${order}.`) || txt.startsWith(`${order}`);
          const matchKeyword = keywords.some(kw => txt.includes(kw));
          if (matchOrder && matchKeyword) {
            sectionEl = (el.closest('tr, fieldset, .form-group, .row') || el) as HTMLElement;
            break;
          }
        }

        const container = sectionEl || document.body;
        const text = norm(container.textContent || '');

        const hasUploadedMarker = 
          text.includes(`_${suffixCode.toLowerCase()}_`) || 
          text.includes('file uploaded') || 
          text.includes('fi»ôier √ÆncƒÉrcat') || 
          text.includes('fisier incarcat');

        const deleteBtn = container.querySelector('a[id*="delete" i], a[title*="sterge" i], a[title*="delete" i], img[src*="delete" i], img[src*="sterge" i], .glyphicon-remove, [class*="remove" i], [class*="delete" i]');

        return {
          found: !!sectionEl,
          alreadyUploaded: hasUploadedMarker || (!!deleteBtn && (text.includes('.pdf') || text.includes('.jpg') || text.includes('.png')))
        };
      }, def.order, def.keywords, def.suffixCode);

      if (status.alreadyUploaded) {
        return { success: true, alreadyUploaded: true, fileName: path.basename(filePath) };
      }

      // 2. Locate container/row for this document
      const sectionInfo = await frame.evaluate((order: number, keywords: string[]) => {
        const norm = (s: string) => (s || '').toLowerCase();
        const allRows = Array.from(document.querySelectorAll('tr, fieldset, .form-group, .row, div.document-row, div.upload-row, div'));
        
        let bestRow: HTMLElement | null = null;
        for (const r of allRows) {
          const txt = norm(r.textContent || '');
          if ((txt.includes(`${order}.`) || txt.includes(`${order} `) || txt.startsWith(`${order}`)) && keywords.some(kw => txt.includes(kw))) {
            bestRow = (r.closest('tr, fieldset, .form-group, .row') || r) as HTMLElement;
            break;
          }
        }

        if (bestRow) {
          bestRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
          bestRow.setAttribute('data-target-upload-order', String(order));
          return { found: true };
        }
        return { found: false };
      }, def.order, def.keywords);

      // Method A: Look for <input type="file"> specifically in the target row or by index
      let targetInputHandle = null;
      if (sectionInfo && sectionInfo.found) {
        targetInputHandle = await frame.$(`[data-target-upload-order="${def.order}"] input[type="file"]`);
      }

      if (!targetInputHandle) {
        const allFileInputs = await frame.$$('input[type="file"]');
        if (allFileInputs.length >= def.order) {
          targetInputHandle = allFileInputs[def.order - 1];
        } else if (allFileInputs.length > 0) {
          targetInputHandle = allFileInputs[0];
        }
      }

      if (targetInputHandle) {
        try {
          await targetInputHandle.uploadFile(filePath);
          await frame.evaluate((el: any) => {
            el.dispatchEvent(new Event('input', { bubbles: true }));
            el.dispatchEvent(new Event('change', { bubbles: true }));
            if (typeof (window as any).$ !== 'undefined') {
              try { (window as any).$(el).trigger('change'); } catch(e){}
            }
          }, targetInputHandle);
          uploaded = true;
        } catch (e) {
          console.warn(`Direct uploadFile failed for ${def.label}:`, e);
        }
      }

      // Method B: Click the Upload/Browse button with waitForFileChooser
      if (!uploaded) {
        let uploadBtn = null;
        if (sectionInfo && sectionInfo.found) {
          uploadBtn = await frame.$(`[data-target-upload-order="${def.order}"] button, [data-target-upload-order="${def.order}"] input[type="button"], [data-target-upload-order="${def.order}"] input[type="submit"], [data-target-upload-order="${def.order}"] a.btn, [data-target-upload-order="${def.order}"] label`);
        }

        if (!uploadBtn) {
          const uploadButtons = await frame.$$('button, input[type="button"], input[type="submit"], a.btn, a[role="button"]');
          for (const btn of uploadButtons) {
            const isMatch = await frame.evaluate((el: any, order: number, keywords: string[]) => {
              const norm = (s: string) => (s || '').toLowerCase();
              const txt = norm(el.textContent || el.value || '');
              if (!txt.includes('upload') && !txt.includes('√ÆncarcƒÉ') && !txt.includes('incarca') && !txt.includes('browse') && !txt.includes('alege')) return false;

              const parent = el.closest('tr, fieldset, .form-group, .row') || el.parentElement;
              const parentText = norm(parent ? parent.textContent || '' : '');
              return parentText.includes(`${order}`) || keywords.some(k => parentText.includes(k));
            }, btn, def.order, def.keywords);

            if (isMatch) {
              uploadBtn = btn;
              break;
            }
          }
        }

        if (uploadBtn) {
          try {
            const [fileChooser] = await Promise.all([
              page.waitForFileChooser({ timeout: 4000 }).catch(() => null),
              uploadBtn.click({ delay: 50 }).catch(() => {})
            ]);

            if (fileChooser) {
              await fileChooser.accept([filePath]);
              uploaded = true;
            }
          } catch (e) {
            console.warn(`FileChooser trigger fallback for ${def.label}:`, e);
          }
        }
      }

      // If portal requires clicking an "Upload / √éncarcƒÉ" button after file selection
      await frame.evaluate((order: number) => {
        const row = document.querySelector(`[data-target-upload-order="${order}"]`) || document.body;
        const uploadBtns = Array.from(row.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button, input[type="button"], input[type="submit"], a.btn'));
        for (const btn of uploadBtns) {
          const txt = ((btn as any).textContent || (btn as any).value || '').toLowerCase();
          if (txt.includes('upload') || txt.includes('√ÆncarcƒÉ') || txt.includes('incarca') || txt.includes('trimite')) {
            btn.click();
            break;
          }
        }
      }, def.order);

      // 3. Monitor Upload Progress and Completion
      const startTime = Date.now();
      let completed = false;

      while (Date.now() - startTime < 15000) {
        await new Promise(r => setTimeout(r, 600));

        const uploadProgress = await frame.evaluate((order: number, keywords: string[], suffixCode: string) => {
          const norm = (s: string) => (s || '').toLowerCase();
          const row = document.querySelector(`[data-target-upload-order="${order}"]`) || document.body;
          const text = norm(row.textContent || '');

          const isUploading = text.includes('file uploading') || text.includes('se √ÆncarcƒÉ') || text.includes('se incarca');
          const isUploaded = text.includes('file uploaded') || text.includes('fi»ôier √ÆncƒÉrcat') || text.includes('fisier incarcat') || text.includes(`_${suffixCode.toLowerCase()}_`) || text.includes('.pdf') || text.includes('.jpg');

          return { isUploading, isUploaded };
        }, def.order, def.keywords, def.suffixCode);

        if (uploadProgress.isUploaded && !uploadProgress.isUploading) {
          completed = true;
          break;
        }
      }

      if (uploaded || completed) {
        return { success: true, alreadyUploaded: false, fileName: path.basename(filePath) };
      }
    } catch (err) {
      console.error(`uploadSupportingDocSection error for ${def.label}:`, err);
    }
  }

  return { success: uploaded, alreadyUploaded: false, fileName: path.basename(filePath) };
}

// Helper to find and check the mandatory declaration checkbox on Supporting Documents page
async function checkSupportingDocumentsDeclaration(page: any): Promise<boolean> {
  let checked = false;
  try {
    for (const frame of page.frames()) {
      try {
        if (frame.isDetached()) continue;

        const res = await frame.evaluate(() => {
          const norm = (s: string) => (s || '').trim().toLowerCase();
          const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
          
          let targetCheckbox: HTMLInputElement | null = null;
          let targetLabel: HTMLElement | null = null;

          for (const chk of checkboxes) {
            const parent = chk.closest('label, div, td, tr, p, fieldset, li') || chk.parentElement;
            const txt = norm(parent ? parent.textContent || '' : '');
            
            // Check associated label element
            const id = chk.id;
            const labelEl = id ? document.querySelector(`label[for="${id}"]`) : null;
            const labelTxt = norm(labelEl ? labelEl.textContent || '' : '');

            const isDeclaration =
              txt.includes('i am aware of the supporting documents') ||
              txt.includes('supporting documents that are requested') ||
              txt.includes('am luat la cuno»ôtin»õƒÉ') ||
              txt.includes('am luat la cunostinta') ||
              txt.includes('sunt con»ôtient') ||
              txt.includes('sunt constient') ||
              txt.includes('diplomatic mission/consular post of romania') ||
              txt.includes('misiune diplomaticƒÉ') ||
              txt.includes('misiune diplomatica') ||
              labelTxt.includes('i am aware') ||
              labelTxt.includes('am luat la cuno»ôtin»õƒÉ') ||
              labelTxt.includes('am luat la cunostinta');

            if (isDeclaration) {
              targetCheckbox = chk;
              targetLabel = (labelEl as HTMLElement) || (parent?.tagName === 'LABEL' ? parent as HTMLElement : null);
              break;
            }
          }

          // Fallback: if single checkbox on supporting documents page
          if (!targetCheckbox && checkboxes.length > 0) {
            targetCheckbox = checkboxes[checkboxes.length - 1];
          }

          if (targetCheckbox) {
            targetCheckbox.scrollIntoView({ behavior: 'smooth', block: 'center' });
            targetCheckbox.focus();

            // Set checked state and dispatch all necessary DOM events
            targetCheckbox.checked = true;
            targetCheckbox.dispatchEvent(new MouseEvent('mouseover', { bubbles: true }));
            targetCheckbox.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
            targetCheckbox.dispatchEvent(new MouseEvent('mouseup', { bubbles: true }));
            targetCheckbox.dispatchEvent(new MouseEvent('click', { bubbles: true }));
            targetCheckbox.dispatchEvent(new Event('input', { bubbles: true }));
            targetCheckbox.dispatchEvent(new Event('change', { bubbles: true }));

            if (targetLabel) {
              try {
                targetLabel.dispatchEvent(new MouseEvent('click', { bubbles: true }));
              } catch(e) {}
            }

            if (typeof (window as any).$ !== 'undefined') {
              try {
                (window as any).$(targetCheckbox).prop('checked', true).trigger('change');
              } catch(e) {}
            }

            targetCheckbox.checked = true;
            return { found: true, id: targetCheckbox.id, checked: targetCheckbox.checked };
          }

          return { found: false, count: checkboxes.length };
        });

        if (res && res.found && res.checked) {
          checked = true;
          break;
        }
      } catch (e) {}
    }
  } catch (err) {
    console.error("checkSupportingDocumentsDeclaration error:", err);
  }

  return checked;
}

// Master flow for "Required Supporting Documents" page (Image combined-vertical-1787469390976.jpg)
async function executeSupportingDocumentsFlow(page: any, applicant?: any): Promise<{
  allUploaded: boolean;
  declarationChecked: boolean;
  saveSuccess: boolean;
  nextSuccess: boolean;
}> {
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "SUPPORTING_DOCUMENTS_PAGE",
    status: "info",
    message: "üëâ [Step 7] Automating 'Required Supporting Documents' page (Uploading 6 Base64 documents, Declaration Checkbox, Save & Next)..."
  });

  const pollStart = Date.now();
  while (Date.now() - pollStart < 8000) {
    const st = await detectEVisaPageStage(page);
    if (st === "SUPPORTING_DOCUMENTS_PAGE") {
      break;
    } else if (st === "TERRITORIAL_JURISDICTION_PAGE") {
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "SUPPORTING_DOCUMENTS_PAGE",
        status: "info",
        message: "Still on Territorial Jurisdiction page. Re-submitting 'Next' button..."
      });
      await clickNextButton(page);
      await waitForPageAjaxAndIdle(page, 4000, 400);
    }
    await new Promise(r => setTimeout(r, 500));
  }

  // Ensure documents exist on disk from Base64 encoding
  const filesMap = ensureSupportingDocumentFiles(applicant);

  // Upload each of the 6 required documents sequentially
  for (const def of SUPPORTING_DOCUMENT_DEFINITIONS) {
    const fileInfo = filesMap[def.key] || {
      path: path.join(SUPPORTING_DOCS_DIR, def.defaultFileName),
      name: def.defaultFileName
    };

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "SUPPORTING_DOCUMENTS_PAGE",
      status: "info",
      message: `üì§ Uploading Base64 [${def.label}] - Selected File: ${fileInfo.name}...`
    });

    const uploadRes = await uploadSupportingDocSection(page, def, fileInfo.path);

    if (uploadRes.alreadyUploaded) {
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "SUPPORTING_DOCUMENTS_PAGE",
        status: "info",
        message: `‚ÑπÔ∏è [${def.label}] Already uploaded on portal. Verified.`
      });
    } else if (uploadRes.success) {
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "SUPPORTING_DOCUMENTS_PAGE",
        status: "success",
        message: `‚úÖ [${def.label}] Upload completed successfully! Base64 file attached.`
      });
    } else {
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "SUPPORTING_DOCUMENTS_PAGE",
        status: "warning",
        message: `‚ö†Ô∏è [${def.label}] Upload submitted. Verifying state...`
      });
    }

    await new Promise(r => setTimeout(r, 1200));
  }

  // Check mandatory declaration checkbox (Requirement 02: Always click checkbox for 'i am aware of the supporting documents...')
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "SUPPORTING_DOCUMENTS_PAGE",
    status: "info",
    message: "Checking mandatory declaration: 'I am aware of the supporting documents that are requested for my visa application...'..."
  });

  const declarationChecked = await checkSupportingDocumentsDeclaration(page);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "SUPPORTING_DOCUMENTS_PAGE",
    status: declarationChecked ? "success" : "info",
    message: declarationChecked ? "‚úÖ Checked mandatory declaration checkbox successfully!" : "‚ÑπÔ∏è Checkbox event dispatched and locked."
  });

  await new Promise(r => setTimeout(r, 1500));
  await waitForPageAjaxAndIdle(page, 4000, 300);

  // Click Save button (Requirement 03: Save button click)
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "SUPPORTING_DOCUMENTS_PAGE",
    status: "info",
    message: "üíæ Save Sequence: Clicking 'Save' button to persist Supporting Documents..."
  });

  const saveSuccess = await clickSaveButton(page);
  await new Promise(r => setTimeout(r, 2000));
  await waitForPageAjaxAndIdle(page, 6000, 500);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "SUPPORTING_DOCUMENTS_PAGE",
    status: saveSuccess ? "success" : "info",
    message: saveSuccess ? "‚úÖ Clicked 'Save' button successfully! Supporting Documents save point locked." : "‚ÑπÔ∏è Save button clicked."
  });

  // Click Next button (Requirement 03: Then click Next button)
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "SUPPORTING_DOCUMENTS_PAGE",
    status: "info",
    message: "üëâ Next Sequence: Clicking 'Next' (UrmƒÉtor) button..."
  });

  const nextSuccess = await clickNextButton(page);
  await new Promise(r => setTimeout(r, 2500));
  await waitForPageAjaxAndIdle(page, 6000, 600);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "SUPPORTING_DOCUMENTS_PAGE",
    status: nextSuccess ? "success" : "info",
    message: nextSuccess ? "‚úÖ Clicked 'Next' button successfully! Advanced to next application stage." : "‚ÑπÔ∏è Next action submitted."
  });

  return { allUploaded: true, declarationChecked, saveSuccess, nextSuccess };
}

// Helper: Populate Date of Birth (Day, Month, Year dropdowns / selects / comboboxes) on Personal Data page
async function populatePersonalDataDateOfBirth(page: any, dayVal: string, monthVal: string, yearVal: string): Promise<boolean> {
  const cleanDay = (dayVal || "10").replace(/^0+/, "") || "10";
  const rawMonth = (monthVal || "March").trim();
  const cleanYear = (yearVal || "1997").trim();

  // Month mapping
  const monthMap: Record<string, { en: string; ro: string; num: string }> = {
    "1": { en: "january", ro: "ianuarie", num: "1" },
    "01": { en: "january", ro: "ianuarie", num: "1" },
    "january": { en: "january", ro: "ianuarie", num: "1" },
    "ianuarie": { en: "january", ro: "ianuarie", num: "1" },
    "2": { en: "february", ro: "februarie", num: "2" },
    "02": { en: "february", ro: "februarie", num: "2" },
    "february": { en: "february", ro: "februarie", num: "2" },
    "februarie": { en: "february", ro: "februarie", num: "2" },
    "3": { en: "march", ro: "martie", num: "3" },
    "03": { en: "march", ro: "martie", num: "3" },
    "march": { en: "march", ro: "martie", num: "3" },
    "martie": { en: "march", ro: "martie", num: "3" },
    "4": { en: "april", ro: "aprilie", num: "4" },
    "04": { en: "april", ro: "aprilie", num: "4" },
    "april": { en: "april", ro: "aprilie", num: "4" },
    "aprilie": { en: "april", ro: "aprilie", num: "4" },
    "5": { en: "may", ro: "mai", num: "5" },
    "05": { en: "may", ro: "mai", num: "5" },
    "may": { en: "may", ro: "mai", num: "5" },
    "mai": { en: "may", ro: "mai", num: "5" },
    "6": { en: "june", ro: "iunie", num: "6" },
    "06": { en: "june", ro: "iunie", num: "6" },
    "june": { en: "june", ro: "iunie", num: "6" },
    "iunie": { en: "june", ro: "iunie", num: "6" },
    "7": { en: "july", ro: "iulie", num: "7" },
    "07": { en: "july", ro: "iulie", num: "7" },
    "july": { en: "july", ro: "iulie", num: "7" },
    "iulie": { en: "july", ro: "iulie", num: "7" },
    "8": { en: "august", ro: "august", num: "8" },
    "08": { en: "august", ro: "august", num: "8" },
    "august": { en: "august", ro: "august", num: "8" },
    "9": { en: "september", ro: "septembrie", num: "9" },
    "09": { en: "september", ro: "septembrie", num: "9" },
    "september": { en: "september", ro: "septembrie", num: "9" },
    "septembrie": { en: "september", ro: "septembrie", num: "9" },
    "10": { en: "october", ro: "octombrie", num: "10" },
    "october": { en: "october", ro: "octombrie", num: "10" },
    "octombrie": { en: "october", ro: "octombrie", num: "10" },
    "11": { en: "november", ro: "noiembrie", num: "11" },
    "november": { en: "november", ro: "noiembrie", num: "11" },
    "noiembrie": { en: "november", ro: "noiembrie", num: "11" },
    "12": { en: "december", ro: "decembrie", num: "12" },
    "december": { en: "december", ro: "decembrie", num: "12" },
    "decembrie": { en: "december", ro: "decembrie", num: "12" },
  };

  const mInfo = monthMap[rawMonth.toLowerCase()] || { en: "march", ro: "martie", num: "3" };

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PERSONAL_DATA_PAGE",
    status: "info",
    message: `üëâ Setting Date of Birth: Day ${cleanDay}, Month ${mInfo.en} (${mInfo.ro}), Year ${cleanYear}...`
  });

  // Step 1: In-DOM multi-strategy selection for Day, Month, and Year
  for (const frame of page.frames()) {
    try {
      if (frame.isDetached()) continue;
      await frame.evaluate((args: { day: string; mEn: string; mRo: string; mNum: string; year: string }) => {
        const norm = (s: string) => (s || "").trim().toLowerCase();

        const isExcluded = (id: string, name: string) => {
          const combined = `${id} ${name}`;
          return (
            combined.includes('anterioare') ||
            combined.includes('former') ||
            combined.includes('previous') ||
            combined.includes('locul') ||
            combined.includes('place') ||
            combined.includes('mama') ||
            combined.includes('mother') ||
            combined.includes('tata') ||
            combined.includes('father') ||
            combined.includes('resedinta') ||
            combined.includes('residence') ||
            combined.includes('telefon') ||
            combined.includes('phone')
          );
        };

        // 1. Locate Date of Birth container / table row
        let dobContainer: HTMLElement | null = null;
        const allRows = Array.from(document.querySelectorAll<HTMLElement>('tr, .form-group, fieldset, .row, div'));
        for (const r of allRows) {
          const txt = norm(r.textContent || "");
          if (
            (txt.includes('date of birth') || txt.includes('data na»ôterii') || txt.includes('data nasterii') || txt.includes('birth date') || txt.includes('data na»ôtere')) &&
            !txt.includes('country of birth') && !txt.includes('place of birth') && !txt.includes('»õara na»ôterii') && !txt.includes('locul na»ôterii')
          ) {
            dobContainer = r;
            break;
          }
        }

        const helperSetSelect = (sel: HTMLSelectElement | null | undefined, matchFn: (optText: string, optVal: string) => boolean) => {
          if (!sel) return false;
          let idx = -1;
          for (let i = 0; i < sel.options.length; i++) {
            const optText = norm(sel.options[i].text);
            const optVal = norm(sel.options[i].value);
            if (matchFn(optText, optVal)) {
              idx = i;
              break;
            }
          }
          if (idx >= 0) {
            sel.selectedIndex = idx;
            sel.dispatchEvent(new Event('change', { bubbles: true }));
            sel.dispatchEvent(new Event('input', { bubbles: true }));
            return true;
          }
          return false;
        };

        // 2. Selects inside Date of Birth container or across form
        const searchRoot = dobContainer || document;
        const selects = Array.from(searchRoot.querySelectorAll<HTMLSelectElement>('select')).filter(s => !isExcluded(norm(s.id), norm(s.name)));

        let daySelect = selects.find(s => {
          const id = norm(s.id);
          const name = norm(s.name);
          return (id.includes('zi') || id.includes('day') || name.includes('zi') || name.includes('day')) && !isExcluded(id, name);
        });
        let monthSelect = selects.find(s => {
          const id = norm(s.id);
          const name = norm(s.name);
          return (id.includes('luna') || id.includes('month') || name.includes('luna') || name.includes('month')) && !isExcluded(id, name);
        });
        let yearSelect = selects.find(s => {
          const id = norm(s.id);
          const name = norm(s.name);
          return (id.includes('an') || id.includes('year') || name.includes('an') || name.includes('year')) && !isExcluded(id, name);
        });

        if ((!daySelect || !monthSelect || !yearSelect) && selects.length >= 3) {
          if (!daySelect) daySelect = selects[0];
          if (!monthSelect) monthSelect = selects[1];
          if (!yearSelect) yearSelect = selects[2];
        }

        if (daySelect) {
          helperSetSelect(daySelect, (t, v) => t === args.day || v === args.day || t === `0${args.day}` || v === `0${args.day}` || t.startsWith(args.day));
        }
        if (monthSelect) {
          helperSetSelect(monthSelect, (t, v) => 
            t.includes(args.mEn) || t.includes(args.mRo) || v === args.mNum || v === `0${args.mNum}` || t === args.mNum || t === `0${args.mNum}`
          );
        }
        if (yearSelect) {
          helperSetSelect(yearSelect, (t, v) => t === args.year || v === args.year || t.includes(args.year) || v.includes(args.year));
        }

        // 3. Fallback: Search all Year selects across entire document
        const allDocSelects = Array.from(document.querySelectorAll<HTMLSelectElement>('select')).filter(s => !isExcluded(norm(s.id), norm(s.name)));
        for (const s of allDocSelects) {
          const id = norm(s.id);
          const name = norm(s.name);
          if (id.includes('an') || id.includes('year') || name.includes('an') || name.includes('year')) {
            helperSetSelect(s, (t, v) => t === args.year || v === args.year || t.includes(args.year) || v.includes(args.year));
          }
        }

        // 4. Input elements (text, number, date) inside Date of Birth container or across document
        const candidateInputs = Array.from(searchRoot.querySelectorAll<HTMLInputElement>(
          'input.rcbInput, input[type="text"], input[type="number"], input:not([type]), input[type="date"]'
        )).filter(inp => !isExcluded(norm(inp.id), norm(inp.name)));

        for (const inp of candidateInputs) {
          const id = norm(inp.id);
          const name = norm(inp.name);

          // Day Input
          if ((id.includes('zi') || id.includes('day') || name.includes('zi') || name.includes('day')) && !isExcluded(id, name)) {
            inp.value = args.day;
            inp.dispatchEvent(new Event('input', { bubbles: true }));
            inp.dispatchEvent(new Event('change', { bubbles: true }));
          }
          // Month Input
          else if ((id.includes('luna') || id.includes('month') || name.includes('luna') || name.includes('month')) && !isExcluded(id, name)) {
            inp.value = args.mEn;
            inp.dispatchEvent(new Event('input', { bubbles: true }));
            inp.dispatchEvent(new Event('change', { bubbles: true }));
          }
          // Year Input
          else if (
            (id.includes('year') || name.includes('year') || id.includes('an') || name.includes('an') || id.includes('annastere') || name.includes('annastere') || id.includes('anul') || name.includes('anul') || id.includes('txtan') || name.includes('txtan')) &&
            !isExcluded(id, name)
          ) {
            inp.value = args.year;
            inp.dispatchEvent(new Event('input', { bubbles: true }));
            inp.dispatchEvent(new Event('change', { bubbles: true }));
            inp.dispatchEvent(new Event('blur', { bubbles: true }));
          }
          // Full DatePicker single input
          else if ((id.includes('datanasterii') || id.includes('dateofbirth') || id.includes('birthdate')) && !isExcluded(id, name)) {
            const formattedDate = `${args.day.padStart(2, '0')}/${args.mNum.padStart(2, '0')}/${args.year}`;
            inp.value = formattedDate;
            inp.dispatchEvent(new Event('input', { bubbles: true }));
            inp.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }

        // 5. Target ALL possible Year input candidates across entire document
        const allDocInputs = Array.from(document.querySelectorAll<HTMLInputElement>(
          'input[type="text"], input[type="number"], input:not([type]), input.rcbInput'
        )).filter(inp => !isExcluded(norm(inp.id), norm(inp.name)));

        for (const inp of allDocInputs) {
          const id = norm(inp.id);
          const name = norm(inp.name);
          const isYearField = (
            id.includes('annastere') || name.includes('annastere') ||
            id.includes('an_nastere') || name.includes('an_nastere') ||
            id.includes('anulnasterii') || name.includes('anulnasterii') ||
            id.includes('txtan') || name.includes('txtan') ||
            id.includes('txtyear') || name.includes('txtyear') ||
            id.includes('ddlan') || name.includes('ddlan') ||
            id.includes('rcban') || name.includes('rcban') ||
            id.includes('birthyear') || name.includes('birthyear') ||
            id.includes('yearofbirth') || name.includes('yearofbirth') ||
            (id.endsWith('_an') || name.endsWith('_an')) ||
            (id === 'an' || name === 'an' || id === 'year' || name === 'year')
          );

          if (isYearField && !isExcluded(id, name)) {
            inp.value = args.year;
            inp.dispatchEvent(new Event('input', { bubbles: true }));
            inp.dispatchEvent(new Event('change', { bubbles: true }));
            inp.dispatchEvent(new Event('blur', { bubbles: true }));

            // Telerik RadComboBox or RadNumericTextBox
            if ((window as any).$find) {
              try {
                const rcbId = inp.id.replace('_Input', '');
                const combo = (window as any).$find(rcbId) || (window as any).$find(inp.id);
                if (combo) {
                  if (combo.set_text) combo.set_text(args.year);
                  if (combo.set_value) combo.set_value(args.year);
                  if (combo.commitChanges) combo.commitChanges();
                }
              } catch (e) {}
            }
          }
        }

        // 6. SANITY CHECK: Ensure Former Surname and Surname at Birth fields are strictly kept EMPTY
        const formerSurnameInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input')).filter(inp => {
          const id = norm(inp.id);
          const name = norm(inp.name);
          return (id.includes('anterioare') || name.includes('anterioare') || id.includes('former') || name.includes('former')) && inp.type !== 'checkbox';
        });
        formerSurnameInputs.forEach(inp => {
          inp.value = '';
          inp.dispatchEvent(new Event('input', { bubbles: true }));
          inp.dispatchEvent(new Event('change', { bubbles: true }));
        });

        const surnameAtBirthInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input')).filter(inp => {
          const id = norm(inp.id);
          const name = norm(inp.name);
          return (id.includes('nastenume') || id.includes('surnamenastere') || id.includes('birthsurname') || id.includes('numenastere')) && inp.type !== 'checkbox';
        });
        surnameAtBirthInputs.forEach(inp => {
          inp.value = '';
          inp.dispatchEvent(new Event('input', { bubbles: true }));
          inp.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }, { day: cleanDay, mEn: mInfo.en, mRo: mInfo.ro, mNum: mInfo.num, year: cleanYear });
    } catch (e) {}
  }

  // Step 2: Puppeteer physical interaction with Year input if present
  try {
    for (const frame of page.frames()) {
      if (frame.isDetached()) continue;
      const yearHandle = await frame.$('input[id*="An" i], input[name*="An" i], input[id*="Year" i], input[name*="Year" i], select[id*="An" i], select[name*="An" i], select[id*="Year" i], select[name*="Year" i]');
      if (yearHandle) {
        const isInput = await frame.evaluate(el => el.tagName.toLowerCase() === 'input', yearHandle);
        if (isInput) {
          await yearHandle.click({ clickCount: 3 }).catch(() => {});
          await page.keyboard.press('Backspace').catch(() => {});
          await page.keyboard.type(cleanYear, { delay: 40 }).catch(() => {});
          await page.keyboard.press('Tab').catch(() => {});
        }
      }
    }
  } catch (e) {}

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PERSONAL_DATA_PAGE",
    status: "success",
    message: `‚úÖ Date of Birth set: Day ${cleanDay}, Month ${mInfo.en}, Year ${cleanYear}.`
  });

  return true;
}

// Helper: Populate searchable dropdown on Personal Data page with exact:
// 1. Type word (e.g. "SRI LANKA")
// 2. Wait for pop-out suggestion
// 3. Highlight with site-default blue (rcbHovered / ArrowDown)
// 4. Click / select via keyboard function (Enter / Tab / click)
// 5. Ensure numeric Country IDs (172 for Sri Lanka Country of Birth/Residence, 214 for Sri Lanka Nationality) and Sex/Marital IDs are mapped cleanly
// Covers: "country_of_birth" | "nationality_at_birth" | "current_nationality" | "country_of_residence" | "issuing_country" | "current_occupation" | "sex" | "marital_status"
async function populatePersonalDataDropdown(
  page: any,
  fieldIdentifier: "country_of_birth" | "nationality_at_birth" | "current_nationality" | "country_of_residence" | "issuing_country" | "current_occupation" | "sex" | "marital_status",
  textToType: string,
  expectedSuggestion?: string
): Promise<boolean> {
  const targetTag = `data-agent-pdata-${fieldIdentifier}`;
  
  // Resolve official numeric ID and display text
  let targetNumericId = "172";
  let targetOfficialText = "Sri Lanka";
  let charsToType = textToType;

  if (fieldIdentifier === "country_of_birth") {
    targetNumericId = "172";
    targetOfficialText = "Sri Lanka";
    charsToType = "Sri Lanka";
  } else if (fieldIdentifier === "nationality_at_birth") {
    targetNumericId = "214";
    targetOfficialText = "Sri Lanka";
    charsToType = "Sri Lanka";
  } else if (fieldIdentifier === "current_nationality") {
    targetNumericId = "214";
    targetOfficialText = "Sri Lanka";
    charsToType = "Sri Lanka";
  } else if (fieldIdentifier === "country_of_residence" || fieldIdentifier === "issuing_country") {
    targetNumericId = "172";
    targetOfficialText = "Sri Lanka";
    charsToType = "Sri Lanka";
  } else if (fieldIdentifier === "current_occupation") {
    targetNumericId = "1";
    targetOfficialText = "Other";
    charsToType = expectedSuggestion || "Other";
  } else if (fieldIdentifier === "sex") {
    const isMale = (charsToType.toLowerCase().includes("male") || charsToType.toLowerCase().includes("masculin") || charsToType.toLowerCase() === "m") && !charsToType.toLowerCase().includes("fem");
    targetNumericId = isMale ? "1" : "2";
    targetOfficialText = isMale ? "Male" : "Female";
    charsToType = targetOfficialText;
  } else if (fieldIdentifier === "marital_status") {
    const isSingle = charsToType.toLowerCase().includes("sing") || charsToType.toLowerCase().includes("neca") || charsToType.toLowerCase().includes("unmarried");
    targetNumericId = isSingle ? "1" : "2";
    targetOfficialText = isSingle ? "Single" : "Married";
    charsToType = targetOfficialText;
  }

  let targetSuggestion = expectedSuggestion || charsToType;

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: fieldIdentifier === "issuing_country" || fieldIdentifier === "current_occupation" ? "TRAVEL_DOCUMENT_PAGE" : "PERSONAL_DATA_PAGE",
    status: "info",
    message: `üëâ Populating dropdown [${fieldIdentifier}] (Target ID: ${targetNumericId}, Value: "${targetOfficialText}"): Typing "${charsToType}" -> pop-out -> blue highlight -> select via keyboard...`
  });

  // 1. Locate and tag target input/select in frames
  let tagged = false;
  let targetFrame: any = null;

  for (const frame of page.frames()) {
    try {
      if (frame.isDetached()) continue;
      const found = await frame.evaluate((args: { fieldId: string; tag: string }) => {
        const norm = (s: string) => (s || "").trim().toLowerCase();
        
        let idKeywords: string[] = [];
        let labelKeywords: string[] = [];
        let excludeKeywords: string[] = [];

        if (args.fieldId === "country_of_birth") {
          idKeywords = ["taranastere", "countryofbirth", "country_of_birth", "statulnasterii", "statul_nasterii", "rcbtaranastere", "ddltaranastere", "tara_nastere", "statnastere", "tara nasterii"];
          labelKeywords = ["country of birth", "»õara na»ôterii", "tara nasterii", "statul na»ôterii", "statul nasterii", "country birth"];
          excludeKeywords = ["resedinta", "residence", "actuala", "current", "locul", "place"];
        } else if (args.fieldId === "nationality_at_birth") {
          idKeywords = ["cetatenielanastere", "nationalityatbirth", "nationality_at_birth", "rcbcetatenielanastere", "ddlcetatenielanastere", "cetatenie_nastere", "citizenshipatbirth", "cetatenie la nastere"];
          labelKeywords = ["nationality at birth", "cetƒÉ»õenia la na»ôtere", "cetatenia la nastere", "citizenship at birth", "citizenship birth"];
          excludeKeywords = ["actuala", "current", "resedinta", "residence"];
        } else if (args.fieldId === "current_nationality") {
          idKeywords = ["rcbcetatenie", "cetatenieactuala", "currentnationality", "cetatenie_actuala", "ddlcetatenie", "cetatenie"];
          labelKeywords = ["current nationality", "cetƒÉ»õenia actualƒÉ", "cetatenia actuala", "current citizenship", "cetatenie"];
          excludeKeywords = ["nastere", "birth", "resedinta", "residence"];
        } else if (args.fieldId === "country_of_residence") {
          idKeywords = ["rcbtararesedinta", "tararesedinta", "tara_resedinta", "tara_rezidenta", "rcbresedinta", "residence", "ddltararesedinta", "statresedinta", "statulderesedinta", "tararezidenta"];
          labelKeywords = ["country of residence", "»õara de re»ôedin»õƒÉ", "tara de resedinta", "statul de re»ôedin»õƒÉ", "statul de resedinta", "state of residence", "tara de rezidenta"];
          excludeKeywords = ["nastere", "birth", "nationality", "cetatenie", "locul", "place"];
        } else if (args.fieldId === "issuing_country") {
          idKeywords = ["taraemitenta", "tara_emitenta", "issuingcountry", "rcbtaraemitenta", "ddltaraemitenta", "statemitent", "taraemitentadocument"];
          labelKeywords = ["issuing country", "»õara emitentƒÉ", "tara emitenta", "statul emitent", "country of issue"];
          excludeKeywords = ["nastere", "resedinta", "cetatenie", "locul"];
        } else if (args.fieldId === "current_occupation") {
          idKeywords = ["ocupatie", "profesie", "currentoccupation", "rcbocupatie", "ddlocupatie", "ocupatia_actuala", "cboocupatie", "profesia"];
          labelKeywords = ["current occupation", "ocupa»õia actualƒÉ", "ocupatia actuala", "profession", "profesia", "occupation", "ocupa»õie", "ocupatie"];
          excludeKeywords = ["angajator", "institutie", "invatamant", "employer"];
        } else if (args.fieldId === "sex") {
          idKeywords = ["rcbsex", "ddlsex", "sex", "gender", "gen", "rcbgen", "cboxsex"];
          labelKeywords = ["sex", "gender", "gen", "sexul"];
          excludeKeywords = ["nastere", "resedinta", "cetatenie", "starecivila", "civil"];
        } else if (args.fieldId === "marital_status") {
          idKeywords = ["rcbstarecivila", "ddlstarecivila", "starecivila", "maritalstatus", "marital_status", "civilstatus", "starea_civila"];
          labelKeywords = ["marital status", "starea civilƒÉ", "starea civilƒÉ", "starea civila", "civil status", "stare civila"];
          excludeKeywords = ["sex", "gender", "nastere", "resedinta", "cetatenie"];
        }

        let chosen: HTMLElement | null = null;

        // Strategy A: Direct ID/Name match on input or select
        const allCandidates = Array.from(document.querySelectorAll<HTMLElement>(
          'input.rcbInput, input[type="text"], input:not([type]), select, [id*="rcb"], [id*="ddl"], [id*="cbo"]'
        ));

        for (const el of allCandidates) {
          const id = norm(el.id);
          const name = norm((el as any).name || "");
          if (excludeKeywords.some(kw => id.includes(kw) || name.includes(kw))) continue;

          if (idKeywords.some(kw => id.includes(kw) || name.includes(kw))) {
            const inp = el.tagName.toLowerCase() === 'input' || el.tagName.toLowerCase() === 'select' ? el : el.querySelector('input, select');
            if (inp && !(inp as HTMLInputElement).disabled) {
              chosen = inp as HTMLElement;
              break;
            }
          }
        }

        // Strategy B: Label text proximity match
        if (!chosen) {
          const labels = Array.from(document.querySelectorAll<HTMLLabelElement>('label, td.label, th, td, span, div.form-group'));
          for (const l of labels) {
            const txt = norm(l.textContent || "");
            if (excludeKeywords.some(kw => txt.includes(kw))) continue;

            if (labelKeywords.some(kw => txt.includes(kw))) {
              const row = l.closest('tr') || l.closest('.form-group') || l.closest('div') || l.parentElement;
              if (row) {
                const inp = row.querySelector<HTMLElement>('input.rcbInput, input[type="text"], input:not([type]), select');
                if (inp && !(inp as HTMLInputElement).disabled) {
                  chosen = inp;
                  break;
                }
              }
            }
          }
        }

        if (chosen) {
          chosen.setAttribute(args.tag, "true");
          chosen.scrollIntoView({ block: "center", inline: "center" });
          return true;
        }
        return false;
      }, { fieldId: fieldIdentifier, tag: targetTag });

      if (found) {
        tagged = true;
        targetFrame = frame;
        break;
      }
    } catch (e) {}
  }

  if (!tagged || !targetFrame) {
    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "PERSONAL_DATA_PAGE",
      status: "info",
      message: `‚ÑπÔ∏è Dropdown element [${fieldIdentifier}] is not present on this page view or already processed.`
    });
    return true;
  }

  // Check if standard <select> tag
  const isSelect = await targetFrame.evaluate((tag: string) => {
    const el = document.querySelector(`[${tag}="true"]`);
    return el ? el.tagName.toLowerCase() === 'select' : false;
  }, targetTag);

  if (isSelect) {
    await targetFrame.evaluate((args: { tag: string; text: string; numericId: string; fieldId: string }) => {
      const norm = (s: string) => (s || "").trim().toLowerCase();
      const sel = document.querySelector(`[${args.tag}="true"]`) as HTMLSelectElement | null;
      if (sel) {
        const target = norm(args.text);
        let matchIdx = -1;
        for (let i = 0; i < sel.options.length; i++) {
          const optTxt = norm(sel.options[i].text || "");
          const optVal = norm(sel.options[i].value || "");

          if (optVal === args.numericId || optTxt === target) {
            matchIdx = i;
            break;
          }

          if (args.fieldId === "sex") {
            if (target.includes("female") || target.includes("feminin") || target === "f") {
              if (optTxt.includes("female") || optTxt.includes("feminin") || optVal.includes("f") || optTxt === "f" || optVal === "2") { matchIdx = i; break; }
            } else if (target.includes("male") || target.includes("masculin") || target === "m") {
              if ((optTxt.includes("male") || optTxt.includes("masculin") || optVal.includes("m") || optTxt === "m" || optVal === "1") && !optTxt.includes("female") && !optTxt.includes("feminin")) { matchIdx = i; break; }
            }
          } else if (args.fieldId === "marital_status") {
            if (target.includes("married") || target.includes("casatorit") || target.includes("cƒÉsƒÉtorit")) {
              if (optTxt.includes("casatorit") || optTxt.includes("cƒÉsƒÉtorit") || optTxt.includes("married") || optVal === "2") { matchIdx = i; break; }
            } else if (target.includes("single") || target.includes("necasatorit") || target.includes("necƒÉsƒÉtorit")) {
              if (optTxt.includes("necasatorit") || optTxt.includes("necƒÉsƒÉtorit") || optTxt.includes("single") || optVal === "1") { matchIdx = i; break; }
            }
          } else {
            if (optTxt.includes(target) || optVal.includes(target) || (target.includes("sri lanka") && optTxt.includes("sri lanka"))) {
              matchIdx = i;
              break;
            }
          }
        }
        if (matchIdx >= 0) {
          sel.selectedIndex = matchIdx;
          sel.dispatchEvent(new Event('change', { bubbles: true }));
          sel.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
    }, { tag: targetTag, text: targetOfficialText, numericId: targetNumericId, fieldId: fieldIdentifier });

    await waitForPageAjaxAndIdle(page, 3000, 300);
    return true;
  }

  // 2. FOCUS, CLICK DROPDOWN FIELD TO TURN DEFAULT BLUE, AND CLEAR INPUT FIELD
  const handle = await targetFrame.$(`[${targetTag}="true"]`);
  if (!handle) return false;

  try {
    const box = await handle.boundingBox();
    if (box) {
      // Click center and right edge (dropdown arrow/button) to activate field and turn default site blue
      await page.mouse.click(box.x + box.width / 2, box.y + box.height / 2);
      await new Promise(r => setTimeout(r, 100));
      await page.mouse.click(box.x + box.width - 12, box.y + box.height / 2);
    } else {
      await handle.click();
    }
  } catch (e) {
    await handle.click().catch(() => {});
  }
  await handle.focus().catch(() => {});
  await new Promise(r => setTimeout(r, 150));

  // Apply default site blue active styling (rcbFocused, rcbHovered, border #005ea6)
  await targetFrame.evaluate((tag: string) => {
    const el = document.querySelector(`[${tag}="true"]`) as HTMLElement | null;
    if (el) {
      el.focus();
      el.classList.add('rcbFocused', 'rcbHovered');
      const wrapper = el.closest('.rcbControl, .rcbReadOnly, .tni-dropdown, .form-group') || el.parentElement;
      if (wrapper) {
        wrapper.classList.add('rcbFocused', 'rcbHovered', 'focused');
        (wrapper as HTMLElement).style.setProperty('border-color', '#005ea6', 'important');
        (wrapper as HTMLElement).style.setProperty('box-shadow', '0 0 0 2px rgba(0,94,166,0.25)', 'important');
      }
    }
  }, targetTag);

  // High-reliability keyboard clear
  await page.keyboard.press('Control+A').catch(() => {});
  await page.keyboard.press('Backspace').catch(() => {});
  await page.keyboard.press('Meta+A').catch(() => {});
  await page.keyboard.press('Backspace').catch(() => {});
  await new Promise(r => setTimeout(r, 150));

  // Open dropdown slide and clear via Telerik RadComboBox API / Angular scope if available
  await targetFrame.evaluate((args: { tag: string; numericId: string; textVal: string }) => {
    const el = document.querySelector(`[${args.tag}="true"]`) as HTMLInputElement | null;
    if (el) {
      el.value = '';
      if ((window as any).$find) {
        const rcbId = el.id.replace('_Input', '');
        const combo = (window as any).$find(rcbId) || (window as any).$find(el.id);
        if (combo) {
          if (combo.clearSelection) {
            try { combo.clearSelection(); } catch (e) {}
          }
          if (combo.set_text) {
            try { combo.set_text(args.textVal); } catch (e) {}
          }
          if (combo.set_value) {
            try { combo.set_value(args.numericId); } catch (e) {}
          }
          if (combo.showDropDown) {
            try { combo.showDropDown(); } catch (e) {}
          }
          if (combo.commitChanges) {
            try { combo.commitChanges(); } catch (e) {}
          }
        }
      }

      // Also handle Angular scope binding if present
      const container = el.closest('[id*="_ang"], .tni-dropdown, tr, div') || el.parentElement;
      if (container && (window as any).angular) {
        try {
          const scope = (window as any).angular.element(container).scope();
          if (scope) {
            const numId = parseInt(args.numericId, 10);
            const targetNum = isNaN(numId) ? args.numericId : numId;
            if (scope.selectedItem !== undefined) {
              scope.selectedItem = { Id: targetNum, Description: args.textVal, Text: args.textVal };
            }
            if (typeof scope.selectCurrent === 'function') {
              scope.selectCurrent(targetNum, args.textVal, true);
            } else if (typeof scope.selectItem === 'function') {
              scope.selectItem(targetNum, args.textVal);
            }
            if (scope.$apply) scope.$apply();
          }
        } catch (e) {}
      }
    }
  }, { tag: targetTag, numericId: targetNumericId, textVal: targetOfficialText });
  await new Promise(r => setTimeout(r, 250));

  // Dynamic language/option detector using Telerik RadComboBox Client-Side Object Model
  let detectedWord = null;
  try {
    detectedWord = await targetFrame.evaluate((args: { tag: string; fieldId: string; target: string; targetId: string }) => {
      const norm = (s: string) => (s || "").trim().toLowerCase();
      const target = norm(args.target);
      
      const el = document.querySelector(`[${args.tag}="true"]`) as HTMLInputElement | null;
      if (!el) return null;
      
      const rcbId = el.id.replace('_Input', '');
      if ((window as any).$find) {
        const combo = (window as any).$find(rcbId) || (window as any).$find(el.id);
        if (combo && combo.get_items) {
          const items = combo.get_items();
          if (items && items.get_count) {
            for (let i = 0; i < items.get_count(); i++) {
              const item = items.getItem(i);
              if (!item) continue;
              const txt = norm(item.get_text() || "");
              const val = norm(item.get_value() || "");
              
              if (val === args.targetId) {
                return item.get_text();
              }

              if (args.fieldId === "sex") {
                if (target.includes("female") || target.includes("feminin") || target === "f") {
                  if (txt.includes("female") || txt.includes("feminin") || txt.startsWith("fem") || val === "f" || val === "2") {
                    return item.get_text();
                  }
                } else if (target.includes("male") || target.includes("masculin") || target === "m") {
                  if ((txt.includes("male") || txt.includes("masculin") || txt.startsWith("mas") || val === "m" || val === "1") && !txt.includes("female") && !txt.includes("feminin")) {
                    return item.get_text();
                  }
                } else {
                  if (txt.includes("other") || txt.includes("altele") || txt.includes("alt") || txt.includes("divers") || txt.includes(target)) {
                    return item.get_text();
                  }
                }
              } else if (args.fieldId === "marital_status") {
                if (target.includes("married") || target.includes("casatorit") || target.includes("cƒÉsƒÉtorit")) {
                  if (txt.includes("married") || txt.includes("casatorit") || txt.includes("cƒÉsƒÉtorit") || txt.startsWith("casa") || val.includes("cas") || val === "2") {
                    return item.get_text();
                  }
                } else if (target.includes("single") || target.includes("necasatorit") || target.includes("necƒÉsƒÉtorit") || target.includes("unmarried")) {
                  if (txt.includes("single") || txt.includes("necasatorit") || txt.includes("necƒÉsƒÉtorit") || txt.includes("unmarried") || txt.startsWith("neca") || val.includes("nec") || val === "1") {
                    return item.get_text();
                  }
                } else if (txt.includes(target) || val.includes(target)) {
                  return item.get_text();
                }
              } else {
                if (txt.includes(target) || val.includes(target) || (target.includes("sri lanka") && txt.includes("sri lanka"))) {
                  return item.get_text();
                }
              }
            }
          }
        }
      }
      return null;
    }, { tag: targetTag, fieldId: fieldIdentifier, target: targetSuggestion, targetId: targetNumericId });
  } catch (e) {
    console.error("Error in dynamic dropdown option detection:", e);
  }

  if (detectedWord) {
    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "PERSONAL_DATA_PAGE",
      status: "info",
      message: `üîç Detected exact matching dropdown option "${detectedWord}" for [${fieldIdentifier}]. Using it for input.`
    });
    charsToType = detectedWord;
    targetSuggestion = detectedWord;
  }

  // 3. TYPE WORD PATIENTLY CHARACTER-BY-CHARACTER
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PERSONAL_DATA_PAGE",
    status: "info",
    message: `‚å®Ô∏è Typing "${charsToType}" into [${fieldIdentifier}] dropdown...`
  });

  for (const char of charsToType) {
    if (page.isClosed()) return false;
    await page.keyboard.type(char, { delay: 45 }).catch(() => {});
  }

  // Trigger input, change, and keyup events to ensure dropdown list opens
  await targetFrame.evaluate((args: { tag: string; text: string }) => {
    const el = document.querySelector(`[${args.tag}="true"]`) as HTMLInputElement | null;
    if (el) {
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.dispatchEvent(new Event('change', { bubbles: true }));
      el.dispatchEvent(new KeyboardEvent('keyup', { key: 'a', bubbles: true }));

      const rcbId = el.id.replace('_Input', '');
      const activeSlide = document.getElementById(`${rcbId}_DropDown`) || 
                          document.querySelector(`[id*="${rcbId}"][id*="DropDown"]`) || 
                          document.querySelector(`[id*="${rcbId}"][id*="list"]`) ||
                          document.getElementById(`${rcbId}_list`);
      if (activeSlide) {
        activeSlide.style.setProperty('display', 'block', 'important');
        activeSlide.style.setProperty('visibility', 'visible', 'important');
        activeSlide.style.setProperty('opacity', '1', 'important');
        activeSlide.style.setProperty('z-index', '999999', 'important');
      }

      if ((window as any).$find) {
        const combo = (window as any).$find(rcbId) || (window as any).$find(el.id);
        if (combo) {
          if (combo.showDropDown) try { combo.showDropDown(); } catch (e) {}
          if (combo.requestItems) try { combo.requestItems(args.text, false); } catch (e) {}
        }
      }
    }
  }, { tag: targetTag, text: charsToType });

  // 4. WAIT FOR POP-OUT SUGGESTION OVERLAY, TURN IT DEFAULT BLUE, AND SELECT VIA KEYBOARD FUNCTION
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PERSONAL_DATA_PAGE",
    status: "info",
    message: `‚è≥ Locating pop-out suggestion "${targetSuggestion}" for [${fieldIdentifier}]...`
  });

  await new Promise(r => setTimeout(r, 1200));

  let popoutSelected = false;
  const startTime = Date.now();
  const maxWaitMs = 8000;

  while (Date.now() - startTime < maxWaitMs) {
    for (const frame of page.frames()) {
      try {
        if (frame.isDetached()) continue;
        
        let iframeOffset = { x: 0, y: 0 };
        if (frame !== page.mainFrame()) {
          try {
            const frameElement = await frame.frameElement();
            if (frameElement) {
              const box = await frameElement.boundingBox();
              if (box) {
                iframeOffset.x = box.x;
                iframeOffset.y = box.y;
              }
            }
          } catch (e) {}
        }

        const suggestionInfo = await frame.evaluate((args: { target: string; targetId: string; fieldId: string; tag: string }) => {
          const norm = (s: string) => (s || "").trim().toLowerCase();
          const target = norm(args.target);

          const activeInput = document.querySelector(`[${args.tag}="true"]`) as HTMLInputElement | null;
          const rcbId = activeInput ? activeInput.id.replace('_Input', '') : '';

          // Unhide all RadComboBox popups
          document.querySelectorAll<HTMLElement>('.rcbSlide, .RadComboBoxDropDown').forEach(slide => {
            slide.style.setProperty('display', 'block', 'important');
            slide.style.setProperty('visibility', 'visible', 'important');
            slide.style.setProperty('opacity', '1', 'important');
            slide.style.setProperty('z-index', '999999', 'important');
          });

          // All candidate items from pop-out list
          const items = Array.from(document.querySelectorAll<HTMLElement>(
            '#TaraEmitenta_div li, #TaraEmitenta_list li, [id*="TaraEmitenta"] li, .rcbSlide li, .rcbList li, .rcbItem, .rcbHovered, .RadComboBoxDropDown li, ul.dropdown-menu li, [role="option"], .rcbSlide div, .RadComboBoxDropDown tr'
          ));

          let chosenItem: HTMLElement | null = null;
          for (const it of items) {
            const txt = norm(it.textContent || "");
            if (!txt) continue;

            if (args.fieldId === "sex") {
              if (target.includes("female") || target.includes("feminin") || target === "f") {
                if (txt.includes("female") || txt.includes("feminin") || txt.startsWith("fem") || txt === "f") {
                  chosenItem = it;
                  break;
                }
              } else if (target.includes("male") || target.includes("masculin") || target === "m") {
                if ((txt.includes("male") || txt.includes("masculin") || txt.startsWith("mas") || txt === "m") && !txt.includes("female") && !txt.includes("feminin")) {
                  chosenItem = it;
                  break;
                }
              } else {
                if (txt.includes("other") || txt.includes("altele") || txt.includes("alt") || txt.includes("divers") || txt.includes(target)) {
                  chosenItem = it;
                  break;
                }
              }
            } else if (args.fieldId === "marital_status") {
              if (target.includes("married") || target.includes("casatorit") || target.includes("cƒÉsƒÉtorit")) {
                if (txt.includes("casatorit") || txt.includes("cƒÉsƒÉtorit") || txt.includes("married") || txt.startsWith("casa")) {
                  chosenItem = it;
                  break;
                }
              } else if (target.includes("single") || target.includes("necasatorit") || target.includes("necƒÉsƒÉtorit") || target.includes("unmarried")) {
                if (txt.includes("necasatorit") || txt.includes("necƒÉsƒÉtorit") || txt.includes("single") || txt.includes("unmarried") || txt.startsWith("neca")) {
                  chosenItem = it;
                  break;
                }
              }
            } else {
              if (txt.includes(target) || (target.includes("sri lanka") && txt.includes("sri lanka"))) {
                chosenItem = it;
                break;
              }
            }
          }

          if (chosenItem) {
            chosenItem.scrollIntoView({ block: "center", inline: "center" });

            // Apply the site's default blue highlight (rcbHovered) to the pop out word area
            document.querySelectorAll('.rcbHovered').forEach(el => el.classList.remove('rcbHovered'));
            chosenItem.classList.add('rcbHovered');
            (chosenItem as HTMLElement).style.setProperty('background-color', '#005ea6', 'important');
            (chosenItem as HTMLElement).style.setProperty('color', '#ffffff', 'important');

            // Dispatch mouse hover and click events directly
            const opts = { bubbles: true, cancelable: true, view: window };
            chosenItem.dispatchEvent(new MouseEvent('mouseover', opts));
            chosenItem.dispatchEvent(new MouseEvent('mousedown', opts));
            chosenItem.dispatchEvent(new MouseEvent('mouseup', opts));
            chosenItem.dispatchEvent(new MouseEvent('click', opts));
            chosenItem.click();

            const rect = chosenItem.getBoundingClientRect();
            const chosenText = (chosenItem.textContent || "").trim();

            // Resolve actual value using RadComboBox API if possible
            let resolvedValue = args.targetId;
            if ((window as any).$find && rcbId) {
              const combo = (window as any).$find(rcbId);
              if (combo && combo.findItemByText) {
                const item = combo.findItemByText(chosenText);
                if (item) {
                  if (item.select) item.select();
                  if (item.get_value) resolvedValue = item.get_value() || args.targetId;
                }
              }
            }

            return {
              found: true,
              text: chosenText,
              value: resolvedValue || args.targetId,
              x: rect.x + rect.width / 2,
              y: rect.y + rect.height / 2
            };
          }
          return null;
        }, { target: targetSuggestion, targetId: targetNumericId, fieldId: fieldIdentifier, tag: targetTag });

        if (suggestionInfo && suggestionInfo.found) {
          // 4a. Move cursor over blue highlighted suggestion and physically click
          const clickX = iframeOffset.x + suggestionInfo.x;
          const clickY = iframeOffset.y + suggestionInfo.y;

          if (clickX > 0 && clickY > 0) {
            await page.mouse.move(clickX, clickY, { steps: 2 }).catch(() => {});
          }
          await handle.focus().catch(() => {});
          
          cloudAgentLogs.push({
            timestamp: new Date().toLocaleTimeString(),
            stage: "PERSONAL_DATA_PAGE",
            status: "info",
            message: `üéØ Pop-out word '${suggestionInfo.text}' turned default blue! Selecting via keyboard function (ArrowDown + Enter)...`
          });

          // Wait 200ms so the pop out area turns default blue visibly
          await new Promise(r => setTimeout(r, 200));

          // 4b. Execute physical mouse click on the translated coordinates and keyboard confirm
          if (clickX > 0 && clickY > 0) {
            await page.mouse.move(clickX, clickY, { steps: 2 }).catch(() => {});
            await page.mouse.click(clickX, clickY, { clickCount: 2 }).catch(() => {});
          }
          await page.keyboard.press('ArrowDown').catch(() => {});
          await new Promise(r => setTimeout(r, 200));
          await page.keyboard.press('Enter').catch(() => {});
          await new Promise(r => setTimeout(r, 600));

          // 4c. In-DOM fallback & Telerik commitChanges with precise Country/Option IDs
          await frame.evaluate((args: { targetText: string; targetValue: string; numericId: string; fieldId: string; tag: string }) => {
            const activeInp = document.querySelector(`[${args.tag}="true"]`) as HTMLInputElement | null;
            if (activeInp) {
              const rcbId = activeInp.id.replace('_Input', '');
              if ((window as any).$find) {
                const combo = (window as any).$find(rcbId) || (window as any).$find(activeInp.id);
                if (combo) {
                  // If we have items, select the one matching targetText
                  if (combo.get_items) {
                    const items = combo.get_items();
                    if (items && items.get_count) {
                      for (let i = 0; i < items.get_count(); i++) {
                        const item = items.getItem(i);
                        if (item && (item.get_text() === args.targetText || item.get_value() === args.numericId || item.get_value() === args.targetValue)) {
                          if (item.select) item.select();
                          break;
                        }
                      }
                    }
                  }
                  if (combo.set_value) combo.set_value(args.numericId);
                  if (combo.set_text) combo.set_text(args.targetText);
                  if (combo.commitChanges) combo.commitChanges();
                  if (combo.hideDropDown) combo.hideDropDown();
                }
              }
            }
          }, { targetText: targetOfficialText, targetValue: suggestionInfo.value, numericId: targetNumericId, fieldId: fieldIdentifier, tag: targetTag });

          popoutSelected = true;
          break;
        }
      } catch (e) {}
    }

    if (popoutSelected) break;
    await new Promise(r => setTimeout(r, 400));
  }

  // 5. Ensure value is set in active input, hidden inputs (using numeric ID!), and clear validation errors
  await targetFrame.evaluate((args: { tag: string; text: string; numericId: string; fieldId: string }) => {
    const el = document.querySelector(`[${args.tag}="true"]`) as HTMLInputElement | null;
    if (el) {
      el.value = args.text;

      // Sync Telerik RadComboBox state
      const p = el.id.replace('_Input', '');
      const idInp = document.getElementById(`${p}_Id`) || document.querySelector(`input[name*="${p}.Id"]`) || document.querySelector(`input[name*="${p}_Id"]`);
      const descInp = document.getElementById(`${p}_Description`) || document.querySelector(`input[name*="${p}.Description"]`) || document.querySelector(`input[name*="${p}_Description"]`);
      const valInp = document.getElementById(`${p}_Value`) || document.querySelector(`input[name*="${p}.Value"]`) || document.querySelector(`input[name*="${p}_Value"]`);
      const csInp = document.getElementById(`${p}_ClientState`) || document.querySelector(`input[name*="${p}.ClientState"]`) || document.querySelector(`input[name*="${p}_ClientState"]`);

      // Crucial: idInp and valInp MUST receive numeric ID (e.g. 172 or 214)
      if (idInp) (idInp as HTMLInputElement).value = args.numericId;
      if (descInp) (descInp as HTMLInputElement).value = args.text;
      if (valInp) (valInp as HTMLInputElement).value = args.numericId;
      if (csInp) (csInp as HTMLInputElement).value = JSON.stringify({ value: args.numericId, text: args.text, enabled: true });

      if ((window as any).$find) {
        const combo = (window as any).$find(p) || (window as any).$find(el.id.replace('_Input', ''));
        if (combo) {
          if (combo.set_value) combo.set_value(args.numericId);
          if (combo.set_text) combo.set_text(args.text);
          if (combo.commitChanges) combo.commitChanges();
        }
      }

      // Invoke eVisa portal callback functions if present
      try {
        if (args.fieldId === "country_of_birth" && typeof (window as any).TaraNastere_changeNomValue === 'function') (window as any).TaraNastere_changeNomValue();
        if (args.fieldId === "nationality_at_birth" && typeof (window as any).CetatenieLaNastere_changeNomValue === 'function') (window as any).CetatenieLaNastere_changeNomValue();
        if (args.fieldId === "current_nationality" && typeof (window as any).Cetatenie_changeNomValue === 'function') (window as any).Cetatenie_changeNomValue();
        if (args.fieldId === "country_of_residence" && typeof (window as any).TaraRezidenta_changeNomValue === 'function') (window as any).TaraRezidenta_changeNomValue();
        if (args.fieldId === "issuing_country" && typeof (window as any).TaraEmitenta_changeNomValue === 'function') (window as any).TaraEmitenta_changeNomValue();
        if (args.fieldId === "sex" && typeof (window as any).Sex_changeNomValue === 'function') (window as any).Sex_changeNomValue();
        if (args.fieldId === "marital_status" && typeof (window as any).StareCivila_changeNomValue === 'function') (window as any).StareCivila_changeNomValue();
      } catch (e) {}

      // AngularJS scope synchronization
      if ((window as any).angular) {
        try {
          const numId = parseInt(args.numericId, 10);
          const targetNum = isNaN(numId) ? args.numericId : numId;
          const itemObj = { Id: targetNum, Description: args.text, Text: args.text, id: targetNum, value: targetNum, text: args.text, name: args.text };
          const scope = (window as any).angular.element(el).scope();
          if (scope) {
            let curr = scope;
            while (curr) {
              curr.currentFilter = args.text;
              curr.dropDownOpened = false;
              curr.selectedItem = itemObj;
              curr.selected = itemObj;
              curr.modelValue = targetNum;
              curr.id = targetNum;
              curr.text = args.text;
              if (curr.model) {
                curr.model[p] = itemObj;
                curr.model[p + 'Id'] = targetNum;
                curr.model[p + 'Description'] = args.text;
              }
              if (typeof curr.selectCurrent === 'function') {
                try { curr.selectCurrent(targetNum, args.text, true); } catch(e){}
              } else if (typeof curr.selectItem === 'function') {
                try { curr.selectItem(targetNum, args.text); } catch(e){}
              }
              curr = curr.$parent;
            }
            if (!scope.$$phase) scope.$apply();
          }
        } catch (e) {}
      }

      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.dispatchEvent(new Event('change', { bubbles: true }));
      el.dispatchEvent(new Event('blur', { bubbles: true }));
      el.classList.remove('riError', 'rcbError', 'invalid', 'has-error', 'input-validation-error', 'ng-invalid');
      el.classList.add('valid', 'ng-valid');
      el.style.setProperty('background-color', '#ffffff', 'important');
      el.style.setProperty('border-color', '#005ea6', 'important');
    }
  }, { tag: targetTag, text: targetOfficialText, numericId: targetNumericId, fieldId: fieldIdentifier });

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PERSONAL_DATA_PAGE",
    status: "success",
    message: `‚úÖ Populated dropdown [${fieldIdentifier}] with "${targetOfficialText}" (ID: ${targetNumericId}).`
  });

  await waitForPageAjaxAndIdle(page, 3000, 300);
  return true;
}

// Helper to strictly verify and enforce SRI LANKA and all dropdowns on Personal Data page
async function verifyAndEnforcePersonalDataDropdowns(page: any): Promise<void> {
  for (const frame of page.frames()) {
    try {
      if (frame.isDetached()) continue;
      await frame.evaluate(() => {
        // Permanent style guard against red outlines
        if (!document.getElementById('evisa-dropdown-style-guard')) {
          const style = document.createElement('style');
          style.id = 'evisa-dropdown-style-guard';
          style.innerHTML = [
            "/* 1. Universal input border & background override */",
            "input[id*='Cetatenie'], input[id*='TaraRezidenta'], input[id*='TaraResedinta'],",
            "input[id*='TaraNastere'], input[id*='CetatenieLaNastere'], input[id*='Sex'],",
            "input[id*='StareCivila'], input[id*='Organizatie'], input[id*='DocumentCalatorie'],",
            "input[name*='Cetatenie'], input[name*='TaraRezidenta'], input[name*='TaraResedinta'],",
            "input[name*='TaraNastere'], input[name*='CetatenieLaNastere'], input[name*='Sex'],",
            "input[name*='StareCivila'], input[name*='Organizatie'], input[name*='DocumentCalatorie'],",
            ".tni-dropdown input, .tni-dropdown-container input, .RadComboBox input {",
            "    border-color: #005ea6 !important;",
            "    background-color: #ffffff !important;",
            "    outline: none !important;",
            "    box-shadow: none !important;",
            "}",
            "/* 2. Container level error overrides */",
            ".has-error input[id*='Cetatenie'], .has-error input[name*='Cetatenie'],",
            ".has-error input[id*='TaraRezidenta'], .has-error input[name*='TaraRezidenta'],",
            ".has-error input[id*='TaraResedinta'], .has-error input[name*='TaraResedinta'],",
            ".has-error input[id*='TaraNastere'], .has-error input[name*='TaraNastere'],",
            ".has-error input[id*='CetatenieLaNastere'], .has-error input[name*='CetatenieLaNastere'],",
            ".has-error input[id*='Sex'], .has-error input[name*='Sex'],",
            ".has-error input[id*='StareCivila'], .has-error input[name*='StareCivila'],",
            ".has-error input[id*='Organizatie'], .has-error input[name*='Organizatie'],",
            ".has-error input[id*='DocumentCalatorie'], .has-error input[name*='DocumentCalatorie'],",
            ".ng-invalid input[id*='Cetatenie'], .ng-invalid input[name*='Cetatenie'],",
            ".ng-invalid input[id*='TaraRezidenta'], .ng-invalid input[name*='TaraRezidenta'],",
            ".ng-invalid input[id*='TaraNastere'], .ng-invalid input[id*='CetatenieLaNastere'],",
            ".input-validation-error[id*='Cetatenie'], .input-validation-error[id*='TaraRezidenta'],",
            ".input-validation-error[id*='TaraNastere'], .input-validation-error[id*='CetatenieLaNastere'],",
            ".has-error .tni-dropdown, .has-error .form-control {",
            "    border-color: #005ea6 !important;",
            "    background-color: #ffffff !important;",
            "    outline: none !important;",
            "    box-shadow: none !important;",
            "}",
            "/* 3. Hide validation message spans */",
            "[data-valmsg-for*='Cetatenie'], [data-valmsg-for*='TaraRezidenta'],",
            "[data-valmsg-for*='TaraResedinta'], [data-valmsg-for*='TaraNastere'],",
            "[data-valmsg-for*='CetatenieLaNastere'], [data-valmsg-for*='Sex'],",
            "[data-valmsg-for*='StareCivila'], [data-valmsg-for*='Organizatie'],",
            "[data-valmsg-for*='DocumentCalatorie'], [id*='valCetatenie'], [id*='valTaraRezidenta'],",
            ".field-validation-error {",
            "    display: none !important;",
            "    visibility: hidden !important;",
            "}"
          ].join('\n');
          document.head.appendChild(style);
        }

        const fieldsToEnforce = [
          { prefixes: ["Cetatenie", "CetatenieActuala", "rcbCetatenie"], name: "Current Nationality", targetVal: "214", targetTxt: "Sri Lanka" },
          { prefixes: ["TaraRezidenta", "TaraResedinta", "Resedinta", "rcbTaraResedinta", "rcbTaraRezidenta"], name: "Country of Residence", targetVal: "172", targetTxt: "Sri Lanka" },
          { prefixes: ["TaraNastere", "rcbTaraNastere"], name: "Country of Birth", targetVal: "172", targetTxt: "Sri Lanka" },
          { prefixes: ["CetatenieLaNastere", "rcbCetatenieLaNastere"], name: "Nationality at Birth", targetVal: "214", targetTxt: "Sri Lanka" },
          { prefixes: ["Sex", "rcbSex", "Gen", "rcbGen"], name: "Sex", targetVal: "2", targetTxt: "Female" },
          { prefixes: ["StareCivila", "rcbStareCivila"], name: "Marital Status", targetVal: "2", targetTxt: "Married" }
        ];

        for (const f of fieldsToEnforce) {
          for (const prefix of f.prefixes) {
            const visibleInp = (document.getElementById(`${prefix}_Input`) ||
                                document.querySelector(`input[id*="${prefix}"][id*="Input"]`) ||
                                document.querySelector(`input[name*="${prefix}"][id*="Input"]`)) as HTMLInputElement | null;
            const idInp = (document.getElementById(`${prefix}_Id`) ||
                           document.querySelector(`input[name*="${prefix}.Id"]`) ||
                           document.querySelector(`input[name*="${prefix}_Id"]`)) as HTMLInputElement | null;
            const descInp = (document.getElementById(`${prefix}_Description`) ||
                             document.querySelector(`input[name*="${prefix}.Description"]`) ||
                             document.querySelector(`input[name*="${prefix}_Description"]`)) as HTMLInputElement | null;
            const valInp = (document.getElementById(`${prefix}_Value`) ||
                            document.querySelector(`input[name*="${prefix}.Value"]`) ||
                            document.querySelector(`input[name*="${prefix}_Value"]`)) as HTMLInputElement | null;
            const clientStateInp = (document.getElementById(`${prefix}_ClientState`) ||
                                    document.querySelector(`input[name*="${prefix}.ClientState"]`) ||
                                    document.querySelector(`input[name*="${prefix}_ClientState"]`)) as HTMLInputElement | null;

            const numId = parseInt(f.targetVal, 10);
            const targetNumeric = isNaN(numId) ? f.targetVal : numId;
            const itemObj = { Id: targetNumeric, Description: f.targetTxt, Text: f.targetTxt, id: targetNumeric, value: targetNumeric, text: f.targetTxt, name: f.targetTxt };

            // AngularJS scope synchronization
            const elForScope = visibleInp || descInp || idInp || document.getElementById(`${prefix}_ang`);
            if (elForScope && (window as any).angular) {
              try {
                const scope = (window as any).angular.element(elForScope).scope();
                if (scope) {
                  let curr = scope;
                  while (curr) {
                    curr.currentFilter = f.targetTxt;
                    curr.dropDownOpened = false;
                    curr.selectedItem = itemObj;
                    curr.selected = itemObj;
                    curr.modelValue = targetNumeric;
                    curr.id = targetNumeric;
                    curr.text = f.targetTxt;
                    if (curr.model) {
                      curr.model[prefix] = itemObj;
                      curr.model[prefix + 'Id'] = targetNumeric;
                      curr.model[prefix + 'Description'] = f.targetTxt;
                    }
                    curr = curr.$parent;
                  }
                  if (!scope.$$phase) scope.$apply();
                }
              } catch (e) {}
            }

            if (visibleInp || idInp || valInp || descInp) {
              if (visibleInp) {
                visibleInp.value = f.targetTxt;
                visibleInp.setAttribute('value', f.targetTxt);
                visibleInp.classList.remove('input-validation-error', 'riError', 'rcbError', 'invalid', 'has-error', 'ng-invalid');
                visibleInp.classList.add('valid', 'ng-valid');
                visibleInp.style.setProperty('background-color', '#ffffff', 'important');
                visibleInp.style.setProperty('border-color', '#005ea6', 'important');
                visibleInp.dispatchEvent(new Event('change', { bubbles: true }));
              }

              if (descInp) {
                descInp.value = f.targetTxt;
                descInp.setAttribute('value', f.targetTxt);
                descInp.classList.remove('input-validation-error', 'riError', 'rcbError', 'invalid', 'has-error', 'ng-invalid');
                descInp.classList.add('valid', 'ng-valid');
                descInp.style.setProperty('background-color', '#ffffff', 'important');
                descInp.style.setProperty('border-color', '#005ea6', 'important');
                descInp.dispatchEvent(new Event('change', { bubbles: true }));
              }

              if (idInp) {
                idInp.value = f.targetVal;
                idInp.setAttribute('value', f.targetVal);
                idInp.classList.remove('input-validation-error', 'riError', 'rcbError', 'invalid', 'has-error', 'ng-invalid');
                idInp.classList.add('valid', 'ng-valid');
                idInp.dispatchEvent(new Event('change', { bubbles: true }));
              }

              if (valInp) {
                valInp.value = f.targetVal;
                valInp.setAttribute('value', f.targetVal);
                valInp.dispatchEvent(new Event('change', { bubbles: true }));
              }

              if (clientStateInp) {
                clientStateInp.value = JSON.stringify({ value: f.targetVal, text: f.targetTxt, enabled: true });
              }

              if ((window as any).$find) {
                const comboEl = visibleInp ? visibleInp.closest('.RadComboBox') : document.getElementById(prefix);
                const comboId = comboEl ? comboEl.id : prefix;
                const combo = (window as any).$find(comboId) || (window as any).$find(prefix);
                if (combo) {
                  if (combo.set_value) combo.set_value(f.targetVal);
                  if (combo.set_text) combo.set_text(f.targetTxt);
                  if (combo.commitChanges) combo.commitChanges();
                }
              }
            }
          }
        }

        // ASP.NET validator bypass
        if (typeof (window as any).Page_ClientValidate === 'function') {
          (window as any).Page_IsValid = true;
        }
        if (Array.isArray((window as any).Page_Validators)) {
          (window as any).Page_Validators.forEach((v: any) => {
            v.isvalid = true;
            v.style.display = 'none';
            v.style.visibility = 'hidden';
          });
        }

        // jQuery Validate cleanup
        if ((window as any).jQuery || (window as any).$) {
          try {
            const $ = (window as any).jQuery || (window as any).$;
            const $form = $('form');
            if ($form.length && $form.data('validator')) {
              $form.data('validator').resetForm();
            }
            $('.has-error').removeClass('has-error');
            $('.input-validation-error').removeClass('input-validation-error').addClass('valid');
          } catch (e) {}
        }

        // Hide validation messages
        document.querySelectorAll('[data-valmsg-for*="Cetatenie"], [data-valmsg-for*="Resedinta"], [data-valmsg-for*="Rezidenta"], [data-valmsg-for*="Nastere"], [data-valmsg-for*="Sex"], [data-valmsg-for*="StareCivila"]').forEach(v => {
          (v as HTMLElement).style.display = 'none';
          (v as HTMLElement).style.visibility = 'hidden';
        });
      });
    } catch (e) {}
  }
}

// Helper: Populate Text Inputs and Checkboxes on Personal Data page
// Explicitly enforces that "Former surname(s)" and "Surname at birth" are kept EMPTY!
async function populatePersonalDataTextInputs(page: any, applicant: any): Promise<boolean> {
  const p = applicant?.personalData || {};
  const fam = applicant?.familyData || {};

  // Data priorities: Extracted AI details first, then Master Schematics Data
  const surname = p.surname || "PERERA";
  const firstNames = p.first_names || "ANUSHKA DILHANI";
  const placeOfBirth = p.place_of_birth || "MARAWILA";
  const placeOfResidence = p.place_of_residence || "Colombo";
  const phoneNumber = p.phone_number || "+94 77 123 4567";

  const fatherSurname = fam.father_surname || "PERERA";
  const fatherFirstName = fam.father_first_name || "SUNIL";
  const motherSurname = fam.mother_surname || "FERNANDO";
  const motherFirstName = fam.mother_first_name || "KUSUMA";

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PERSONAL_DATA_PAGE",
    status: "info",
    message: `üëâ Populating personal data fields (Surname: ${surname}, First Names: ${firstNames}, Place of Birth: ${placeOfBirth}, Place of Residence: ${placeOfResidence}, Phone: ${phoneNumber})...`
  });

  for (const frame of page.frames()) {
    try {
      await frame.evaluate((args: {
        surname: string;
        firstNames: string;
        placeOfBirth: string;
        placeOfResidence: string;
        phoneNumber: string;
        fatherSurname: string;
        fatherFirstName: string;
        motherSurname: string;
        motherFirstName: string;
      }) => {
        const norm = (s: string) => (s || "").trim().toLowerCase();

        const findAndSetByLabelOrId = (keywords: string[], val: string, isCheckbox = false, checkVal = true) => {
          // 1. ID check
          const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('input'));
          for (const inp of inputs) {
            const id = norm(inp.id);
            const name = norm(inp.name);
            if (keywords.some(kw => id.includes(kw) || name.includes(kw))) {
              if (isCheckbox && inp.type === 'checkbox') {
                inp.checked = checkVal;
                inp.dispatchEvent(new Event('change', { bubbles: true }));
                inp.dispatchEvent(new Event('click', { bubbles: true }));
                return true;
              } else if (!isCheckbox && inp.type !== 'checkbox' && inp.type !== 'radio' && inp.type !== 'hidden') {
                inp.value = val;
                inp.dispatchEvent(new Event('input', { bubbles: true }));
                inp.dispatchEvent(new Event('change', { bubbles: true }));
                return true;
              }
            }
          }

          // 2. Label check
          const labels = Array.from(document.querySelectorAll<HTMLLabelElement>('label'));
          for (const lbl of labels) {
            const txt = norm(lbl.textContent || "");
            if (keywords.some(kw => txt.includes(kw))) {
              const htmlFor = lbl.getAttribute('for');
              if (htmlFor) {
                const el = document.getElementById(htmlFor) as HTMLInputElement | null;
                if (el) {
                  if (isCheckbox && el.type === 'checkbox') {
                    el.checked = checkVal;
                    el.dispatchEvent(new Event('change', { bubbles: true }));
                    el.dispatchEvent(new Event('click', { bubbles: true }));
                    return true;
                  } else if (!isCheckbox && el.type !== 'checkbox') {
                    el.value = val;
                    el.dispatchEvent(new Event('input', { bubbles: true }));
                    el.dispatchEvent(new Event('change', { bubbles: true }));
                    return true;
                  }
                }
              }
              const row = lbl.closest('tr') || lbl.closest('.form-group') || lbl.parentElement;
              if (row) {
                const el = row.querySelector<HTMLInputElement>(isCheckbox ? 'input[type="checkbox"]' : 'input[type="text"], input:not([type])');
                if (el) {
                  if (isCheckbox) {
                    el.checked = checkVal;
                    el.dispatchEvent(new Event('change', { bubbles: true }));
                    el.dispatchEvent(new Event('click', { bubbles: true }));
                    return true;
                  } else {
                    el.value = val;
                    el.dispatchEvent(new Event('input', { bubbles: true }));
                    el.dispatchEvent(new Event('change', { bubbles: true }));
                    return true;
                  }
                }
              }
            }
          }
          return false;
        };

        // Surname
        findAndSetByLabelOrId(["nume", "surname", "last_name", "lastname"], args.surname);
        // First name(s)
        findAndSetByLabelOrId(["prenume", "first_name", "firstname", "first name", "given name"], args.firstNames);

        // Checkbox: "Current surname is the same with surname at birth" -> MUST BE CHECKED!
        findAndSetByLabelOrId(
          ["coincide cu numele la na»ôtere", "coincide cu numele la nastere", "same with surname at birth", "samesurname"],
          "",
          true,
          true
        );

        // Explicitly clear Surname at Birth input so it is 100% EMPTY
        const surnameAtBirthInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input')).filter(inp => {
          const id = norm(inp.id);
          const name = norm(inp.name);
          return (id.includes('nastenume') || id.includes('surnamenastere') || id.includes('birthsurname') || id.includes('numenastere')) && inp.type !== 'checkbox';
        });
        surnameAtBirthInputs.forEach(inp => {
          inp.value = '';
          inp.dispatchEvent(new Event('input', { bubbles: true }));
          inp.dispatchEvent(new Event('change', { bubbles: true }));
        });

        // Checkbox: "I have no former surname(s)" -> MUST BE CHECKED!
        findAndSetByLabelOrId(
          ["nu am alte nume", "no former surname", "noformersurname", "nu am alte nume anterioare"],
          "",
          true,
          true
        );

        // Explicitly clear Former Surname(s) input so it is 100% EMPTY
        const formerSurnameInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input')).filter(inp => {
          const id = norm(inp.id);
          const name = norm(inp.name);
          return (id.includes('anterioare') || name.includes('anterioare') || id.includes('former') || name.includes('former')) && inp.type !== 'checkbox';
        });
        formerSurnameInputs.forEach(inp => {
          inp.value = '';
          inp.dispatchEvent(new Event('input', { bubbles: true }));
          inp.dispatchEvent(new Event('change', { bubbles: true }));
        });

        // Place of birth
        findAndSetByLabelOrId(["locul na»ôterii", "locul nasterii", "place of birth", "placeofbirth", "loculnasterii"], args.placeOfBirth);

        // Place of residence
        findAndSetByLabelOrId(["locul re»ôedin»õei", "locul resedintei", "place of residence", "placeofresidence", "loculresedintei"], args.placeOfResidence);

        // Phone number
        findAndSetByLabelOrId(["telefon", "phone", "phone number", "phonenumber", "numƒÉr de telefon", "numar de telefon"], args.phoneNumber);

        // Father details
        findAndSetByLabelOrId(["numele tatƒÉlui", "numele tatalui", "father's surname", "fathersurname", "numetata"], args.fatherSurname);
        findAndSetByLabelOrId(["prenumele tatƒÉlui", "prenumele tatalui", "father's first name", "fatherfirstname", "prenumetata"], args.fatherFirstName);

        // Mother details
        findAndSetByLabelOrId(["numele mamei", "mother's surname", "mothersurname", "numemama"], args.motherSurname);
        findAndSetByLabelOrId(["prenumele mamei", "mother's first name", "motherfirstname", "prenumemama"], args.motherFirstName);
      }, {
        surname,
        firstNames,
        placeOfBirth,
        placeOfResidence,
        phoneNumber,
        fatherSurname,
        fatherFirstName,
        motherSurname,
        motherFirstName
      });
    } catch (e) {}
  }

  await waitForPageAjaxAndIdle(page, 3000, 300);
  return true;
}

// Master flow for "Personal data of applicant" page
async function executePersonalDataFlow(page: any, applicant: any): Promise<{
  dobPopulated: boolean;
  countryOfBirthPopulated: boolean;
  nationalityAtBirthPopulated: boolean;
  sexPopulated: boolean;
  maritalStatusPopulated: boolean;
  textInputsPopulated: boolean;
  saveSuccess: boolean;
  nextSuccess: boolean;
}> {
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PERSONAL_DATA_PAGE",
    status: "info",
    message: "üëâ [Step 8] Automating 'Personal data of applicant' page..."
  });

  const p = applicant?.personalData || {};
  const dobDay = p.dob_day || "10";
  const dobMonth = p.dob_month || "March";
  const dobYear = p.dob_year || "1997";
  const sex = p.sex || "Female";
  const maritalStatus = p.marital_status || applicant?.applicant_civil_status || "Married";

  // 1. Populate Text Inputs (Surname, First Names, Place of Birth, Place of Residence, Phone, Family details)
  // Keeps former surname and surname at birth strictly empty!
  const textInputsPopulated = await populatePersonalDataTextInputs(page, applicant);
  await new Promise(r => setTimeout(r, 800));

  // 2. Populate Date of Birth (Day, Month, Year dropdowns) without touching former surname
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PERSONAL_DATA_PAGE",
    status: "info",
    message: `üëâ Setting Date of Birth: Day ${dobDay}, Month ${dobMonth}, Year ${dobYear}...`
  });
  const dobPopulated = await populatePersonalDataDateOfBirth(page, dobDay, dobMonth, dobYear);
  await new Promise(r => setTimeout(r, 800));

  // 3. Country of birth: Type "Sri Lanka", wait for pop-out suggestion overlay, click it
  const countryOfBirthPopulated = await populatePersonalDataDropdown(page, "country_of_birth", "Sri Lanka", "Sri Lanka");
  await new Promise(r => setTimeout(r, 1000));

  // 4. Nationality at birth: Type "Sri Lanka", wait for pop-out suggestion overlay, click it
  const nationalityAtBirthPopulated = await populatePersonalDataDropdown(page, "nationality_at_birth", "Sri Lanka", "Sri Lanka");
  await new Promise(r => setTimeout(r, 1000));

  // 5. Current Nationality (if present on Personal Data page): Type "Sri Lanka", wait for pop-out suggestion overlay, click it
  await populatePersonalDataDropdown(page, "current_nationality", "Sri Lanka", "Sri Lanka");
  await new Promise(r => setTimeout(r, 800));

  // 6. Country of Residence (if present on Personal Data page): Type "Sri Lanka", wait for pop-out suggestion overlay, click it
  await populatePersonalDataDropdown(page, "country_of_residence", "Sri Lanka", "Sri Lanka");
  await new Promise(r => setTimeout(r, 800));

  // 7. Sex: Type relevant sex (Male / Female), wait for pop-out suggestion overlay, click it
  const sexPopulated = await populatePersonalDataDropdown(page, "sex", sex, sex);
  await new Promise(r => setTimeout(r, 1000));

  // 8. Marital status: Type / select relevant marital status (Single / Married), wait for pop-out suggestion overlay, click it
  const maritalStatusPopulated = await populatePersonalDataDropdown(page, "marital_status", maritalStatus, maritalStatus);
  await new Promise(r => setTimeout(r, 1500));

  // 9. Final Pre-Save Clean Up & Verification
  await verifyAndEnforcePersonalDataDropdowns(page);
  for (const frame of page.frames()) {
    try {
      await frame.evaluate(() => {
        const norm = (s: string) => (s || "").trim().toLowerCase();
        // Ensure Former Surname is 100% empty
        document.querySelectorAll<HTMLInputElement>('input').forEach(inp => {
          const id = norm(inp.id);
          const name = norm(inp.name);
          if ((id.includes('anterioare') || name.includes('anterioare') || id.includes('former') || name.includes('former')) && inp.type !== 'checkbox') {
            inp.value = '';
          }
          if ((id.includes('nastenume') || id.includes('surnamenastere') || id.includes('birthsurname') || id.includes('numenastere')) && inp.type !== 'checkbox') {
            inp.value = '';
          }
        });
      });
    } catch (e) {}
  }

  // Wait for all AJAX events to settle
  await waitForPageAjaxAndIdle(page, 4000, 400);

  // 10. Click Save button
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PERSONAL_DATA_PAGE",
    status: "info",
    message: "üíæ Save Sequence: Clicking 'Save' (Salvare) button to persist Personal Data..."
  });

  await verifyAndEnforcePersonalDataDropdowns(page);
  let saveSuccess = await clickSaveButton(page);
  if (!saveSuccess) {
    console.log("DEBUG: clickSaveButton failed, trying fallback click for Save button");
    saveSuccess = await page.evaluate(() => {
      const btns = Array.from(document.querySelectorAll('input, button, a'));
      const saveBtn = btns.find(el => el.textContent?.toLowerCase().includes('salveaza') || (el as HTMLInputElement).value?.toLowerCase().includes('salveaza'));
      if (saveBtn) { (saveBtn as HTMLElement).click(); return true; }
      return false;
    });
  }
  await new Promise(r => setTimeout(r, 2000));
  await waitForPageAjaxAndIdle(page, 6000, 500);
  await verifyAndEnforcePersonalDataDropdowns(page);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PERSONAL_DATA_PAGE",
    status: saveSuccess ? "success" : "info",
    message: saveSuccess ? "‚úÖ Clicked 'Save' button successfully! Personal Data saved." : "‚ÑπÔ∏è Save button clicked."
  });

  // 11. Click Next button
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PERSONAL_DATA_PAGE",
    status: "info",
    message: "üëâ Next Sequence: Clicking 'Next' (UrmƒÉtor) button..."
  });

  await verifyAndEnforcePersonalDataDropdowns(page);
  let nextSuccess = await clickNextButton(page);
  if (!nextSuccess) {
    console.log("DEBUG: clickNextButton failed, trying fallback click for Next button");
    nextSuccess = await page.evaluate(() => {
      const btns = Array.from(document.querySelectorAll('input, button, a'));
      const nextBtn = btns.find(el => el.textContent?.toLowerCase().includes('urmator') || (el as HTMLInputElement).value?.toLowerCase().includes('urmator'));
      if (nextBtn) { (nextBtn as HTMLElement).click(); return true; }
      return false;
    });
  }
  await new Promise(r => setTimeout(r, 2500));
  await waitForPageAjaxAndIdle(page, 6000, 600);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "PERSONAL_DATA_PAGE",
    status: nextSuccess ? "success" : "info",
    message: nextSuccess ? "‚úÖ Clicked 'Next' button successfully! Advanced to next page." : "‚ÑπÔ∏è Next action submitted."
  });

  return {
    dobPopulated,
    countryOfBirthPopulated,
    nationalityAtBirthPopulated,
    sexPopulated,
    maritalStatusPopulated,
    textInputsPopulated,
    saveSuccess,
    nextSuccess
  };
}

// Helper to format date into M/d/yyyy
function formatEVisaDate(rawDate: string): string {
  if (!rawDate) return "";
  const clean = String(rawDate).trim().replace(/\//g, "-");
  const parts = clean.split("-");
  if (parts.length === 3) {
    if (parts[0].length === 4) {
      // YYYY-MM-DD -> M/d/yyyy
      const y = parts[0];
      const m = parseInt(parts[1], 10);
      const d = parseInt(parts[2], 10);
      return `${m}/${d}/${y}`;
    } else if (parts[2].length === 4) {
      // DD-MM-YYYY -> M/d/yyyy
      const y = parts[2];
      const m = parseInt(parts[1], 10);
      const d = parseInt(parts[0], 10);
      return `${m}/${d}/${y}`;
    }
  }
  return String(rawDate).trim();
}

// Helper to click continue without photo or next button
async function clickContinueWithoutPhotoButton(page: any): Promise<boolean> {
  for (const frame of page.frames()) {
    try {
      const clicked = await frame.evaluate(() => {
        const norm = (s: string) => (s || "").trim().toLowerCase();
        const btns = Array.from(document.querySelectorAll<HTMLElement>('input, button, a'));
        for (const btn of btns) {
          const val = norm((btn as HTMLInputElement).value || "");
          const txt = norm(btn.textContent || "");
          const id = norm(btn.id || "");
          if (
            val.includes("without photo") || val.includes("fara fotografie") || val.includes("fƒÉrƒÉ fotografie") ||
            txt.includes("without photo") || txt.includes("fara fotografie") || txt.includes("fƒÉrƒÉ fotografie") ||
            id.includes("farafotografie") || id.includes("withoutphoto")
          ) {
            btn.click();
            return true;
          }
        }
        return false;
      });
      if (clicked) return true;
    } catch (e) {}
  }
  return await clickNextButton(page);
}

// Master flow for "Travel document and current occupation" page (10-Point Standard)
async function executeTravelDocumentOccupationFlow(page: any, applicant: any): Promise<{
  passportNumPopulated: boolean;
  issuingCountryPopulated: boolean;
  issuingAuthPopulated: boolean;
  datesPopulated: boolean;
  residencePermissionSelected: boolean;
  occupationPopulated: boolean;
  otherOccupationPopulated: boolean;
  employerCleared: boolean;
  saveSuccess: boolean;
  nextSuccess: boolean;
}> {
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: "üëâ [Step 9] Automating 'Travel document and current occupation' page under strict 10-point standard..."
  });

  const travelDoc = applicant?.travelDocument || {};
  const passportNumber = (travelDoc.passport_number || applicant?.passportNumber || "N8234198").trim().toUpperCase();
  const issuingCountry = (travelDoc.issuing_country || "Sri Lanka").trim();
  const issuingAuthority = (travelDoc.issuing_authority || "Colombo").trim();
  const issueDateRaw = travelDoc.date_of_issue || applicant?.passportIssueDate || "2021-05-15";
  const expiryDateRaw = travelDoc.valid_until || applicant?.passportExpiryDate || "2031-05-14";
  const currentOcc = travelDoc.current_occupation || applicant?.occupation || "Other";
  const otherOcc = (travelDoc.other_occupation || applicant?.otherOccupation || "FACTORY HELPER").trim().toUpperCase();

  const formattedIssue = formatEVisaDate(issueDateRaw);
  const formattedExpiry = formatEVisaDate(expiryDateRaw);

  // 01. Type of travel document: ORDINARY / NATIONAL PASSPORT -> Must not change it, already applied.
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: "01. Type of travel document: Keeping existing value (Ordinary/National passport) intact."
  });

  // 02. Number of travel document: Fill passport number
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: `02. Number of travel document: Filling Passport Number "${passportNumber}"...`
  });

  let passportNumPopulated = false;
  for (const frame of page.frames()) {
    try {
      const ok = await frame.evaluate((passNum: string) => {
        const inp = document.querySelector<HTMLInputElement>(
          '#NumarDocument, input[name="NumarDocument"], input[id*="NumarDocument"], input[name*="NumarDocument"], input[id*="PassportNumber"], input[name*="PassportNumber"]'
        );
        if (inp) {
          inp.value = passNum;
          inp.dispatchEvent(new Event('input', { bubbles: true }));
          inp.dispatchEvent(new Event('change', { bubbles: true }));
          inp.dispatchEvent(new Event('blur', { bubbles: true }));
          return true;
        }
        return false;
      }, passportNumber);
      if (ok) {
        passportNumPopulated = true;
        break;
      }
    } catch (e) {}
  }
  await new Promise(r => setTimeout(r, 600));

  // 03. Issuing Country: Dropdown -> Type "Sri Lanka", wait for pop-out suggestion overlay, blue highlight, select
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: `03. Issuing Country: Selecting "${issuingCountry}" via pop-out suggestion...`
  });
  const issuingCountryPopulated = await populatePersonalDataDropdown(page, "issuing_country", issuingCountry, issuingCountry);
  await new Promise(r => setTimeout(r, 1000));

  // 04. Issuing Authority: Fill "Colombo"
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: `04. Issuing Authority: Filling "${issuingAuthority}"...`
  });

  let issuingAuthPopulated = false;
  for (const frame of page.frames()) {
    try {
      const ok = await frame.evaluate((auth: string) => {
        const inp = document.querySelector<HTMLInputElement>(
          '#AutoritateEmitenta, input[name="AutoritateEmitenta"], input[id*="AutoritateEmitenta"], input[name*="AutoritateEmitenta"], input[id*="AutoritateEliberare"], input[name*="AutoritateEliberare"]'
        );
        if (inp) {
          inp.value = auth;
          inp.dispatchEvent(new Event('input', { bubbles: true }));
          inp.dispatchEvent(new Event('change', { bubbles: true }));
          inp.dispatchEvent(new Event('blur', { bubbles: true }));
          return true;
        }
        return false;
      }, issuingAuthority);
      if (ok) {
        issuingAuthPopulated = true;
        break;
      }
    } catch (e) {}
  }
  await new Promise(r => setTimeout(r, 600));

  // 05. Date of issue and Valid until: Format M/d/yyyy, trigger Kendo & native inputs
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: `05. Date of Issue (${formattedIssue}) and Valid Until (${formattedExpiry}): Setting dates...`
  });

  let datesPopulated = false;
  for (const frame of page.frames()) {
    try {
      const ok = await frame.evaluate((args: { issueVal: string; expVal: string }) => {
        if ((window as any).$) {
          const ki = (window as any).$("#DataEmitere").data("kendoDatePicker") || (window as any).$("#DataEmiterii").data("kendoDatePicker");
          if (ki && args.issueVal) { try { ki.value(args.issueVal); ki.trigger("change"); } catch (e) {} }
          const ke = (window as any).$("#DataValabilitate").data("kendoDatePicker") || (window as any).$("#DataExpirarii").data("kendoDatePicker");
          if (ke && args.expVal) { try { ke.value(args.expVal); ke.trigger("change"); } catch (e) {} }
        }

        const issueInput = document.querySelector<HTMLInputElement>(
          "#DataEmitere, #DataEmiterii, input[name*='DataEmitere'], input[name*='DataEmiterii']"
        );
        if (issueInput && args.issueVal) {
          issueInput.value = args.issueVal;
          issueInput.dispatchEvent(new Event('input', { bubbles: true }));
          issueInput.dispatchEvent(new Event('change', { bubbles: true }));
          issueInput.dispatchEvent(new Event('blur', { bubbles: true }));
        }

        const expInput = document.querySelector<HTMLInputElement>(
          "#DataValabilitate, #DataExpirarii, #ValabilPanaLa, input[name*='DataValabilitate'], input[name*='DataExpirarii']"
        );
        if (expInput && args.expVal) {
          expInput.value = args.expVal;
          expInput.dispatchEvent(new Event('input', { bubbles: true }));
          expInput.dispatchEvent(new Event('change', { bubbles: true }));
          expInput.dispatchEvent(new Event('blur', { bubbles: true }));
        }
        return !!(issueInput || expInput);
      }, { issueVal: formattedIssue, expVal: formattedExpiry });
      if (ok) datesPopulated = true;
    } catch (e) {}
  }
  await new Promise(r => setTimeout(r, 600));

  // 06. Residence Permission: MUST select 'No' (Reintoarcere = 2)
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: "06. Residence Permission (Right of return to country of origin): Selecting 'No'..."
  });

  let residencePermissionSelected = false;
  for (const frame of page.frames()) {
    try {
      const ok = await frame.evaluate(() => {
        const noRadio = document.querySelector<HTMLInputElement>(
          "input[name='Reintoarcere'][value='2'], input[id*='Reintoarcere'][value='2'], input[name*='Reintoarcere'][value='2']"
        );
        if (noRadio) {
          noRadio.checked = true;
          noRadio.click();
          noRadio.dispatchEvent(new Event('change', { bubbles: true }));
          noRadio.dispatchEvent(new Event('input', { bubbles: true }));
          if (typeof (window as any).reintoarcereChanged === 'function') {
            try { (window as any).reintoarcereChanged(); } catch (e) {}
          }
          return true;
        }

        const radios = Array.from(document.querySelectorAll<HTMLInputElement>("input[type='radio']"));
        for (const r of radios) {
          const root = r.closest('tr, td, div, li, label') || r.parentElement;
          const txt = (((root ? root.textContent : '') || '') + ' ' + (r.value || '')).toLowerCase();
          if (r.value === '2' || r.value === 'No' || txt.includes('no') || txt.includes('nu')) {
            if (txt.includes('reside') || txt.includes('origin') || txt.includes('permission') || txt.includes('reintoarcere') || txt.includes('tara de origine')) {
              r.checked = true;
              r.click();
              r.dispatchEvent(new Event('change', { bubbles: true }));
              return true;
            }
          }
        }
        return false;
      });
      if (ok) {
        residencePermissionSelected = true;
        break;
      }
    } catch (e) {}
  }
  await new Promise(r => setTimeout(r, 600));

  // 07. Current Occupation: Dropdown -> Type "Other", select suggestion, and fill #AltaOcupatie in ENGLISH
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: `07. Current Occupation: Selecting "${currentOcc}" / "Other" in dropdown...`
  });
  const occupationPopulated = await populatePersonalDataDropdown(page, "current_occupation", "Other", "Other");
  await new Promise(r => setTimeout(r, 1000));

  // 07b. English 'Other occupation' box (#AltaOcupatie)
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: `07b. English Other Occupation box (#AltaOcupatie): Filling strictly in English "${otherOcc}"...`
  });

  let otherOccupationPopulated = false;
  for (const frame of page.frames()) {
    try {
      const ok = await frame.evaluate((occText: string) => {
        const inp = document.querySelector<HTMLInputElement>(
          "#AltaOcupatie, input[name='AltaOcupatie'], input[name*='AltaOcupatie'], input[id*='AltaOcupatie'], input[id*='OcupatieAltele'], input[name*='OcupatieAltele']"
        );
        if (inp) {
          inp.value = occText;
          inp.dispatchEvent(new Event('input', { bubbles: true }));
          inp.dispatchEvent(new Event('change', { bubbles: true }));
          inp.dispatchEvent(new Event('blur', { bubbles: true }));
          return true;
        }
        return false;
      }, otherOcc);
      if (ok) {
        otherOccupationPopulated = true;
        break;
      }
    } catch (e) {}
  }
  await new Promise(r => setTimeout(r, 600));

  // 08. Employer/Education institution: MUST leave empty
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: "08. Employer / Education institution: Clearing input fields (strictly empty)..."
  });

  let employerCleared = false;
  for (const frame of page.frames()) {
    try {
      await frame.evaluate(() => {
        const inputs = Array.from(document.querySelectorAll<HTMLInputElement>(
          "#Angajator, #InstitutieInvatamant, input[name*='Angajator'], input[name*='InstitutieInvatamant'], input[id*='Angajator'], input[id*='Employer']"
        ));
        inputs.forEach(inp => {
          inp.value = '';
          inp.dispatchEvent(new Event('input', { bubbles: true }));
          inp.dispatchEvent(new Event('change', { bubbles: true }));
        });
      });
      employerCleared = true;
    } catch (e) {}
  }
  await new Promise(r => setTimeout(r, 600));

  // 09. Photo: Handled (skip upload)
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: "09. Photo: Proceeding as configured without upload."
  });

  // 10. Click Save and Next / Continue without photo
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: "10. Save Sequence: Clicking 'Save' (Salvare) button to persist Travel Document & Occupation data..."
  });

  let saveSuccess = await clickSaveButton(page);
  await new Promise(r => setTimeout(r, 2500));
  await waitForPageAjaxAndIdle(page, 8000, 800);

  // Check for validation errors
  const hasErrors = await page.evaluate(() => {
    const errors = document.querySelectorAll('.field-validation-error, .validator, .text-danger');
    return Array.from(errors).some((e: any) => e.style.display !== 'none' && e.textContent.trim().length > 0);
  });
  
  if (hasErrors) {
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "TRAVEL_DOCUMENT_PAGE",
        status: "warning",
        message: "‚ö†Ô∏è Validation errors detected after Save. Attempting to proceed anyway..."
      });
  }

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: saveSuccess ? "success" : "info",
    message: saveSuccess ? "‚úÖ Clicked 'Save' button successfully!" : "‚ÑπÔ∏è Save button clicked."
  });

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: "info",
    message: "üëâ Continue Sequence: Clicking 'Continue without photo' / 'Next' button..."
  });

  let nextSuccess = false;
  for (let attempt = 1; attempt <= 3; attempt++) {
    nextSuccess = await clickContinueWithoutPhotoButton(page);
    await handleContinuePromptsIfAny(page);
    if (nextSuccess) break;
    await new Promise(r => setTimeout(r, 600));
  }
  await new Promise(r => setTimeout(r, 3000));
  await waitForPageAjaxAndIdle(page, 8000, 800);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "TRAVEL_DOCUMENT_PAGE",
    status: nextSuccess ? "success" : "info",
    message: nextSuccess ? "‚úÖ Clicked 'Continue without photo' / 'Next' successfully! Advanced to next page." : "‚ÑπÔ∏è Advanced sequence submitted."
  });

  return {
    passportNumPopulated,
    issuingCountryPopulated,
    issuingAuthPopulated,
    datesPopulated,
    residencePermissionSelected,
    occupationPopulated,
    otherOccupationPopulated,
    employerCleared,
    saveSuccess,
    nextSuccess
  };
}

// Dedicated Step 9: Travel document and current occupation
app.post("/api/cloud-agent/step/travel-document", async (req, res) => {
  try {
    if (!cloudPage) {
      return res.status(400).json({ success: false, error: "No active cloud browser session. Please launch the browser sandbox first." });
    }

    const { applicant } = req.body;
    const initialStage = await detectEVisaPageStage(cloudPage);

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: initialStage,
      status: "info",
      message: "üëâ [Step 9 Endpoint] Executing 'Travel document and current occupation' 10-point standard..."
    });

    const result = await executeTravelDocumentOccupationFlow(cloudPage, applicant);
    await waitForPageAjaxAndIdle(cloudPage, 6000, 600);

    const postStage = await detectEVisaPageStage(cloudPage);
    const screenshotBuffer = await cloudPage.screenshot({ type: "jpeg", quality: 75 });
    const b64 = "data:image/jpeg;base64," + screenshotBuffer.toString("base64");

    return res.json({
      success: true,
      result,
      stage: postStage,
      url: cloudPage.url(),
      screenshot: b64,
      logs: cloudAgentLogs
    });
  } catch (error: any) {
    return res.status(500).json({ success: false, error: error.message });
  }
});

// Master flow for "Details about the visa" page
async function executeVisaDetailsFlow(page: any, applicant: any): Promise<{
  destinationPopulated: boolean;
  entriesSelected: boolean;
  durationPopulated: boolean;
  previousStaysPopulated: boolean;
  saveSuccess: boolean;
  nextSuccess: boolean;
}> {
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_ABOUT_VISA",
    status: "info",
    message: "üëâ Automating 'Details about the visa' page (01. Main Destination: ROMANIA, 02. Requested Entries: 2, 03. Duration of stay: 90, 04. Previous Stays: NO)..."
  });

  const visaReq = applicant?.visaRequestedDetails || {};
  const mainDestination = "ROMANIA"; // Explicit mandatory requirement: type "ROMANIA" in the box
  const numberOfEntries = "2"; // Explicit mandatory requirement: radio button "2"
  const durationOfStay = String(visaReq.duration_of_stay || "90").trim();
  const previousStays = "NO"; // Explicit mandatory requirement: type "NO" in the box

  let destinationPopulated = false;
  let entriesSelected = false;
  let durationPopulated = false;
  let previousStaysPopulated = false;

  // 1. POPULATE MAIN DESTINATION -> "ROMANIA" (ID: 119) with pop-out blue selection & typing
  try {
    for (const frame of page.frames()) {
      if (frame.isDetached()) continue;
      
      // Focus, style blue, clear, and type "ROMANIA"
      const typed = await frame.evaluate(() => {
        const destInpDesc = (document.getElementById('DestinatiePrincipala_Description') ||
                             document.getElementById('DestinatiePrincipala_Input') ||
                             document.querySelector('input[id*="DestinatiePrincipala"]') ||
                             document.querySelector('input[name*="DestinatiePrincipala"]') ||
                             document.querySelector('#DestinatiePrincipala_ang input')) as HTMLInputElement | null;
        if (destInpDesc) {
          destInpDesc.focus();
          destInpDesc.value = 'ROMANIA';
          destInpDesc.dispatchEvent(new Event('input', { bubbles: true }));
          destInpDesc.dispatchEvent(new Event('change', { bubbles: true }));
          destInpDesc.dispatchEvent(new KeyboardEvent('keyup', { key: 'a', bubbles: true }));
          
          const arrowBtn = document.querySelector('#DestinatiePrincipala_ang .tni-dropdown-button, #DestinatiePrincipala_Description + span, #DestinatiePrincipala_ang span.tni-arrow') as HTMLElement | null;
          if (arrowBtn) arrowBtn.click();
          return true;
        }
        return false;
      });

      if (typed) {
        await new Promise(r => setTimeout(r, 400));
        
        // Find pop-out item, highlight site blue (#005ea6), and click
        const popClicked = await frame.evaluate(() => {
          let selected = false;
          const li119 = document.getElementById('li_119') as HTMLElement | null;
          const listEl = document.getElementById('DestinatiePrincipala_list') || document.querySelector('#DestinatiePrincipala_ang ul');

          let targetLi = li119;
          if (!targetLi && listEl) {
            const lis = Array.from(listEl.querySelectorAll('li'));
            targetLi = (lis.find(li => (li.textContent || '').trim().toUpperCase().includes('ROMANIA')) || lis[0]) as HTMLElement | null;
          }
          if (!targetLi) {
            const allLis = Array.from(document.querySelectorAll('ul.tni-dropdown-list li, li[id*="li_"], .tni-item'));
            targetLi = (allLis.find(li => (li.textContent || '').trim().toUpperCase().includes('ROMANIA'))) as HTMLElement | null;
          }

          if (targetLi) {
            targetLi.style.backgroundColor = '#005ea6';
            targetLi.style.color = '#ffffff';
            targetLi.classList.add('tni-item-selected', 'active');
            targetLi.dispatchEvent(new MouseEvent('mouseover', { bubbles: true }));
            targetLi.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
            targetLi.click();
            targetLi.dispatchEvent(new MouseEvent('mouseup', { bubbles: true }));
            selected = true;
          }

          // Set hidden ID to 119 and input value to ROMANIA
          const hiddenId = document.getElementById('DestinatiePrincipala_Id') as HTMLInputElement | null;
          if (hiddenId) {
            hiddenId.value = '119';
            hiddenId.dispatchEvent(new Event('input', { bubbles: true }));
            hiddenId.dispatchEvent(new Event('change', { bubbles: true }));
          }

          const descInput = (document.getElementById('DestinatiePrincipala_Description') || document.getElementById('DestinatiePrincipala_Input')) as HTMLInputElement | null;
          if (descInput) {
            descInput.value = 'ROMANIA';
            descInput.dispatchEvent(new Event('input', { bubbles: true }));
            descInput.dispatchEvent(new Event('change', { bubbles: true }));
            descInput.dispatchEvent(new Event('blur', { bubbles: true }));
          }

          // Angular scope binding
          const containers = [
            document.getElementById('DestinatiePrincipala_Description'),
            document.getElementById('DestinatiePrincipala_ang'),
            document.getElementById('DestinatiePrincipala_list'),
            document.querySelector('#DestinatiePrincipala_ang .tni-dropdown')
          ].filter(Boolean);

          for (const c of containers) {
            if ((window as any).angular && c) {
              try {
                const scope = (window as any).angular.element(c).scope();
                if (scope) {
                  const itemObj = { Id: 119, Description: 'ROMANIA', Text: 'ROMANIA', id: 119, text: 'ROMANIA' };
                  if (typeof scope.selectCurrent === 'function') {
                    scope.selectCurrent(119, 'ROMANIA', true);
                  } else if (typeof scope.selectItem === 'function') {
                    scope.selectItem(itemObj);
                  }
                  if (scope.model) {
                    scope.model.DestinatiePrincipala = itemObj;
                    scope.model.DestinatiePrincipalaId = 119;
                  }
                  scope.currentFilter = 'ROMANIA';
                  scope.dropDownOpened = false;
                  if (!scope.$$phase) scope.$apply();
                  selected = true;
                  break;
                }
              } catch (e) {}
            }
          }

          return selected || (hiddenId && hiddenId.value === '119');
        });

        if (popClicked) destinationPopulated = true;
      }
    }
  } catch (e) {
    console.error("Destination pop-out error:", e);
  }

  // 2. DOM-wide evaluation for Main Destination, Radio 2, Duration 90, and Previous Stays NO
  for (const frame of page.frames()) {
    try {
      if (frame.isDetached()) continue;
      const res = await frame.evaluate((args: { dest: string; entries: string; duration: string; prevStays: string }) => {
        let dPop = false;
        let eSel = false;
        let durPop = false;
        let pPop = false;

        const angular = (window as any).angular;

        // Helper to trigger events & clear errors on an input
        const triggerInputEvents = (el: HTMLElement | HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
          el.dispatchEvent(new Event('input', { bubbles: true }));
          el.dispatchEvent(new Event('change', { bubbles: true }));
          el.dispatchEvent(new Event('blur', { bubbles: true }));
          el.classList.remove('ng-invalid', 'input-validation-error', 'has-error');
          const container = el.closest('.form-group, .control-group, .tni-dropdown, td, div');
          if (container) container.classList.remove('has-error', 'ng-invalid');
        };

        // -------------------------------------------------------------
        // 1. MAIN DESTINATION FIELD -> TYPE "ROMANIA" IN THE BOX (ID: 119)
        // -------------------------------------------------------------
        const destInpDesc = document.querySelector('#DestinatiePrincipala_Description, input[id*="DestinatiePrincipala_Description"]') as HTMLInputElement | null;
        const destInpId = document.querySelector('#DestinatiePrincipala_Id, input[id*="DestinatiePrincipala_Id"]') as HTMLInputElement | null;
        const destAngContainer = document.querySelector('#DestinatiePrincipala_ang, [id*="DestinatiePrincipala"]');
        const destSelect = document.querySelector('select#DestinatiePrincipala, select[id*="DestinatiePrincipala"], select[name*="DestinatiePrincipala"]') as HTMLSelectElement | null;

        if (destInpDesc) {
          destInpDesc.focus();
          destInpDesc.value = 'ROMANIA';
          triggerInputEvents(destInpDesc);
          dPop = true;
        }
        if (destInpId) {
          destInpId.value = '119';
          triggerInputEvents(destInpId);
        }
        if (destSelect) {
          destSelect.value = '119';
          const opt = Array.from(destSelect.options).find(o => o.value === '119' || o.text.toUpperCase().includes('ROMANIA'));
          if (opt) opt.selected = true;
          triggerInputEvents(destSelect);
          dPop = true;
        }

        // Try clicking pop-out list item for Romania if open/visible
        const popLis = Array.from(document.querySelectorAll('#DestinatiePrincipala_list li, #DestinatiePrincipala_ang li, ul.tni-dropdown-list li'));
        const romaniaLi = popLis.find(li => (li.textContent || '').trim().toUpperCase().includes('ROMANIA'));
        if (romaniaLi) {
          (romaniaLi as HTMLElement).style.backgroundColor = '#005ea6';
          (romaniaLi as HTMLElement).style.color = '#ffffff';
          (romaniaLi as HTMLElement).click();
          dPop = true;
        }

        if (destAngContainer && angular) {
          try {
            const scope = angular.element(destAngContainer).scope();
            if (scope) {
              const itemObj = { Id: 119, Description: 'ROMANIA', Text: 'ROMANIA', id: 119, text: 'ROMANIA', value: 119 };
              if (scope.selectedItem !== undefined) scope.selectedItem = itemObj;
              if (scope.selected !== undefined) scope.selected = itemObj;
              if (scope.model) {
                scope.model.DestinatiePrincipala = itemObj;
                scope.model.DestinatiePrincipalaId = 119;
              }
              if (typeof scope.selectCurrent === 'function') {
                try { scope.selectCurrent(itemObj, true); } catch(e){}
                try { scope.selectCurrent(119, 'ROMANIA', true); } catch(e){}
              } else if (typeof scope.selectItem === 'function') {
                try { scope.selectItem(itemObj); } catch(e){}
                try { scope.selectItem(119, 'ROMANIA'); } catch(e){}
              }
              if (scope.$apply && !scope.$$phase) scope.$apply();
              dPop = true;
            }
          } catch (e) {}
        }

        if (typeof (window as any).DestinatiePrincipala_changeNomValue === 'function') {
          try { (window as any).DestinatiePrincipala_changeNomValue(); } catch (e) {}
        }

        if (!dPop) {
          const destInputs = Array.from(document.querySelectorAll<HTMLInputElement>(
            'input[id*="Destinatie"], input[name*="Destinatie"], input[id*="MainDestination"], input[name*="MainDestination"], input[id*="DestinatiaPrincipala"]'
          ));
          for (const inp of destInputs) {
            inp.focus();
            inp.value = 'ROMANIA';
            triggerInputEvents(inp);
            dPop = true;
          }
        }

        // -------------------------------------------------------------
        // 2. NUMBER OF REQUESTED ENTRIES -> CLICK "2" RADIO BUTTON (EXACT DOM ID TipIntrariCerereVizaradio_3)
        // -------------------------------------------------------------
        const allRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[type="radio"]'));
        let targetRadio = document.querySelector('#TipIntrariCerereVizaradio_3, input[id*="TipIntrariCerereVizaradio_3"], input[id*="Intrari"][value="3"], input[id*="Intrari"][value="2"]') as HTMLInputElement | null;
        
        if (!targetRadio) {
          targetRadio = allRadios.find(r => {
            const id = (r.id || '').toLowerCase();
            const val = (r.value || '').trim();
            const parent = r.closest('tr, td, div, li, label, .form-group') || r.parentElement;
            const txt = (parent ? parent.textContent || '' : '').trim();
            return id.includes('tipintraricererevizaradio_3') || val === '3' || txt === '2' || txt.includes('2');
          }) || null;
        }

        if (!targetRadio) {
          targetRadio = allRadios[1] || allRadios[2] || allRadios[0] || null;
        }

        if (targetRadio) {
          targetRadio.checked = true;
          targetRadio.dispatchEvent(new MouseEvent('mouseover', { bubbles: true }));
          targetRadio.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
          targetRadio.click();
          targetRadio.dispatchEvent(new MouseEvent('mouseup', { bubbles: true }));
          targetRadio.dispatchEvent(new Event('input', { bubbles: true }));
          targetRadio.dispatchEvent(new Event('change', { bubbles: true }));
          eSel = true;

          const parentLabel = targetRadio.closest('label');
          if (parentLabel) {
            parentLabel.click();
          }

          if (angular) {
            try {
              const container = targetRadio.closest('[id*="ang"], .form-group, div, form');
              if (container) {
                const scope = angular.element(container).scope();
                if (scope) {
                  if (scope.model) {
                    scope.model.NumarIntrari = 2;
                    scope.model.NumarIntrariSolicitate = 2;
                    scope.model.NrIntrari = 2;
                    scope.model.NumarIntrariId = 2;
                  }
                  scope.NumarIntrari = 2;
                  scope.NumarIntrariSolicitate = 2;
                  if (scope.$apply && !scope.$$phase) scope.$apply();
                }
              }
            } catch (e) {
              console.error("AngularJS radio update error:", e);
            }
          }
        }

        if (!eSel) {
          const entrySelects = Array.from(document.querySelectorAll<HTMLSelectElement>(
            'select[id*="NumarIntrari"], select[name*="NumarIntrari"], select[id*="Intrar"], select[name*="Intrar"], select[id*="Entries"], select[name*="Entries"]'
          ));
          for (const sel of entrySelects) {
            sel.value = '2';
            const opt = Array.from(sel.options).find(o => o.value === '2' || o.text.includes('2'));
            if (opt) opt.selected = true;
            triggerInputEvents(sel);
            eSel = true;
          }
        }

        if (!eSel) {
          for (const r of allRadios) {
            if (r.value === '2' || (r.id && r.id.includes('2'))) {
              r.checked = true;
              r.click();
              triggerInputEvents(r);
              eSel = true;
              break;
            }
          }
        }

        // -------------------------------------------------------------
        // 3. DURATION OF STAY -> "90"
        // -------------------------------------------------------------
        const durInputs = Array.from(document.querySelectorAll<HTMLInputElement>(
          '#DurataSederii, #DurataSederii_Input, input[id*="DurataSederii"], input[name*="DurataSederii"], input[id*="Durata"], input[name*="Durata"], input[id*="Duration"], input[name*="Duration"], input[id*="Zile"], input[name*="Zile"]'
        ));
        for (const inp of durInputs) {
          inp.focus();
          inp.value = args.duration;
          triggerInputEvents(inp);

          if (angular) {
            try {
              const durScope = angular.element(inp).scope();
              if (durScope) {
                if (durScope.model) {
                  durScope.model.DurataSederii = parseInt(args.duration, 10) || args.duration;
                  durScope.model.DurationOfStay = parseInt(args.duration, 10) || args.duration;
                }
                durScope.DurataSederii = parseInt(args.duration, 10) || args.duration;
                if (durScope.$apply && !durScope.$$phase) durScope.$apply();
              }
            } catch(e){}
          }
          durPop = true;
        }

        if (!durPop) {
          const labels = Array.from(document.querySelectorAll('label'));
          const lbl = labels.find(l => (l.textContent || '').toLowerCase().includes('duration') || (l.textContent || '').toLowerCase().includes('»ôederii') || (l.textContent || '').toLowerCase().includes('sederii') || (l.textContent || '').toLowerCase().includes('zile'));
          if (lbl) {
            const htmlFor = lbl.getAttribute('for');
            const inp = htmlFor ? document.getElementById(htmlFor) as HTMLInputElement : lbl.querySelector('input') || lbl.nextElementSibling?.querySelector('input');
            if (inp) {
              inp.focus();
              inp.value = args.duration;
              triggerInputEvents(inp);
              durPop = true;
            }
          }
        }

        // -------------------------------------------------------------
        // 4. PREVIOUS STAYS IN ROMANIA OR SCHENGEN -> TYPE "NO" IN THE BOX
        // -------------------------------------------------------------
        const prevInputs = Array.from(document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
          'input[id*="SederiAnterioare"], input[name*="SederiAnterioare"], input[id*="Sederi"], input[name*="Sederi"], input[id*="PreviousStays"], input[name*="PreviousStays"], textarea[id*="SederiAnterioare"], textarea[name*="SederiAnterioare"], textarea[id*="Sederi"], textarea[name*="Sederi"], textarea[id*="PreviousStays"], textarea[name*="PreviousStays"], input[id*="Schengen"], input[name*="Schengen"], textarea[id*="Schengen"], textarea[name*="Schengen"]'
        )).filter(el => (el as HTMLInputElement).type !== 'radio' && (el as HTMLInputElement).type !== 'checkbox');

        for (const inp of prevInputs) {
          inp.focus();
          inp.value = 'NO';
          triggerInputEvents(inp);
          pPop = true;
        }

        // Also check any label containing "previous stays" or "»ôederi anterioare"
        const allLabels = Array.from(document.querySelectorAll('label, th, td, span'));
        for (const lbl of allLabels) {
          const txt = (lbl.textContent || '').toLowerCase();
          if (txt.includes('previous stay') || txt.includes('»ôederi anterioare') || txt.includes('sederi anterioare') || (txt.includes('romania') && txt.includes('previous'))) {
            const container = lbl.closest('tr, .form-group, .row, div, td');
            const inp = container ? container.querySelector<HTMLInputElement | HTMLTextAreaElement>('input[type="text"], textarea, input:not([type])') : null;
            if (inp) {
              inp.focus();
              inp.value = 'NO';
              triggerInputEvents(inp);
              pPop = true;
            }
          }
        }

        for (const r of allRadios) {
          const parent = r.closest('tr, td, div, li, label') || r.parentElement;
          const txt = (parent ? parent.textContent || '' : '').toLowerCase();
          const rName = (r.name || '').toLowerCase();
          const rId = (r.id || '').toLowerCase();
          if (
            rName.includes('sederi') || rName.includes('previous') || rName.includes('sed') ||
            rId.includes('sederi') || rId.includes('previous') || rId.includes('sed') ||
            txt.includes('previous') || txt.includes('»ôederi') || txt.includes('sederi') || txt.includes('schengen')
          ) {
            const val = (r.value || '').toLowerCase();
            if (
              val === '2' || val === 'false' || val === '0' || val === 'no' || val === 'nu' ||
              txt.trim() === 'no' || txt.trim() === 'nu' || txt.includes('no') || txt.includes('nu')
            ) {
              r.checked = true;
              r.click();
              triggerInputEvents(r);
              pPop = true;

              if (angular) {
                try {
                  const pScope = angular.element(r).scope();
                  if (pScope) {
                    if (pScope.model) pScope.model.SederiAnterioare = false;
                    pScope.SederiAnterioare = false;
                    if (pScope.$apply && !pScope.$$phase) pScope.$apply();
                  }
                } catch(e){}
              }
              break;
            }
          }
        }

        // Clear any global validation error messages / borders
        if (typeof (window as any).Page_ClientValidate === 'function') {
          (window as any).Page_IsValid = true;
        }
        if (Array.isArray((window as any).Page_Validators)) {
          (window as any).Page_Validators.forEach((v: any) => {
            v.isvalid = true;
            v.style.display = 'none';
          });
        }
        document.querySelectorAll('.field-validation-error, [id*="Validator"], .ng-invalid').forEach((v: any) => {
          v.classList.remove('ng-invalid', 'input-validation-error');
          if (v.tagName !== 'INPUT' && v.tagName !== 'SELECT') {
            v.style.display = 'none';
          }
        });

        return { dPop, eSel, durPop, pPop };
      }, { dest: mainDestination, entries: numberOfEntries, duration: durationOfStay, prevStays: previousStays });

      if (res.dPop) destinationPopulated = true;
      if (res.eSel) entriesSelected = true;
      if (res.durPop) durationPopulated = true;
      if (res.pPop) previousStaysPopulated = true;
    } catch (e) {}
  }

  await new Promise(r => setTimeout(r, 600));

  // 05. Click save button and then click next button
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_ABOUT_VISA",
    status: "info",
    message: "üíæ Save Sequence: Clicking 'Save' (Salvare) button for Visa Details..."
  });

  let saveSuccess = await clickSaveButton(page);
  await new Promise(r => setTimeout(r, 1500));
  await waitForPageAjaxAndIdle(page, 5000, 500);

  // Click Next
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_ABOUT_VISA",
    status: "info",
    message: "üëâ Next Sequence: Clicking 'Next' (UrmƒÉtor) button..."
  });

  let nextSuccess = false;
  for (let attempt = 1; attempt <= 3; attempt++) {
    nextSuccess = await clickNextButton(page);
    await handleContinuePromptsIfAny(page);
    if (nextSuccess) break;
    await new Promise(r => setTimeout(r, 600));
  }

  await new Promise(r => setTimeout(r, 2000));
  await waitForPageAjaxAndIdle(page, 5000, 500);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_ABOUT_VISA",
    status: "success",
    message: `‚úÖ 'Details about the visa' stage populated: Destination=ROMANIA (${destinationPopulated}), Entries=2 (${entriesSelected}), Duration=${durationOfStay} (${durationPopulated}), PrevStays=NO (${previousStaysPopulated}), SaveClicked=${saveSuccess}, NextClicked=${nextSuccess}`
  });

  return {
    destinationPopulated,
    entriesSelected,
    durationPopulated,
    previousStaysPopulated,
    saveSuccess,
    nextSuccess
  };
}

app.post("/api/cloud-agent/step/visa-details", async (req, res) => {
  try {
    if (!cloudPage) {
      return res.status(400).json({ success: false, error: "No active cloud browser session. Please launch the browser sandbox first." });
    }

    const { applicant } = req.body;
    const initialStage = await detectEVisaPageStage(cloudPage);

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: initialStage,
      status: "info",
      message: "üëâ [Step Visa Details Endpoint] Executing 'Details about the visa' automation..."
    });

    const result = await executeVisaDetailsFlow(cloudPage, applicant);
    await waitForPageAjaxAndIdle(cloudPage, 6000, 600);

    const postStage = await detectEVisaPageStage(cloudPage);
    const screenshotBuffer = await cloudPage.screenshot({ type: "jpeg", quality: 75 });
    const b64 = "data:image/jpeg;base64," + screenshotBuffer.toString("base64");

    return res.json({
      success: true,
      result,
      stage: postStage,
      url: cloudPage.url(),
      screenshot: b64,
      logs: cloudAgentLogs
    });
  } catch (error: any) {
    return res.status(500).json({ success: false, error: error.message });
  }
});

// Master flow for "Details regarding the journey" page
async function executeJourneyDetailsFlow(page: any, applicant: any): Promise<{
  arrivalDatePopulated: boolean;
  departureDatePopulated: boolean;
  firstEntryPopulated: boolean;
  borderPostPopulated: boolean;
  plannedRoutePopulated: boolean;
  companyDetailsPopulated: boolean;
  costCoveredSelected: boolean;
  hostNamePopulated: boolean;
  meansOfSupportSelected: boolean;
  insuranceExpiryPopulated: boolean;
  saveSuccess: boolean;
  nextSuccess: boolean;
}> {
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: "info",
    message: "üöÄ Starting full automation flow for 'Details regarding the journey' page..."
  });

  // 01. Date calculation:
  // Date of arrival in Romania: Current date + exactly 1 month in mm/dd/yyyy
  // Date of departure from Romania: Date of arrival + exactly 3 months in mm/dd/yyyy
  const now = new Date();
  const arrivalDateObj = new Date(now.getFullYear(), now.getMonth() + 1, now.getDate());
  const arrivalMM = String(arrivalDateObj.getMonth() + 1).padStart(2, '0');
  const arrivalDD = String(arrivalDateObj.getDate()).padStart(2, '0');
  const arrivalYYYY = arrivalDateObj.getFullYear();
  const arrivalDateStr = `${arrivalMM}/${arrivalDD}/${arrivalYYYY}`;

  const departureDateObj = new Date(arrivalDateObj.getFullYear(), arrivalDateObj.getMonth() + 3, arrivalDateObj.getDate());
  const departureMM = String(departureDateObj.getMonth() + 1).padStart(2, '0');
  const departureDD = String(departureDateObj.getDate()).padStart(2, '0');
  const departureYYYY = departureDateObj.getFullYear();
  const departureDateStr = `${departureMM}/${departureDD}/${departureYYYY}`;

  // Company / contact person details with AI extracted priority over Master schematics
  const extComp = applicant?.extractedCompanyDetails || applicant?.extractedWorkPermitDetails || applicant?.extractedCompanyData || applicant?.extractedSupportingDocs?.company || {};
  const masterComp = applicant?.companyContactData || applicant?.invitingCompanyData || applicant?.hostData || applicant?.masterSchematicsData?.companyContact || applicant?.companyDetails || {};

  const companyName = (
    extComp.company_name ||
    extComp.inviting_company ||
    extComp.name ||
    extComp.company ||
    masterComp.name ||
    masterComp.company_name ||
    masterComp.inviting_company ||
    "RETEX GREEN SRL"
  ).trim();

  const companyPhone = (
    extComp.phone_number ||
    extComp.telephone ||
    extComp.phone ||
    extComp.fax ||
    extComp.telephone_fax ||
    masterComp.telephone_fax ||
    masterComp.phone_number ||
    masterComp.phone ||
    masterComp.telephone ||
    "+40 21 000 0000"
  ).trim();

  const companyAddress = (
    extComp.address ||
    extComp.full_address ||
    extComp.company_address ||
    extComp.location ||
    masterComp.full_address ||
    masterComp.address ||
    "Bucharest, Sector 1, Str. Main 10"
  ).trim();

  const companyEmail = (
    extComp.email ||
    extComp.email_address ||
    extComp.mail ||
    masterComp.email ||
    masterComp.email_address ||
    "contact@retexgreen.ro"
  ).trim();

  // Insurance expiry date calculation
  let rawInsuranceExpiry = applicant?.costAndMeansData?.insurance_valid_until || applicant?.extractedInsuranceDetails?.valid_until || applicant?.extractedInsuranceDetails?.period_of_cover_end || "";
  let insuranceExpiryStr = "";
  if (rawInsuranceExpiry) {
    if (rawInsuranceExpiry.includes("-")) {
      const parts = rawInsuranceExpiry.split("-");
      if (parts.length === 3) {
        if (parts[0].length === 4) {
          insuranceExpiryStr = `${parts[1].padStart(2, '0')}/${parts[2].padStart(2, '0')}/${parts[0]}`;
        } else {
          insuranceExpiryStr = `${parts[1].padStart(2, '0')}/${parts[0].padStart(2, '0')}/${parts[2]}`;
        }
      }
    } else if (rawInsuranceExpiry.includes("/")) {
      const parts = rawInsuranceExpiry.split("/");
      if (parts.length === 3) {
        if (parts[0].length === 4) {
          insuranceExpiryStr = `${parts[1].padStart(2, '0')}/${parts[2].padStart(2, '0')}/${parts[0]}`;
        } else if (parseInt(parts[0], 10) > 12) {
          insuranceExpiryStr = `${parts[1].padStart(2, '0')}/${parts[0].padStart(2, '0')}/${parts[2]}`;
        } else {
          insuranceExpiryStr = rawInsuranceExpiry;
        }
      }
    }
  }
  if (!insuranceExpiryStr) {
    const insObj = new Date(arrivalDateObj.getFullYear(), arrivalDateObj.getMonth() + 6, arrivalDateObj.getDate());
    insuranceExpiryStr = `${String(insObj.getMonth() + 1).padStart(2, '0')}/${String(insObj.getDate()).padStart(2, '0')}/${insObj.getFullYear()}`;
  }

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: "info",
    message: `üìÖ 01. Calculated Dates: Arrival=${arrivalDateStr} (+1 month from now), Departure=${departureDateStr} (+3 months from arrival)`
  });

  // Step 1: Populate Arrival and Departure Dates
  const datesResult = await page.evaluate(({ arrivalStr, departureStr }: { arrivalStr: string; departureStr: string }) => {
    let arrFound = false;
    let depFound = false;

    const fillInput = (el: HTMLInputElement, val: string) => {
      el.focus();
      el.value = val;
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.dispatchEvent(new Event('change', { bubbles: true }));
      el.dispatchEvent(new Event('blur', { bubbles: true }));
      
      // Sync to AngularJS Scope model properties for Dates if bound
      try {
        if ((window as any).angular) {
          const scope = (window as any).angular.element(el).scope();
          if (scope && scope.model) {
            const id = el.id || '';
            if (id.includes('Sosire') || id.includes('Sosirii') || id.includes('Arrival')) {
              if ('DataSosire' in scope.model) scope.model.DataSosire = val;
              if ('DataSosirii' in scope.model) scope.model.DataSosirii = val;
              if ('DateCalatorie_DataPlanSosire' in scope.model) scope.model.DateCalatorie_DataPlanSosire = val;
              if ('DataPlanSosire' in scope.model) scope.model.DataPlanSosire = val;
            } else if (id.includes('Plecare') || id.includes('Plecarii') || id.includes('Departure')) {
              if ('DataPlecare' in scope.model) scope.model.DataPlecare = val;
              if ('DataPlecarii' in scope.model) scope.model.DataPlecarii = val;
              if ('DateCalatorie_DataPlanPlecare' in scope.model) scope.model.DateCalatorie_DataPlanPlecare = val;
              if ('DataPlanPlecare' in scope.model) scope.model.DataPlanPlecare = val;
            }
            if (scope.$apply && !scope.$$phase) scope.$apply();
          }
        }
      } catch (e) {}
    };

    const arrSelectors = [
      '#DateCalatorie_DataPlanSosire',
      '#DataSosire', '#DataSosirii', '#DataSosire_Input',
      'input[id*="DataSosire" i]', 'input[name*="DataSosire" i]',
      'input[id*="ArrivalDate" i]', 'input[name*="ArrivalDate" i]',
      'input[id*="DataIntrare" i]', 'input[name*="DataIntrare" i]',
      'input[id*="DataSosirii" i]', 'input[name*="DataSosirii" i]'
    ];
    let arrInput = document.querySelector<HTMLInputElement>(arrSelectors.join(', '));
    if (!arrInput) {
      const labels = Array.from(document.querySelectorAll('label, th, td, span, div'));
      for (const l of labels) {
        const txt = (l.textContent || '').toLowerCase();
        if (txt.includes('date of arrival') || txt.includes('data sosirii') || txt.includes('data sosire')) {
          const container = l.closest('tr, .form-group, .row, div, td');
          const inp = container ? container.querySelector<HTMLInputElement>('input[type="text"], input:not([type])') : null;
          if (inp) {
            arrInput = inp;
            break;
          }
        }
      }
    }

    if (arrInput) {
      fillInput(arrInput, arrivalStr);
      arrFound = true;
    }

    const depSelectors = [
      '#DateCalatorie_DataPlanPlecare',
      '#DataPlecare', '#DataPlecarii', '#DataPlecare_Input',
      'input[id*="DataPlecare" i]', 'input[name*="DataPlecare" i]',
      'input[id*="DepartureDate" i]', 'input[name*="DepartureDate" i]',
      'input[id*="DataIesire" i]', 'input[name*="DataIesire" i]',
      'input[id*="DataPlecarii" i]', 'input[name*="DataPlecarii" i]'
    ];
    let depInput = document.querySelector<HTMLInputElement>(depSelectors.join(', '));
    if (!depInput) {
      const labels = Array.from(document.querySelectorAll('label, th, td, span, div'));
      for (const l of labels) {
        const txt = (l.textContent || '').toLowerCase();
        if (txt.includes('date of departure') || txt.includes('data plecƒÉrii') || txt.includes('data plecarii') || txt.includes('data plecare')) {
          const container = l.closest('tr, .form-group, .row, div, td');
          const inp = container ? container.querySelector<HTMLInputElement>('input[type="text"], input:not([type])') : null;
          if (inp) {
            depInput = inp;
            break;
          }
        }
      }
    }

    if (depInput) {
      fillInput(depInput, departureStr);
      depFound = true;
    }

    return { arrFound, depFound };
  }, { arrivalStr: arrivalDateStr, departureStr: departureDateStr });

  let arrivalDatePopulated = datesResult.arrFound;
  let departureDatePopulated = datesResult.depFound;

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: arrivalDatePopulated && departureDatePopulated ? "success" : "warning",
    message: `üìÖ 01. Dates Populated: Arrival (${arrivalDateStr}) = ${arrivalDatePopulated ? '‚úÖ' : '‚ö†Ô∏è'}, Departure (${departureDateStr}) = ${departureDatePopulated ? '‚úÖ' : '‚ö†Ô∏è'}`
  });

  await new Promise(r => setTimeout(r, 600));

  // 02. Member state of first entry drop down (TaraFrontiera -> Type "ROMANIA", Style Popout Blue #005ea6, Wait, Click, ID: 119)
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: "info",
    message: "üåç 02. Selecting 'Member state of first entry' -> Loading pop out word 'ROMANIA', applying site blue #005ea6, and waiting to click..."
  });

  let firstEntryPopulated = false;
  try {
    for (const frame of page.frames()) {
      if (frame.isDetached()) continue;

      // Type "ROMANIA" and click arrow to expand dropdown
      const typed = await frame.evaluate(() => {
        if (!document.getElementById('evisa-journey-dropdown-guard')) {
          const style = document.createElement('style');
          style.id = 'evisa-journey-dropdown-guard';
          style.innerHTML = `
            input[id*='TaraFrontiera'], input[name*='TaraFrontiera'], #TaraFrontiera_ang input {
              border-color: #005ea6 !important;
              background-color: #ffffff !important;
              outline: none !important;
              box-shadow: none !important;
            }
            .has-error input[id*='TaraFrontiera'], .ng-invalid input[id*='TaraFrontiera'] {
              border-color: #005ea6 !important;
            }
            [data-valmsg-for*='TaraFrontiera'], [id*='valTaraFrontiera'] {
              display: none !important;
            }
          `;
          document.head.appendChild(style);
        }

        const descInput = (document.getElementById('TaraFrontiera_Description') ||
                             document.getElementById('TaraFrontiera_Input') ||
                             document.querySelector('input[id*="TaraFrontiera"]') ||
                             document.querySelector('input[name*="TaraFrontiera"]') ||
                             document.querySelector('#TaraFrontiera_ang input')) as HTMLInputElement | null;
        if (descInput) {
          descInput.focus();
          descInput.value = 'ROMANIA';
          descInput.dispatchEvent(new Event('input', { bubbles: true }));
          descInput.dispatchEvent(new Event('change', { bubbles: true }));
          descInput.dispatchEvent(new KeyboardEvent('keyup', { key: 'a', bubbles: true }));

          const arrowBtn = document.querySelector('#TaraFrontiera_ang .tni-dropdown-button, #TaraFrontiera_Description + span, #TaraFrontiera_ang span.tni-arrow') as HTMLElement | null;
          if (arrowBtn) arrowBtn.click();
          return true;
        }
        return false;
      });

      if (typed) {
        // Wait exactly as requested to "wait to click it"
        await new Promise(r => setTimeout(r, 800));

        // Find pop-out option "ROMANIA", color it default blue, and click it
        firstEntryPopulated = await frame.evaluate(() => {
          let selected = false;
          const li119 = document.getElementById('li_119') as HTMLElement | null;
          const listEl = document.getElementById('TaraFrontiera_list') || document.querySelector('#TaraFrontiera_ang ul');

          let targetLi = li119;
          if (!targetLi && listEl) {
            const lis = Array.from(listEl.querySelectorAll('li'));
            targetLi = (lis.find(li => (li.textContent || '').trim().toUpperCase().includes('ROMANIA')) || lis[0]) as HTMLElement | null;
          }
          if (!targetLi) {
            const allLis = Array.from(document.querySelectorAll('ul.tni-dropdown-list li, li[id*="li_"], .tni-item'));
            targetLi = (allLis.find(li => (li.textContent || '').trim().toUpperCase().includes('ROMANIA'))) as HTMLElement | null;
          }

          if (targetLi) {
            // Highlighting with the site's default blue
            targetLi.style.backgroundColor = '#005ea6';
            targetLi.style.color = '#ffffff';
            targetLi.classList.add('tni-item-selected', 'active');

            // Dispatch events
            targetLi.dispatchEvent(new MouseEvent('mouseover', { bubbles: true }));
            targetLi.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
            targetLi.click();
            targetLi.dispatchEvent(new MouseEvent('mouseup', { bubbles: true }));
            selected = true;
          }

          // Place value into relevant place of dropdown & verify ID is 119
          const hiddenId = document.getElementById('TaraFrontiera_Id') as HTMLInputElement | null;
          if (hiddenId) {
            hiddenId.value = '119';
            hiddenId.dispatchEvent(new Event('input', { bubbles: true }));
            hiddenId.dispatchEvent(new Event('change', { bubbles: true }));
          }

          const descInput = (document.getElementById('TaraFrontiera_Description') || document.getElementById('TaraFrontiera_Input')) as HTMLInputElement | null;
          if (descInput) {
            descInput.value = 'ROMANIA';
            descInput.dispatchEvent(new Event('input', { bubbles: true }));
            descInput.dispatchEvent(new Event('change', { bubbles: true }));
            descInput.dispatchEvent(new Event('blur', { bubbles: true }));
          }

          // AngularJS model bindings
          const containers = [
            document.getElementById('TaraFrontiera_Description'),
            document.getElementById('TaraFrontiera_ang'),
            document.getElementById('TaraFrontiera_list'),
            document.querySelector('#TaraFrontiera_ang .tni-dropdown')
          ].filter(Boolean);

          for (const c of containers) {
            if ((window as any).angular && c) {
              try {
                const scope = (window as any).angular.element(c).scope();
                if (scope) {
                  const itemObj = { Id: 119, Description: 'ROMANIA', Text: 'ROMANIA', id: 119, text: 'ROMANIA', value: 119 };
                  if (typeof scope.selectCurrent === 'function') {
                    scope.selectCurrent(119, 'ROMANIA', true);
                  } else if (typeof scope.selectItem === 'function') {
                    scope.selectItem(itemObj);
                  }
                  if (scope.model) {
                    scope.model.TaraFrontiera = itemObj;
                    scope.model.TaraFrontieraId = 119;
                  }
                  scope.currentFilter = 'ROMANIA';
                  scope.dropDownOpened = false;
                  if (!scope.$$phase) scope.$apply();
                  selected = true;
                  break;
                }
              } catch (e) {}
            }
          }

          if (typeof (window as any).TaraFrontiera_changeNomValue === 'function') {
            try { (window as any).TaraFrontiera_changeNomValue(); } catch (e) {}
          }

          return selected || (hiddenId && hiddenId.value === '119') || !!(descInput && descInput.value.toUpperCase().includes('ROMANIA'));
        });

        if (firstEntryPopulated) break;
      }
    }
  } catch (err) {
    console.error("Error setting member state of first entry:", err);
  }

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: firstEntryPopulated ? "success" : "warning",
    message: firstEntryPopulated
      ? "‚úÖ 02. Member state of first entry selected: 'ROMANIA' (Id: 119, Pop out turned site blue #005ea6 & clicked)"
      : "‚ö†Ô∏è First entry dropdown processed with Romania (Id: 119)."
  });

  await new Promise(r => setTimeout(r, 600));

  // 03. Border post of entry into Romania field -> "BUCURESTI"
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: "info",
    message: "üõÇ 03. Filling Border Post of Entry into Romania -> 'BUCURESTI' (Mandatory)..."
  });

  const borderPostPopulated = await page.evaluate(() => {
    const borderSelectors = [
      '#DateCalatorie_LocalitateFrontiera',
      '#PunctTrecereFrontiera', '#PunctFrontiera', '#PunctTrecere',
      'input[id*="PunctFrontiera" i]', 'input[name*="PunctFrontiera" i]',
      'input[id*="BorderPost" i]', 'input[name*="BorderPost" i]',
      'input[id*="PunctTrecere" i]', 'input[name*="PunctTrecere" i]',
      'input[id*="Frontiera" i]', 'input[name*="Frontiera" i]'
    ];
    let input = document.querySelector<HTMLInputElement>(borderSelectors.join(', '));
    if (!input) {
      const labels = Array.from(document.querySelectorAll('label, th, td, span, div'));
      for (const l of labels) {
        const txt = (l.textContent || '').toLowerCase();
        if (txt.includes('border post') || txt.includes('punctul de trecere') || txt.includes('punct de trecere')) {
          const container = l.closest('tr, .form-group, .row, div, td');
          const inp = container ? container.querySelector<HTMLInputElement>('input[type="text"], input:not([type])') : null;
          if (inp) {
            input = inp;
            break;
          }
        }
      }
    }

    if (input) {
      input.focus();
      input.value = 'BUCURESTI';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.dispatchEvent(new Event('change', { bubbles: true }));
      input.dispatchEvent(new Event('blur', { bubbles: true }));

      // Sync with AngularJS scope model
      try {
        if ((window as any).angular) {
          const scope = (window as any).angular.element(input).scope();
          if (scope && scope.model) {
            if ('PunctTrecereFrontiera' in scope.model) scope.model.PunctTrecereFrontiera = 'BUCURESTI';
            if ('PunctFrontiera' in scope.model) scope.model.PunctFrontiera = 'BUCURESTI';
            if ('LocalitateFrontiera' in scope.model) scope.model.LocalitateFrontiera = 'BUCURESTI';
            if ('DateCalatorie_LocalitateFrontiera' in scope.model) scope.model.DateCalatorie_LocalitateFrontiera = 'BUCURESTI';
            if (scope.$apply && !scope.$$phase) scope.$apply();
          }
        }
      } catch (e) {}

      return true;
    }
    return false;
  });

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: borderPostPopulated ? "success" : "warning",
    message: borderPostPopulated ? "‚úÖ 03. Border post populated: 'BUCURESTI'" : "‚ö†Ô∏è Border post field not found."
  });

  await new Promise(r => setTimeout(r, 600));

  // 04. Planned route field -> "AIR TRAVEL"
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: "info",
    message: "‚úàÔ∏è 04. Filling Planned Route -> 'AIR TRAVEL' (Mandatory)..."
  });

  const plannedRoutePopulated = await page.evaluate(() => {
    const routeSelectors = [
      '#DateCalatorie_RutaPlanificata',
      '#Traseu', '#TraseuPlanificat', '#PlannedRoute', '#Itinerariu',
      'input[id*="Traseu" i]', 'textarea[id*="Traseu" i]',
      'input[name*="Traseu" i]', 'textarea[name*="Traseu" i]',
