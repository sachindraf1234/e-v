// Helper function to assemble python playwright script matching screenshots & ocr
function generatePlaywrightPythonCode(applicant: any, config: any): string {
  const targetMode = config?.targetMode || "FULL_PIPELINE";
  const port = config?.chromePort || 9222;
  const host = config?.chromeHost || "127.0.0.1";

  const spouse = applicant?.spouseData || {};
  const hostInfo = applicant?.hostData || {};
  const company = applicant?.companyContactData || {};
  const visaReq = applicant?.visaRequestedDetails || {};
  const costMeans = applicant?.costAndMeansData || {};
  const journey = applicant?.journeyDetailsData || {};
  const addr = applicant?.addressData || {};
  const personal = applicant?.personalData || {};
  const travel = applicant?.travelDoc || {};
  const sel = applicant?.selection || {};
  const family = applicant?.familyData || {};
  const civilStatus = applicant?.applicant_civil_status || "Married";
  const fileNumber = applicant?.fileNumber || "E25110721257414";

  const pyStr = (val: any, fallback: string = "") => {
    const s = (val !== undefined && val !== null && String(val).trim() !== "") ? String(val) : fallback;
    return s.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, ' ').replace(/\r/g, '');
  };

  return `import os
import sys
import time
import subprocess
import platform
import socket
import urllib.request
import json
import base64

SERVER_URL = "${pyStr(config?.serverUrl, "")}"

def sync_to_dashboard(stage_name, status, message, append_log=None):
    if not SERVER_URL:
        return
    try:
        screenshot_b64 = None
        global page
        if 'page' in globals() and page is not None:
            try:
                page.screenshot(path="sync_temp.png")
                with open("sync_temp.png", "rb") as f:
                    screenshot_b64 = "data:image/png;base64," + base64.b64encode(f.read()).decode('utf-8')
                os.remove("sync_temp.png")
            except Exception:
                pass
        
        req = urllib.request.Request(
            f"{SERVER_URL.rstrip('/')}/api/agent/sync",
            data=json.dumps({
                "status": status,
                "currentStage": stage_name,
                "message": message,
                "screenshot": screenshot_b64,
                "appendLog": append_log or message
            }).encode('utf-8'),
            headers={'Content-Type': 'application/json'}
        )
        with urllib.request.urlopen(req, timeout=3) as r:
            r.read()
    except Exception:
        pass

def safe_exit(code=0):
    sync_to_dashboard("SYSTEM", "idle", "Browser agent stopped or exited.")
    print()
    print("="*80)
    input("üëâ Press [ENTER] to exit the automation script and close this terminal window...")
    sys.exit(code)

try:
    from playwright.sync_api import sync_playwright, TimeoutError as PWTimeout
except ImportError as err:
    print()
    print("="*80)
    print(" [ERROR] MISSING REQUIRED PYTHON LIBRARIES!")
    print("="*80)
    print(" Run: pip install playwright python-dotenv")
    print("      python -m playwright install chromium")
    print("="*80)
    safe_exit(1)

TARGET_MODE = "${pyStr(targetMode, "FULL_PIPELINE")}"
TARGET_APPLICATION_URL = "${pyStr(config?.targetApplicationUrl, "")}"
VERIFICATION_LINK = "${pyStr(config?.verificationLink, "")}"

AI_EXTRACTED_PERSONAL_DATA = {
    "surname": "${pyStr(personal.surname, "PERERA")}",
    "first_names": "${pyStr(personal.first_names, "ANUSHKA DILHANI")}",
    "surname_at_birth": "${pyStr(personal.surname_at_birth, "PERERA")}",
    "dob_day": "${pyStr(personal.dob_day, "10")}",
