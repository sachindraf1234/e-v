app.post("/api/cloud-agent/step/supporting-documents", async (req, res) => {
  try {
    if (!cloudPage) {
      return res.status(400).json({ success: false, error: "No active cloud browser session" });
    }

    const { applicant } = req.body || {};

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "SUPPORTING_DOCUMENTS_PAGE",
      status: "info",
      message: "üëâ [Step 7] Automating 'Required Supporting Documents' page (Uploading 6 documents, Declaration Checkbox, Save & Next)..."
    });

    const results = await executeSupportingDocumentsFlow(cloudPage, applicant);

    const screenshotBuffer = await cloudPage.screenshot({ type: "jpeg", quality: 75 });
    const b64 = "data:image/jpeg;base64," + screenshotBuffer.toString("base64");
    const currentStage = await detectEVisaPageStage(cloudPage);

    return res.json({
      success: true,
      results,
      stage: currentStage,
      url: cloudPage.url(),
      screenshot: b64,
      logs: cloudAgentLogs
    });
  } catch (err: any) {
    console.error("Supporting Documents Flow Error:", err);
    return res.status(500).json({ success: false, error: err.message });
  }
});

