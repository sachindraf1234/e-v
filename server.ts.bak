// Dedicated Single Document Upload Endpoint (e.g. upload just Work Permit or Means of Support)
app.post("/api/cloud-agent/step/upload-single-document", async (req, res) => {
  try {
    if (!cloudPage) {
      return res.status(400).json({ success: false, error: "No active cloud browser session" });
    }

    const { docKey, applicant, customFileDataUrl, customFileName } = req.body || {};
    const def = SUPPORTING_DOCUMENT_DEFINITIONS.find((d) => d.key === docKey || d.order === Number(docKey));

    if (!def) {
      return res.status(400).json({ success: false, error: `Invalid docKey: ${docKey}` });
    }

    const filesMap = ensureSupportingDocumentFiles(applicant);
    let targetFilePath = filesMap[def.key]?.path || path.join(SUPPORTING_DOCS_DIR, def.defaultFileName);

    if (customFileDataUrl && customFileDataUrl.includes(",")) {
      try {
        const base64Data = customFileDataUrl.split(",")[1];
        const buffer = Buffer.from(base64Data, "base64");
        const safeName = customFileName || def.defaultFileName;
        targetFilePath = path.join(SUPPORTING_DOCS_DIR, safeName);
        fs.writeFileSync(targetFilePath, buffer);
      } catch (e) {
        console.warn("Error saving custom file data:", e);
      }
    }

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "SUPPORTING_DOCUMENTS_PAGE",
      status: "info",
      message: `üì§ Uploading single document: [${def.label}] (${path.basename(targetFilePath)})...`
    });

    const result = await uploadSupportingDocSection(cloudPage, def, targetFilePath);

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "SUPPORTING_DOCUMENTS_PAGE",
      status: result.success ? "success" : "warning",
      message: result.success
        ? `‚úÖ [${def.label}] File upload confirmed and attached!`
        : `‚ö†Ô∏è [${def.label}] Upload request dispatched.`
    });

    const screenshotBuffer = await cloudPage.screenshot({ type: "jpeg", quality: 75 });
    const b64 = "data:image/jpeg;base64," + screenshotBuffer.toString("base64");
    const currentStage = await detectEVisaPageStage(cloudPage);

    return res.json({
      success: result.success,
      alreadyUploaded: result.alreadyUploaded,
      fileName: result.fileName,
      docKey: def.key,
      docLabel: def.label,
      stage: currentStage,
      url: cloudPage.url(),
      screenshot: b64,
      logs: cloudAgentLogs
    });
  } catch (err: any) {
    console.error("Upload single document error:", err);
    return res.status(500).json({ success: false, error: err.message });
  }
});

// Endpoint alias for backward compatibility: select-visa-type
app.post("/api/cloud-agent/select-visa-type", async (req, res) => {
