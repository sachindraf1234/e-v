      message: "Targeting 'Select visa type' page. Selecting 'Long-stay visa' radio option..."
    });

    const selected = await selectLongStayVisa(cloudPage);
    await new Promise((resolve) => setTimeout(resolve, 3500));
    const nextClicked = await clickNextButton(cloudPage);
    await new Promise((resolve) => setTimeout(resolve, 4000));

