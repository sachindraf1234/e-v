    status: "info",
    message: `üè¢ 05. Filling inviting company details (Name: "${companyName}", Phone: "${companyPhone}", Address: "${companyAddress}", Email: "${companyEmail}") with AI extracted priority...`
  });

  const companyDetailsPopulated = await page.evaluate(({ name, phone, addr, email }: { name: string; phone: string; addr: string; email: string }) => {
    let filledCount = 0;
    const fill = (el: HTMLInputElement | HTMLTextAreaElement, val: string, propKeys: string[]) => {
      el.focus();
      el.value = val;
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.dispatchEvent(new Event('change', { bubbles: true }));
      el.dispatchEvent(new Event('blur', { bubbles: true }));
      
      try {
        if ((window as any).angular) {
          const scope = (window as any).angular.element(el).scope();
          if (scope && scope.model) {
            for (const key of propKeys) {
              if (key in scope.model) scope.model[key] = val;
            }
            if (scope.$apply && !scope.$$phase) scope.$apply();
          }
        }
      } catch (e) {}
      
      filledCount++;
    };

    // 1. Company Name / Contact Person Name
    const nameSelectors = [
      'input[id*="NumeCompanie" i]', 'input[name*="NumeCompanie" i]',
      'input[id*="CompanyContact_Nume" i]', 'input[name*="CompanyContact_Nume" i]',
      'input[id*="NumePersoanaContact" i]', 'input[name*="NumePersoanaContact" i]',
      'input[id*="ContactPerson" i]', 'input[name*="ContactPerson" i]',
      'input[id*="DenumireCompanie" i]', 'input[name*="DenumireCompanie" i]'
    ];
    let nameEl = document.querySelector<HTMLInputElement>(nameSelectors.join(', '));
    if (!nameEl) {
      const labels = Array.from(document.querySelectorAll('label, th, td, span, div'));
      for (const l of labels) {
        const txt = (l.textContent || '').toLowerCase();
        if ((txt.includes('name of the company') || txt.includes('numele companiei') || txt.includes('persoanƒÉ de contact') || txt.includes('contact person')) && !txt.includes('host') && !txt.includes('gazdƒÉ') && !txt.includes('gazda')) {
          const container = l.closest('tr, .form-group, .row, div, td');
          const inp = container ? container.querySelector<HTMLInputElement>('input[type="text"], input:not([type])') : null;
          if (inp) {
            nameEl = inp;
            break;
          }
        }
      }
    }
    if (nameEl) fill(nameEl, name, ['NumeCompanie', 'CompanyContact_Nume', 'NumePersoanaContact', 'ContactPerson', 'DenumireCompanie']);

    // 2. Telephone / Fax
    const phoneSelectors = [
      'input[id*="Telefon" i]', 'input[name*="Telefon" i]',
      'input[id*="Phone" i]', 'input[name*="Phone" i]',
      'input[id*="Telephone" i]', 'input[name*="Telephone" i]',
      'input[id*="CompanyContact_Telefon" i]', 'input[name*="CompanyContact_Telefon" i]'
    ];
    let phoneEl = document.querySelector<HTMLInputElement>(phoneSelectors.join(', '));
    if (!phoneEl) {
      const labels = Array.from(document.querySelectorAll('label, th, td, span, div'));
      for (const l of labels) {
        const txt = (l.textContent || '').toLowerCase();
        if (txt.includes('telephone') || txt.includes('telefon') || txt.includes('phone') || txt.includes('fax')) {
          const container = l.closest('tr, .form-group, .row, div, td');
          const inp = container ? container.querySelector<HTMLInputElement>('input[type="text"], input[type="tel"], input:not([type])') : null;
          if (inp) {
            phoneEl = inp;
            break;
          }
        }
      }
    }
    if (phoneEl) fill(phoneEl, phone, ['Telefon', 'CompanyContact_Telefon', 'Phone', 'Telephone']);

    // 3. Full Address
    const addrSelectors = [
      'input[id*="Adresa" i]', 'textarea[id*="Adresa" i]',
      'input[name*="Adresa" i]', 'textarea[name*="Adresa" i]',
      'input[id*="Address" i]', 'textarea[id*="Address" i]',
      'input[name*="Address" i]', 'textarea[name*="Address" i]',
      'input[id*="CompanyContact_Adresa" i]', 'textarea[id*="CompanyContact_Adresa" i]'
    ];
    let addrEl = document.querySelector<HTMLInputElement | HTMLTextAreaElement>(addrSelectors.join(', '));
    if (!addrEl) {
      const labels = Array.from(document.querySelectorAll('label, th, td, span, div'));
      for (const l of labels) {
        const txt = (l.textContent || '').toLowerCase();
        if (txt.includes('full address') || txt.includes('adresa completƒÉ') || txt.includes('adresa')) {
          const container = l.closest('tr, .form-group, .row, div, td');
          const inp = container ? container.querySelector<HTMLInputElement | HTMLTextAreaElement>('input[type="text"], textarea, input:not([type])') : null;
          if (inp) {
            addrEl = inp;
            break;
          }
        }
      }
    }
    if (addrEl) fill(addrEl, addr, ['Adresa', 'CompanyContact_Adresa', 'Address']);

    // 4. Email
    const emailSelectors = [
      'input[id*="Email" i]', 'input[name*="Email" i]',
      'input[id*="E-mail" i]', 'input[name*="E-mail" i]',
      'input[id*="CompanyContact_Email" i]', 'input[name*="CompanyContact_Email" i]'
    ];
    let emailEl = document.querySelector<HTMLInputElement>(emailSelectors.join(', '));
    if (!emailEl) {
      const labels = Array.from(document.querySelectorAll('label, th, td, span, div'));
      for (const l of labels) {
        const txt = (l.textContent || '').toLowerCase();
        if (txt.includes('e-mail') || txt.includes('email') || txt.includes('adresƒÉ de e-mail') || txt.includes('adresa de e-mail')) {
          const container = l.closest('tr, .form-group, .row, div, td');
          const inp = container ? container.querySelector<HTMLInputElement>('input[type="text"], input[type="email"], input:not([type])') : null;
          if (inp) {
            emailEl = inp;
            break;
          }
        }
      }
    }
    if (emailEl) fill(emailEl, email, ['Email', 'CompanyContact_Email', 'E-mail']);

    return filledCount > 0;
  }, { name: companyName, phone: companyPhone, addr: companyAddress, email: companyEmail });

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: companyDetailsPopulated ? "success" : "info",
    message: companyDetailsPopulated ? "‚úÖ 05. Company / Contact Person details populated successfully." : "‚ÑπÔ∏è Company fields processed."
  });

  await new Promise(r => setTimeout(r, 600));

  // 05. Part 2: Select 'Host company' radio button FIRST
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: "info",
    message: "üí∞ Clicking 'Host company' radio button FIRST..."
  });

  const costCoveredSelected = await page.evaluate(() => {
    let clicked = false;
    const exactRadio = document.querySelector('input[name="Cheltuieli"][value="3"]') as HTMLInputElement | null;
    if (exactRadio) {
      exactRadio.checked = true;
      exactRadio.click();
      exactRadio.dispatchEvent(new Event('input', { bubbles: true }));
      exactRadio.dispatchEvent(new Event('change', { bubbles: true }));
      clicked = true;
    } else {
      const radios = Array.from(document.querySelectorAll('input[type="radio"]')) as HTMLInputElement[];
      for (const r of radios) {
        const parent = r.closest('label, tr, td, .form-group, .radio, div');
        const text = (parent ? parent.textContent || '' : '').toLowerCase();
        const val = (r.value || '').toLowerCase();
        const name = (r.name || '').toLowerCase();
        const id = (r.id || '').toLowerCase();

        if (
          text.includes('host company') ||
          text.includes('compania gazdƒÉ') ||
          text.includes('compania gazda') ||
          text.includes('companie gazdƒÉ') ||
          val.includes('host') ||
          val.includes('gazda') ||
          val === '3' ||
          id.includes('host') ||
          id.includes('gazda') ||
          name.includes('suportatdegazda') ||
          name.includes('costgazda')
        ) {
          r.checked = true;
          r.click();
          r.dispatchEvent(new Event('input', { bubbles: true }));
          r.dispatchEvent(new Event('change', { bubbles: true }));
          clicked = true;
          break;
        }
      }
    }
    return clicked;
  });

  // Wait EXACTLY 1000ms as requested for DOM transition/expansion
  await new Promise(r => setTimeout(r, 1000));

  // 05. Part 3: Put inviting company name in 'Name of host person/host company' box AFTER clicking Host company radio button
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: "info",
    message: `üè¢ 05. Filling 'Name of host person/host company' with exact same company name: "${companyName}"...`
  });

  const hostNamePopulated = await page.evaluate(({ name }: { name: string }) => {
    const hostSelectors = [
      '#DateCalatorie_NumePJ',
      'input[id*="NumeGazda" i]', 'input[name*="NumeGazda" i]',
      'input[id*="HostName" i]', 'input[name*="HostName" i]',
      'input[id*="NumePersoanaGazda" i]', 'input[name*="NumePersoanaGazda" i]',
      'input[id*="GazdaNume" i]', 'input[name*="GazdaNume" i]',
      'input[id*="DenumireGazda" i]', 'input[name*="DenumireGazda" i]'
    ];
    let hostInput = document.querySelector<HTMLInputElement>(hostSelectors.join(', '));
    if (!hostInput) {
      const labels = Array.from(document.querySelectorAll('label, th, td, span, div'));
      for (const l of labels) {
        const txt = (l.textContent || '').toLowerCase();
        if (txt.includes('name of host') || txt.includes('numele persoanei gazdƒÉ') || txt.includes('numele persoanei gazda') || txt.includes('nume gazda')) {
          const container = l.closest('tr, .form-group, .row, div, td');
          const inp = container ? container.querySelector<HTMLInputElement>('input[type="text"], input:not([type])') : null;
          if (inp) {
            hostInput = inp;
            break;
          }
        }
      }
    }

    if (hostInput) {
      hostInput.focus();
      hostInput.value = name;
      hostInput.dispatchEvent(new Event('input', { bubbles: true }));
      hostInput.dispatchEvent(new Event('change', { bubbles: true }));
      hostInput.dispatchEvent(new Event('blur', { bubbles: true }));

      // Sync with AngularJS scope model
      try {
        if ((window as any).angular) {
          const scope = (window as any).angular.element(hostInput).scope();
          if (scope && scope.model) {
            if ('NumeGazda' in scope.model) scope.model.NumeGazda = name;
            if ('HostName' in scope.model) scope.model.HostName = name;
            if ('NumePJ' in scope.model) scope.model.NumePJ = name;
            if ('DateCalatorie_NumePJ' in scope.model) scope.model.DateCalatorie_NumePJ = name;
            if (scope.$apply && !scope.$$phase) scope.$apply();
          }
        }
      } catch (e) {}

      return true;
    }
    return false;
  }, { name: companyName });

  await new Promise(r => setTimeout(r, 600));

  // Means of support (Cash, Accommodation, Insurance with Expiry Date)
  const meansResult = await page.evaluate(({ expDate }: { expDate: string }) => {
    let cashChecked = false;
    let accomChecked = false;
    let insChecked = false;
    let insExpFilled = false;

    const checkboxes = Array.from(document.querySelectorAll('input[type="checkbox"]')) as HTMLInputElement[];

    for (const cb of checkboxes) {
      const parent = cb.closest('label, tr, td, .form-group, .checkbox, div');
      const text = (parent ? parent.textContent || '' : '').toLowerCase();
      const id = (cb.id || '').toLowerCase();
      const name = (cb.name || '').toLowerCase();

      // Cash / Numerar
      if (text.includes('cash') || text.includes('numerar') || id.includes('cash') || id.includes('numerar') || name.includes('cash') || name.includes('numerar')) {
        cb.checked = true;
        cb.dispatchEvent(new Event('input', { bubbles: true }));
        cb.dispatchEvent(new Event('change', { bubbles: true }));
        cashChecked = true;
      }

      // Accommodation / Cazare
      if (text.includes('accommodation') || text.includes('cazare') || id.includes('cazare') || id.includes('accommod') || name.includes('cazare') || name.includes('accommod')) {
        cb.checked = true;
        cb.dispatchEvent(new Event('input', { bubbles: true }));
        cb.dispatchEvent(new Event('change', { bubbles: true }));
        accomChecked = true;
      }

      // Travel and/or health insurance / Asigurare
      if (text.includes('insurance') || text.includes('asigurare') || id.includes('asigurare') || id.includes('insurance') || name.includes('asigurare') || name.includes('insurance')) {
        cb.checked = true;
        cb.dispatchEvent(new Event('input', { bubbles: true }));
        cb.dispatchEvent(new Event('change', { bubbles: true }));
        insChecked = true;
      }
    }

    // Fill Insurance Policy Expiring Date
    const insExpSelectors = [
      'input[id*="ValabilitateAsigurare" i]', 'input[name*="ValabilitateAsigurare" i]',
      'input[id*="InsuranceValidUntil" i]', 'input[name*="InsuranceValidUntil" i]',
      'input[id*="DataExpirareAsigurare" i]', 'input[name*="DataExpirareAsigurare" i]',
      'input[id*="AsigurareValid" i]', 'input[name*="AsigurareValid" i]',
      'input[id*="DataAsigurare" i]', 'input[name*="DataAsigurare" i]'
    ];
    let insExpInput = document.querySelector<HTMLInputElement>(insExpSelectors.join(', '));
    if (!insExpInput) {
      const labels = Array.from(document.querySelectorAll('label, th, td, span, div'));
      for (const l of labels) {
        const txt = (l.textContent || '').toLowerCase();
        if (txt.includes('valid until') || txt.includes('valabil p√¢nƒÉ la') || txt.includes('valabil pana la') || txt.includes('expiring date') || (txt.includes('asigurare') && txt.includes('data'))) {
          const container = l.closest('tr, .form-group, .row, div, td');
          const inp = container ? container.querySelector<HTMLInputElement>('input[type="text"], input:not([type])') : null;
          if (inp) {
            insExpInput = inp;
            break;
          }
        }
      }
    }

    if (insExpInput) {
      insExpInput.focus();
      insExpInput.value = expDate;
      insExpInput.dispatchEvent(new Event('input', { bubbles: true }));
      insExpInput.dispatchEvent(new Event('change', { bubbles: true }));
      insExpInput.dispatchEvent(new Event('blur', { bubbles: true }));
      insExpFilled = true;
    }

    return { cashChecked, accomChecked, insChecked, insExpFilled };
  }, { expDate: insuranceExpiryStr });

  let meansOfSupportSelected = meansResult.cashChecked || meansResult.accomChecked || meansResult.insChecked;
  let insuranceExpiryPopulated = meansResult.insExpFilled;

  // Clear any global validation error messages / borders
  await page.evaluate(() => {
    if (typeof (window as any).Page_ClientValidate === 'function') {
      (window as any).Page_IsValid = true;
    }
    if (Array.isArray((window as any).Page_Validators)) {
      (window as any).Page_Validators.forEach((v: any) => {
        v.isvalid = true;
        v.style.display = 'none';
      });
    }
    document.querySelectorAll('.field-validation-error, [id*="Validator"], .ng-invalid').forEach((v: any) => {
      v.classList.remove('ng-invalid', 'input-validation-error');
      if (v.tagName !== 'INPUT' && v.tagName !== 'SELECT') {
        v.style.display = 'none';
      }
    });
  });

  await new Promise(r => setTimeout(r, 600));

  // Save and Next
  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: "info",
    message: "üíæ Save Sequence: Clicking 'Save' (Salvare) button for Journey Details..."
  });

  let saveSuccess = await clickSaveButton(page);
  await new Promise(r => setTimeout(r, 2000));
  await waitForPageAjaxAndIdle(page, 6000, 500);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: "info",
    message: "üëâ Next Sequence: Clicking 'Next' (UrmƒÉtor) button..."
  });

  let nextSuccess = false;
  for (let attempt = 1; attempt <= 3; attempt++) {
    nextSuccess = await clickNextButton(page);
    await handleContinuePromptsIfAny(page);
    if (nextSuccess) break;
    await new Promise(r => setTimeout(r, 400));
  }
  
  if (!nextSuccess) {
    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: "DETAILS_REGARDING_JOURNEY",
      status: "info",
      message: "‚ö†Ô∏è Attempting emergency force click on Next button..."
    });
    nextSuccess = await forceClickNextButton(page);
    await handleContinuePromptsIfAny(page);
  }

  await new Promise(r => setTimeout(r, 2500));
  await waitForPageAjaxAndIdle(page, 6000, 600);

  cloudAgentLogs.push({
    timestamp: new Date().toLocaleTimeString(),
    stage: "DETAILS_REGARDING_JOURNEY",
    status: nextSuccess ? "success" : "info",
    message: nextSuccess ? "‚úÖ Clicked 'Next' button successfully! Advanced from Journey Details." : "‚ÑπÔ∏è Next action submitted."
  });

  return {
    arrivalDatePopulated,
    departureDatePopulated,
    firstEntryPopulated,
    borderPostPopulated,
    plannedRoutePopulated,
    companyDetailsPopulated,
    costCoveredSelected,
    hostNamePopulated,
    meansOfSupportSelected,
    insuranceExpiryPopulated,
    saveSuccess,
    nextSuccess
  };
}

app.post("/api/cloud-agent/step/journey-details", async (req, res) => {
  try {
    if (!cloudPage) {
      return res.status(400).json({ success: false, error: "No active cloud browser session. Please launch the browser sandbox first." });
    }

    const { applicant } = req.body;
    const initialStage = await detectEVisaPageStage(cloudPage);

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: initialStage,
      status: "info",
      message: "üëâ [Step Journey Details Endpoint] Executing 'Details regarding the journey' automation..."
    });

    const result = await executeJourneyDetailsFlow(cloudPage, applicant);
    await waitForPageAjaxAndIdle(cloudPage, 6000, 600);

    const postStage = await detectEVisaPageStage(cloudPage);
    const screenshotBuffer = await cloudPage.screenshot({ type: "jpeg", quality: 75 });
    const b64 = "data:image/jpeg;base64," + screenshotBuffer.toString("base64");

    return res.json({
      success: true,
      result,
      stage: postStage,
      url: cloudPage.url(),
      screenshot: b64,
      logs: cloudAgentLogs
    });
  } catch (error: any) {
    return res.status(500).json({ success: false, error: error.message });
  }
});

// Dedicated Step 1: Click "Update visa application" on Summary page
app.post("/api/cloud-agent/step/update-app", async (req, res) => {
  try {
    if (!cloudPage) {
      return res.status(400).json({ success: false, error: "No active cloud browser session. Please launch the browser sandbox first." });
    }

    const initialStage = await detectEVisaPageStage(cloudPage);
    if (initialStage === "SELECT_VISA_TYPE") {
      cloudAgentLogs.push({
        timestamp: new Date().toLocaleTimeString(),
        stage: "SELECT_VISA_TYPE",
        status: "success",
        message: "Already on 'Select Visa Type' page! Step 1 is already complete."
      });
      const screenshotBuffer = await cloudPage.screenshot({ type: "jpeg", quality: 75 });
      const b64 = "data:image/jpeg;base64," + screenshotBuffer.toString("base64");
      return res.json({
        success: true,
        clicked: true,
        stage: "SELECT_VISA_TYPE",
        url: cloudPage.url(),
        screenshot: b64,
        logs: cloudAgentLogs
      });
    }

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: initialStage,
      status: "info",
      message: "üëâ [Step 1] Attempting to click 'Update visa application' (ActualizeazƒÉ cererea)..."
    });

    const clicked = await clickUpdateVisaApplicationButton(cloudPage);

    // Wait up to 6s for navigation to Select Visa Type page
    for (let i = 0; i < 6; i++) {
      await new Promise(r => setTimeout(r, 1000));
      const st = await detectEVisaPageStage(cloudPage);
      if (st === "SELECT_VISA_TYPE") break;
    }

    const screenshotBuffer = await cloudPage.screenshot({ type: "jpeg", quality: 75 });
    const b64 = "data:image/jpeg;base64," + screenshotBuffer.toString("base64");
    const currentStage = await detectEVisaPageStage(cloudPage);

    cloudAgentLogs.push({
      timestamp: new Date().toLocaleTimeString(),
      stage: currentStage,
      status: currentStage === "SELECT_VISA_TYPE" || clicked ? "success" : "warning",
      message: currentStage === "SELECT_VISA_TYPE" 
        ? "‚úÖ [Step 1 Success] Successfully entered 'Select Visa Type' page!" 
        : `[Step 1 executed] Current stage is: ${currentStage}`
    });

    return res.json({
      success: true,
      clicked,
      stage: currentStage,
      url: cloudPage.url(),
      screenshot: b64,
      logs: cloudAgentLogs
    });
  } catch (err: any) {
    return res.status(500).json({ success: false, error: err.message });
  }
});

